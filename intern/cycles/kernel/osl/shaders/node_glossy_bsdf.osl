#include "node_fresnel.h"
#include "node_math.h"
#include "stdcycles.h"

shader node_glossy_bsdf(color Color = 0.8,
                        string distribution = "ggx",
                        float Roughness = 0.2,
                        float Anisotropy = 0.0,
                        float Rotation = 0.0,
                        normal Normal = N,
                        normal Tangent = 0.0,
                        output closure color BSDF = 0)
{
  /* compute roughness */
  color base_color = max(Color, color(0.0));
  float alpha = sqr(clamp(Roughness, 0.0, 1.0));
  float alpha_x, alpha_y;
  float aniso = clamp(Anisotropy, -0.99, 0.99);

  /* rotate tangent around normal */
  vector T = Tangent;

  if (abs(aniso) <= 1e-4) {
    alpha_x = alpha;
    alpha_y = alpha;
  }
  else {
    if (Rotation != 0.0)
      T = rotate(T, Rotation * M_2PI, point(0.0, 0.0, 0.0), Normal);

    if (aniso < 0.0) {
      alpha_x = alpha / (1.0 + aniso);
      alpha_y = alpha * (1.0 + aniso);
    }
    else {
      alpha_x = alpha * (1.0 - aniso);
      alpha_y = alpha / (1.0 - aniso);
    }
  }

  if (distribution == "Multiscatter GGX") {
    BSDF = base_color * microfacet_multi_ggx_aniso(Normal, T, alpha_x, alpha_y, base_color);
  }
  else {
    BSDF = base_color * microfacet(distribution, Normal, T, alpha_x, alpha_y, 0.0, 0);
  }
}
