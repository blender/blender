#include "stdcycles.h"

#include "node_fresnel.h"
#include "node_math.h"

#define BSDF_T closure color

/* A small cutoff number. Same as in `kernel/constants.h`. */
#define EPS 1e-5
#define CLOSURE_WEIGHT_CUTOFF 1e-5

struct ThinFilm {
  float weight;
  float thickness;
  float ior;
};

struct Base {
  float weight;
  color tint;
  float metalness;
  float diffuse_roughness;
};

struct Subsurface {
  float weight;
  color tint;
  color radius;
  float anisotropy;
};

struct Transmission {
  float weight;
  color tint;
  float dispersion_scale;
  float dispersion_abbe_number;
};

struct Coat {
  color tint;
  float ior;
  normal N;
  float roughness;
  float weight;
  normal T;
  float anisotropy;
  float darkening;
};

struct Specular {
  float weight;
  float roughness;
  float anisotropy;
  float ior;
  color tint;
};

/* OpenPBR Surface Specification v1.1, Eq. (11). */
closure color layer(closure color top, closure color base, float weight)
{
  return layer(weight * top, base);
}

/* Anisotropic roughness. OpenPBR Surface Specification v1.1, Eq. (21). */
vector2 openpbr_anisotropic_roughness(float roughness, float anisotropy)
{
  float roughness_sq = sqr(roughness);
  vector2 alpha = vector2(roughness_sq, roughness_sq);

  if (anisotropy > 0.0) {
    alpha.x *= sqrt(2.0 / (1.0 + sqr(1.0 - anisotropy)));
    alpha.y = (1.0 - anisotropy) * alpha.x;
  }

  return alpha;
}

float openpbr_specular_ior(float ior, float weight, float coat_weight, float coat_ior)
{
  float specular_ior = ior;
  if (coat_weight > 0.0) {
    /* Fixing the ratio to compensate for total internal reflections (TIR),
     * OpenPBR Surface Specification v1.1, Eq. (74) */
    float tir_fixed_ratio = (coat_ior > specular_ior) ? (coat_ior / specular_ior) :
                                                        (specular_ior / coat_ior);

    float ambient_ior = 1.0;
    /* OpenPBR Surface Specification v1.1, Eq. (60) */
    specular_ior = mix(specular_ior / ambient_ior, tir_fixed_ratio, coat_weight);
  }

  if (weight == 1.0) {
    return specular_ior;
  }

  float modulated_ior = ior_from_F0(weight * F0_from_ior(specular_ior));
  return (specular_ior < 1.0) ? 1.0 / modulated_ior : modulated_ior;
}

vector2 openpbr_specular_roughness(float roughness, float anisotropy, Coat coat)
{
  float specular_roughness = roughness;
  if ((coat.weight > 0.0) && (coat.roughness > 0.0)) {
    /* Coat roughening, OpenPBR Surface specification v1.1, Eq. (73). */
    float min_coated_roughness = min(
        1.0, pow(sqr(sqr(specular_roughness)) + 2.0 * sqr(sqr(coat.roughness)), 0.25));
    specular_roughness = mix(specular_roughness, min_coated_roughness, coat.weight);
  }

  return openpbr_anisotropic_roughness(specular_roughness, anisotropy);
}

/* Diffuse. OpenPBR Surface Specification v1.1, Section 3.2.2. */
BSDF_T openpbr_diffuse(color base_color, float roughness, normal N)
{
  if (roughness > EPS) {
    return oren_nayar_diffuse_bsdf(N, base_color, roughness);
  }
  return base_color * diffuse(N);
}

/* Gloss. OpenPBR Surface Specification v1.1, Section 3.2. */
BSDF_T openpbr_gloss(color specular_color,
                     vector2 roughness,
                     float specular_ior,
                     ThinFilm thin_film,
                     int thin_walled,
                     normal N,
                     normal T)
{
  /* In thin_walled mode we need to counter the implicit IOR inversion of the glossy layer
   * on top of the diffuse base. */
  float ior = backfacing() && thin_walled ? 1.0 / specular_ior : specular_ior;
  float thinfilm_ior = backfacing() && thin_walled ? thin_film.ior * specular_ior : thin_film.ior;
  BSDF_T F_dielectric_film = dielectric_bsdf(N,
                                             T,
                                             specular_color,
                                             color(0.0),
                                             roughness.x,
                                             roughness.y,
                                             ior,
                                             "multi_ggx",
                                             "thinfilm_thickness",
                                             thin_film.thickness,
                                             "thinfilm_ior",
                                             thinfilm_ior);
  BSDF_T F_dielectric = dielectric_bsdf(
      N, T, specular_color, color(0.0), roughness.x, roughness.y, ior, "multi_ggx");
  return mix(F_dielectric, F_dielectric_film, thin_film.weight);
}

/* Metal. OpenPBR Surface Specification v1.1, Section 3.2.1. */
BSDF_T openpbr_metal(color base_color,
                     float specular_weight,
                     color specular_color,
                     vector2 roughness,
                     ThinFilm thin_film,
                     normal N,
                     normal T)
{
  BSDF_T F_metal_film = microfacet_f82_tint("multi_ggx",
                                            N,
                                            T,
                                            roughness.x,
                                            roughness.y,
                                            base_color,
                                            specular_color,
                                            "thinfilm_thickness",
                                            thin_film.thickness,
                                            "thinfilm_ior",
                                            thin_film.ior);
  BSDF_T F_metal = microfacet_f82_tint(
      "multi_ggx", N, T, roughness.x, roughness.y, base_color, specular_color);

  return saturate(specular_weight) * mix(F_metal, F_metal_film, thin_film.weight);
}

/* Subsurface. */
BSDF_T openpbr_subsurface(Subsurface sss, int thin_walled, float roughness, normal N)
{
  if (thin_walled) {
    /* OpenPBR Surface Specification v1.1, Section 3.9. */
    return sss.tint * thin_subsurface(N, vector(0.0), sss.tint, sss.anisotropy, roughness);
  }

  /* OpenPBR Surface Specification v1.1, Section 3.2.3. */
#if OSL_VERSION >= 11401
  return subsurface_bssrdf(N, sss.tint, sss.radius, sss.anisotropy);
#else
  return subsurface_bssrdf(N, sss.tint, 1.0, sss.radius, sss.anisotropy);
#endif
}

/* Translucent base. OpenPBR Surface Specification, Section 3.2.4. */
BSDF_T openpbr_translucent(Specular specular,
                           Transmission transmission,
                           vector2 roughness,
                           ThinFilm thin_film,
                           int thin_walled,
                           normal N,
                           normal T)
{
  if (thin_walled) {
    /* OpenPBR Surface Specification v1.1, Section 3.9. */
    BSDF_T ThinGlass = thin_glass(
        N, specular.tint, transmission.tint, specular.ior, sqr(specular.roughness), 0.0, 1.0, 1);
    BSDF_T ThinGlass_film = thin_glass(N,
                                       specular.tint,
                                       transmission.tint,
                                       specular.ior,
                                       sqr(specular.roughness),
                                       thin_film.thickness,
                                       thin_film.ior,
                                       1);
    return mix(ThinGlass, ThinGlass_film, thin_film.weight);
  }

  color specular_tint = backfacing() ? color(1.0) : specular.tint;
  float inv_abbe = transmission.dispersion_scale / transmission.dispersion_abbe_number;
  BSDF_T Glass_no_film = dielectric_bsdf(N,
                                         T,
                                         specular_tint,
                                         transmission.tint,
                                         roughness.x,
                                         roughness.y,
                                         specular.ior,
                                         "multi_ggx",
                                         "inv_abbe",
                                         inv_abbe);
  BSDF_T Glass_film = dielectric_bsdf(N,
                                      T,
                                      specular_tint,
                                      transmission.tint,
                                      roughness.x,
                                      roughness.y,
                                      specular.ior,
                                      "multi_ggx",
                                      "inv_abbe",
                                      inv_abbe,
                                      "thinfilm_thickness",
                                      thin_film.thickness,
                                      "thinfilm_ior",
                                      thin_film.ior);
  BSDF_T Glass = mix(Glass_no_film, Glass_film, thin_film.weight);
  return Glass;
}

BSDF_T openpbr_coat(Coat coat)
{
  /* FIXME(OpenPBR): simply invert ior is incorrect, probably should do the same as thin film?
   * Didn't find in the spec how to address backface. Principled BSDF uses original coat IOR
   * without modification. */
  // float coat_ior = backfacing() ? 1.0 / coat.ior : coat.ior;
  float coat_ior = coat.ior;
  return coat_bsdf(
      coat.tint, coat_ior, coat.roughness, coat.anisotropy, coat.darkening, coat.N, coat.T);
}

float hemispherical_albedo(float eta)
{
  float eta_ = (eta < 1.0) ? 1.0 / eta : eta;

  float nominator = (10893.0 * eta_) - 1438.2;
  float denominator = (-774.4 * sqr(eta_)) + (10212.0 * eta_) + 1.0;
  float albedo = log(nominator / denominator);

  if (eta < 1.0) {
    /* Eq (11.12). */
    albedo = 1.0 - sqr(eta) * (1.0 - albedo);
  }

  return albedo;
}

color openpbr_coat_darkening(
    vector wi, Base base, Coat coat, Transmission transmission, Specular specular, Subsurface sss)
{
  color white = color(1.0);
  if (!(coat.weight > 0.0)) {
    return white;
  }

  if (coat.darkening == 0.0) {
    return white;
  }

  /* Normal-incidence albedo of the entire base beneath the coat. */
  color E_b;
  {
    float F0 = F0_from_ior(specular.ior);
    color E_glossy = F0 * specular.tint;
    color E_glossy_diffuse = E_glossy + (1.0 - E_glossy) * base.tint;
    color E_opaque = mix(E_glossy_diffuse, sss.tint, sss.weight);

    color E_translucent = E_glossy + (1.0 - F0) * transmission.tint;
    color E_dielectric = mix(E_opaque, E_translucent, transmission.weight);

    color E_metal = base.tint;
    E_b = mix(E_dielectric, E_metal, base.metalness);
  }

  if (E_b == white) {
    /* As E_b approaches 1, the darkening factor also approaches 1, as required since physically no
     * energy is lost if the base reflects all incident energy. */
    return white;
  }

  /* Internal diffuse reflection coefficient. */
  float K;
  {
    /* Ambient IOR is 1. */
    float eta_c = coat.ior;

    /* Internal diffuse reflection coefficient. */
    float E_F = hemispherical_albedo(eta_c);
    float K_r = 1.0 - (1.0 - E_F) / sqr(eta_c);
    float cos_i = dot(coat.N, wi);
    float K_s = fresnel_dielectric_cos(cos_i, eta_c);

    /* Specular roughness. */
    float r = specular.roughness;
    /* Metal roughness. */
    float r_m = r;
    /* Base dielectric roughness. */
    float r_d = mix(1.0, r, F0_from_ior(specular.ior));
    /* Effective base roughness. */
    float r_b = mix(r_d, r_m, base.metalness);

    K = mix(K_s, K_r, r_b);
  }

  /* Darkening factor. */
  color Delta = (1.0 - K) / (1.0 - E_b * K);

  return mix(white, Delta, coat.weight * coat.darkening);
}

BSDF_T openpbr_fuzz(
    float coat_weight, normal coat_N, color fuzz_color, float fuzz_roughness, normal N)
{
  normal fuzz_normal = normalize(mix(N, coat_N, coat_weight));
  return sheen_bsdf(fuzz_normal, fuzz_color, fuzz_roughness);
}

float closure_weight_cutoff(float weight)
{
  if (weight > CLOSURE_WEIGHT_CUTOFF) {
    return weight;
  }
  return 0.0;
}

shader node_open_pbr_spec_bsdf(float BaseWeight = 1.0,
                               color BaseColor = 0.8,
                               float BaseDiffuseRoughness = 0.0,
                               float BaseMetalness = 0.0,
                               float SpecularWeight = 1.0,
                               color SpecularColor = 1.0,
                               float SpecularRoughness = 0.3,
                               float SpecularRoughnessAnisotropy = 0.0,
                               float SpecularIOR = 1.5,
                               float TransmissionWeight = 0.0,
                               color TransmissionColor = 1.0,
                               float TransmissionDepth = 0.0,
                               color TransmissionScatter = 0.0,
                               float TransmissionScatterAnisotropy = 0.0,
                               float TransmissionDispersionScale = 0.0,
                               float TransmissionDispersionAbbeNumber = 20.0,
                               float SubsurfaceWeight = 0.0,
                               color SubsurfaceColor = 0.8,
                               float SubsurfaceRadius = 1.0,
                               color SubsurfaceRadiusScale = {1.0, 0.5, 0.25},
                               float SubsurfaceScatterAnisotropy = 0.0,
                               float CoatWeight = 0.0,
                               color CoatColor = 1.0,
                               float CoatRoughness = 0.0,
                               float CoatRoughnessAnisotropy = 0.0,
                               float CoatIOR = 1.6,
                               float CoatDarkening = 1.0,
                               float FuzzWeight = 0.0,
                               color FuzzColor = 1.0,
                               float FuzzRoughness = 0.5,
                               float EmissionLuminance = 0.0,
                               color EmissionColor = 1.0,
                               float ThinFilmWeight = 0,
                               float ThinFilmThickness = 0.5,
                               float ThinFilmIOR = 1.4,
                               float GeometryOpacity = 1.0,
                               int GeometryThinWalled = 0,
                               normal GeometryNormal = N,
                               normal GeometryTangent = normalize(dPdu),
                               normal GeometryCoatNormal = N,
                               normal GeometryCoatTangent = normalize(dPdu),
                               output BSDF_T BSDF = 0)
{
  /* Clamp parameters. OpenPBR Surface Specification v1.1, Section 5. */
  /* Base. */
  Base base;
  base.weight = saturate(BaseWeight);
  base.tint = saturate(BaseColor);
  base.metalness = saturate(BaseMetalness);
  base.diffuse_roughness = saturate(BaseDiffuseRoughness);
  /* Specular. */
  Specular specular;
  specular.weight = max(SpecularWeight, 0.0);
  specular.tint = saturate(SpecularColor);
  specular.roughness = saturate(SpecularRoughness);
  specular.anisotropy = saturate(SpecularRoughnessAnisotropy);
  specular.ior = max(SpecularIOR, EPS);
  /* Transmission. */
  Transmission transmission;
  transmission.weight = saturate(TransmissionWeight);
  transmission.tint = clamp(TransmissionColor, color(EPS), color(1.0));
  transmission.dispersion_scale = saturate(TransmissionDispersionScale);
  transmission.dispersion_abbe_number = max(TransmissionDispersionAbbeNumber, EPS);
  /* Subsurface. */
  Subsurface sss;
  sss.weight = saturate(SubsurfaceWeight);
  sss.tint = saturate(SubsurfaceColor);
  sss.radius = max(SubsurfaceRadius, 0.0) * saturate(SubsurfaceRadiusScale);
  sss.anisotropy = clamp(SubsurfaceScatterAnisotropy, -1.0, 1.0);
  /* Coat. */
  Coat coat;
  coat.weight = saturate(CoatWeight);
  coat.tint = saturate(CoatColor);
  coat.roughness = saturate(CoatRoughness);
  coat.anisotropy = saturate(CoatRoughnessAnisotropy);
  coat.ior = max(CoatIOR, EPS);
  coat.darkening = saturate(CoatDarkening);
  /* Fuzz. */
  float fuzz_weight = saturate(FuzzWeight);
  color fuzz_color = saturate(FuzzColor);
  float fuzz_roughness = saturate(FuzzRoughness);
  /* Emission */
  float emission_luminance = max(EmissionLuminance, 0.0);
  color emission_color = max(EmissionColor, color(0.0));
  /* Thin film. */
  ThinFilm thin_film;
  thin_film.weight = saturate(ThinFilmWeight);
  thin_film.thickness = max(ThinFilmThickness, 0.0) * 1000.0;
  thin_film.ior = max(ThinFilmIOR, 0.0);
  /* Geometry. */
  float geometry_opacity = saturate(GeometryOpacity);
  int thin_walled = GeometryThinWalled;
  normal T = GeometryTangent;
  coat.N = GeometryCoatNormal;
  coat.T = GeometryCoatTangent;

  /* Remove closures with low weight. */
  base.metalness = closure_weight_cutoff(base.metalness);
  transmission.weight = closure_weight_cutoff(transmission.weight);
  specular.weight = closure_weight_cutoff(specular.weight);
  sss.weight = closure_weight_cutoff(sss.weight);
  base.weight = closure_weight_cutoff(base.weight);
  coat.weight = closure_weight_cutoff(coat.weight);
  thin_film.weight = closure_weight_cutoff(thin_film.weight);

  /* Adjust parameters. */
  specular.ior = openpbr_specular_ior(specular.ior, specular.weight, coat.weight, coat.ior);
  base.tint = base.weight * base.tint;
  vector2 alpha = openpbr_specular_roughness(specular.roughness, specular.anisotropy, coat);
  color coat_darkening = openpbr_coat_darkening(I, base, coat, transmission, specular, sss);

  /* Slabs. */
  BSDF_T S_diffuse = openpbr_diffuse(base.tint, base.diffuse_roughness, GeometryNormal);
  BSDF_T S_gloss = openpbr_gloss(
      specular.tint, alpha, specular.ior, thin_film, thin_walled, GeometryNormal, T);
  BSDF_T S_subsurface = openpbr_subsurface(
      sss, thin_walled, base.diffuse_roughness, GeometryNormal);
  BSDF_T S_translucent_base = openpbr_translucent(
      specular, transmission, alpha, thin_film, thin_walled, GeometryNormal, T);
  BSDF_T S_metal = openpbr_metal(
      base.tint, specular.weight, specular.tint, alpha, thin_film, GeometryNormal, T);
  BSDF_T S_coat = openpbr_coat(coat);
  BSDF_T S_emission = uniform_edf(emission_luminance * emission_color);
  BSDF_T S_fuzz = openpbr_fuzz(coat.weight, coat.N, fuzz_color, fuzz_roughness, GeometryNormal);

  /* Final material composition. OpenPBR Surface Specification v1.1, Section 3. */
  BSDF_T M_opaque_base = layer(S_gloss, mix(S_subsurface, S_diffuse, 1.0 - sss.weight));
  BSDF_T M_dielectric_base = mix(M_opaque_base, S_translucent_base, transmission.weight);
  BSDF_T M_base_substrate = coat_darkening * mix(S_metal, M_dielectric_base, 1.0 - base.metalness);
  BSDF_T M_coated_base = layer(S_coat, M_base_substrate + S_emission, coat.weight);
  BSDF_T M_surface = layer(S_fuzz, M_coated_base, fuzz_weight);

  BSDF = mix(transparent(), M_surface, geometry_opacity);
}
