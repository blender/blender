#include "stdcycles.h"

shader node_get_vector_component(vector Vector = 0.0, int Index = 0, output float Value = 0.0)
{
  if (Index >= 0 && Index <= 2) {
    Value = Vector[Index];
  }
  else {
    Value = 0.0;
  }
}
