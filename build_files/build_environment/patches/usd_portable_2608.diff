diff --git a/cmake/modules/FindOpenImageIO.cmake b/cmake/modules/FindOpenImageIO.cmake
index 4d2ff1ec4..f49a0e003 100644
--- a/cmake/modules/FindOpenImageIO.cmake
+++ b/cmake/modules/FindOpenImageIO.cmake
@@ -146,3 +146,17 @@ find_package_handle_standard_args(OpenImageIO
     VERSION_VAR
         OIIO_VERSION
 )
+
+# Expose OpenImageIO as an imported target rather than bare filesystem paths.
+# USD's exported targets reference this by name, so the absolute paths are
+# resolved by whichever find module is in play. That keeps the installed
+# package relocatable: a consumer re-runs the find module against their own
+# OpenImageIO instead of inheriting a path that only exists on the build
+# machine.
+if(OpenImageIO_FOUND AND NOT TARGET OpenImageIO::OpenImageIO)
+    add_library(OpenImageIO::OpenImageIO INTERFACE IMPORTED)
+    set_target_properties(OpenImageIO::OpenImageIO PROPERTIES
+        INTERFACE_INCLUDE_DIRECTORIES "${OIIO_INCLUDE_DIRS}"
+        INTERFACE_LINK_LIBRARIES "${OIIO_LIBRARIES}"
+    )
+endif()
diff --git a/cmake/modules/FindOpenSubdiv.cmake b/cmake/modules/FindOpenSubdiv.cmake
