+# Add third-party include directories to TARGET as SYSTEM PUBLIC includes.
+#
+# Directories that are not part of the USD install prefix must not be baked
+# into the exported interface, otherwise the installed package is not
+# relocatable: consumers on other machines would pick up absolute paths
+# pointing into the build machine's filesystem.
+#
+# The Python headers are the only such case today. They are added to the
+# build interface only. Consumers still get them transitively, because the
+# Python3::Python imported target is part of the link interface of the
+# exported targets and pxrConfig.cmake re-creates it via
+# find_dependency(Python3 ... COMPONENTS Development).
+function(_pxr_target_include_directories TARGET)
+    set(_publicDirs "")
+    set(_buildOnlyDirs "")
+
+    foreach(_dir IN LISTS ARGN)
+        if(PYTHON_INCLUDE_DIRS AND _dir IN_LIST PYTHON_INCLUDE_DIRS)
+            list(APPEND _buildOnlyDirs "${_dir}")
+        else()
+            list(APPEND _publicDirs "${_dir}")
+        endif()
+    endforeach()
+
+    if(_publicDirs)
+        target_include_directories(${TARGET}
+            SYSTEM
+            PUBLIC
+                ${_publicDirs}
+        )
+    endif()
+
+    foreach(_dir IN LISTS _buildOnlyDirs)
+        target_include_directories(${TARGET}
+            SYSTEM
+            PUBLIC
+                "$<BUILD_INTERFACE:${_dir}>"
+        )
+    endforeach()
+endfunction()
+
