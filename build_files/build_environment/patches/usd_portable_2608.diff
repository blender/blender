+      set_target_properties(OpenSubdiv::${COMPONENT} PROPERTIES
+          IMPORTED_LOCATION "${OPENSUBDIV_${UPPERCOMPONENT}_LIBRARY}"
+          INTERFACE_INCLUDE_DIRECTORIES "${OPENSUBDIV_INCLUDE_DIR}"
+      )
+    endif()
+  ENDFOREACH()
