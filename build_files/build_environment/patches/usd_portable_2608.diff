@@ -117,6 +117,25 @@ IF(OPENSUBDIV_FOUND)
   SET(OPENSUBDIV_LIBRARIES ${_opensubdiv_LIBRARIES})
   SET(OPENSUBDIV_INCLUDE_DIRS ${OPENSUBDIV_INCLUDE_DIR})
 
+  # Expose OpenSubdiv as imported targets rather than bare filesystem paths.
+  # USD's exported targets reference these by name, so the absolute paths are
+  # resolved by whichever find module is in play. That keeps the installed
+  # package relocatable: a consumer re-runs the find module against their own
+  # OpenSubdiv instead of inheriting a path that only exists on the build
