diff --git a/pxr/CMakeLists.txt b/pxr/CMakeLists.txt
index a02287dda..96bf0ebf6 100644
--- a/pxr/CMakeLists.txt
+++ b/pxr/CMakeLists.txt
@@ -63,6 +63,92 @@ foreach(property IN ITEMS
     endif()
 endforeach()
 
+# The TBB properties captured above are only written into the installed config
+# file when explicitly requested via PXR_EMBED_DEPENDENCY_PATHS_IN_CONFIG. They
+# are consumed by the fallback branch that synthesises TBB::tbb when TBB was not
+# found in CONFIG mode, but emitting them unconditionally still bakes
+# build-machine paths into the installed package. The compile definitions carry
+# no paths, so they are always preserved.
+foreach(property
+    INTERFACE_INCLUDE_DIRECTORIES
+    INTERFACE_LINK_DIRECTORIES
+    IMPORTED_IMPLIB
+    IMPORTED_LOCATION)
+    if(PXR_EMBED_DEPENDENCY_PATHS_IN_CONFIG)
+        set(PXR_CONFIG_tbb_${property} "${tbb_${property}}")
+    else()
+        set(PXR_CONFIG_tbb_${property} "")
+    endif()
+endforeach()
+
+# FindOpenSubdiv.cmake only searches for osdGPU when OPENSUBDIV_USE_GPU is set.
+# Packages.cmake assigns it from PXR_BUILD_GPU_SUPPORT as a plain (non-cache)
+# variable, so it is not visible when a consumer re-runs the module from the
+# installed config file. Record it as an explicit ON/OFF so the consumer
+# reproduces the same component set and OpenSubdiv::osdGPU gets created.
+if(PXR_BUILD_GPU_SUPPORT)
+    set(PXR_CONFIG_OPENSUBDIV_USE_GPU ON)
+else()
+    set(PXR_CONFIG_OPENSUBDIV_USE_GPU OFF)
+endif()
+
+# The find modules also branch on these user-supplied inputs, which are plain
+# variables. Record them so a consumer re-running the modules sees the same
+# behaviour this build did.
+if(OPENSUBDIV_USE_STATIC_LIBS)
+    set(PXR_CONFIG_OPENSUBDIV_USE_STATIC_LIBS ON)
+else()
+    set(PXR_CONFIG_OPENSUBDIV_USE_STATIC_LIBS OFF)
+endif()
+if(PXR_USE_DEBUG_BUILD)
+    set(PXR_CONFIG_PXR_USE_DEBUG_BUILD ON)
+else()
+    set(PXR_CONFIG_PXR_USE_DEBUG_BUILD OFF)
+endif()
+
+# OpenGL is only searched for when GL support is enabled and we are not
+# targeting an Apple embedded platform, which is exactly when the exported
+# targets end up referencing OpenGL::GL. Record that as an explicit ON/OFF so
+# the installed config file can re-run the find module under the same
+# conditions. PXR_APPLE_EMBEDDED is only defined on APPLE, so it cannot be
+# substituted directly into the template.
+if(PXR_ENABLE_GL_SUPPORT AND NOT PXR_APPLE_EMBEDDED)
+    set(PXR_CONFIG_FIND_OPENGL ON)
+else()
+    set(PXR_CONFIG_FIND_OPENGL OFF)
+endif()
+
+# Vulkan is located through package config files, so the directories recorded
+# during this build are absolute paths into the build machine. They are only
+# written into the installed config file when explicitly requested via
+# PXR_EMBED_DEPENDENCY_PATHS_IN_CONFIG.
+foreach(vulkan_pkg VulkanHeaders VulkanUtilityLibraries VulkanMemoryAllocator)
+    if(PXR_EMBED_DEPENDENCY_PATHS_IN_CONFIG)
+        set(PXR_CONFIG_${vulkan_pkg}_DIR "${${vulkan_pkg}_DIR}")
+    else()
+        set(PXR_CONFIG_${vulkan_pkg}_DIR "")
+    endif()
+endforeach()
+
+# The absolute paths of the Python interpreter, library and headers used for
+# this build are only written into the installed config file when explicitly
+# requested via PXR_EMBED_PYTHON_PATHS_IN_CONFIG. Baking them in pins
+# consumers to that exact Python installation and makes the installed package
+# non-relocatable, so they are left empty by default.
+if(PXR_EMBED_DEPENDENCY_PATHS_IN_CONFIG)
+    set(PXR_CONFIG_Python3_EXECUTABLE "${Python3_EXECUTABLE}")
+    set(PXR_CONFIG_Python3_LIBRARY "${Python3_LIBRARY}")
+    set(PXR_CONFIG_Python3_INCLUDE_DIR "${Python3_INCLUDE_DIR}")
+    set(PXR_CONFIG_MaterialX_DIR "${MaterialX_DIR}")
+    set(PXR_CONFIG_Imath_DIR "${Imath_DIR}")
+else()
+    set(PXR_CONFIG_Python3_EXECUTABLE "")
+    set(PXR_CONFIG_Python3_LIBRARY "")
+    set(PXR_CONFIG_Python3_INCLUDE_DIR "")
+    set(PXR_CONFIG_MaterialX_DIR "")
+    set(PXR_CONFIG_Imath_DIR "")
+endif()
+
 configure_file(pxrConfig.cmake.in
   "${PROJECT_BINARY_DIR}/pxrConfig.cmake" @ONLY)
 install(FILES
@@ -70,4 +156,14 @@ install(FILES
   DESTINATION "${CMAKE_INSTALL_PREFIX}"
 )
 
+# Install the find modules that the config file above re-runs, so that
+# consumers resolve the same third-party dependencies without having to
+# supply their own copies.
+install(FILES
+  "${PROJECT_SOURCE_DIR}/cmake/modules/FindOpenVDB.cmake"
+  "${PROJECT_SOURCE_DIR}/cmake/modules/FindOpenSubdiv.cmake"
+  "${PROJECT_SOURCE_DIR}/cmake/modules/FindOpenImageIO.cmake"
+  DESTINATION "${CMAKE_INSTALL_PREFIX}/cmake/modules"
+)
+
 install(EXPORT pxrTargets DESTINATION "cmake")
