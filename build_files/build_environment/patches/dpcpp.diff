   set(URD_BINARY_DIR ${CMAKE_BINARY_DIR}/unified-runtimed)
   set(URD_INSTALL_DIR ${URD_BINARY_DIR}/install)

+  # Verify that required variables are available before forwarding them
+  # to the unified-runtimed sub-build. If any are missing, it means the
+  # parent build did not receive them (e.g., from Blender's dpcpp.cmake).
+  if(NOT DEFINED XPTIFW_PARALLEL_HASHMAP_HEADERS)
+    message(FATAL_ERROR "XPTIFW_PARALLEL_HASHMAP_HEADERS is not defined. Cannot forward to unified-runtimed sub-build.")
+  endif()
+  if(NOT DEFINED Python3_ROOT_DIR)
+    message(FATAL_ERROR "Python3_ROOT_DIR is not defined. Cannot forward to unified-runtimed sub-build.")
+  endif()
+  if(NOT DEFINED Python3_EXECUTABLE)
+    message(FATAL_ERROR "Python3_EXECUTABLE is not defined. Cannot forward to unified-runtimed sub-build.")
+  endif()
+  if(NOT DEFINED PYTHON_EXECUTABLE)
+    message(FATAL_ERROR "PYTHON_EXECUTABLE is not defined. Cannot forward to unified-runtimed sub-build.")
+  endif()
+  if(NOT DEFINED LEVEL_ZERO_LIBRARY)
+    message(FATAL_ERROR "LEVEL_ZERO_LIBRARY is not defined. Cannot forward to unified-runtimed sub-build.")
+  endif()
+  if(NOT DEFINED LEVEL_ZERO_INCLUDE_DIR)
+    message(FATAL_ERROR "LEVEL_ZERO_INCLUDE_DIR is not defined. Cannot forward to unified-runtimed sub-build.")
+  endif()
+  if(NOT DEFINED FETCHCONTENT_SOURCE_DIR_UNIFIED-MEMORY-FRAMEWORK)
+    message(FATAL_ERROR "FETCHCONTENT_SOURCE_DIR_UNIFIED-MEMORY-FRAMEWORK is not defined. Cannot forward to unified-runtimed sub-build.")
+  endif()
+  if(NOT DEFINED FETCHCONTENT_SOURCE_DIR_HWLOC_TARG)
+    message(FATAL_ERROR "FETCHCONTENT_SOURCE_DIR_HWLOC_TARG is not defined. Cannot forward to unified-runtimed sub-build.")
+  endif()
+  if(NOT DEFINED CMAKE_PREFIX_PATH)
+    message(FATAL_ERROR "CMAKE_PREFIX_PATH is not defined. Cannot forward to unified-runtimed sub-build.")
+  endif()
+  if(NOT DEFINED XPTIFW_PARALLEL_HASHMAP_HEADERS)
+    message(FATAL_ERROR "XPTIFW_PARALLEL_HASHMAP_HEADERS is not defined. Cannot forward to unified-runtimed sub-build.")
+  endif()
+  if(NOT DEFINED PHMAP_LOC)
+    message(FATAL_ERROR "PHMAP_LOC is not defined. Cannot forward to unified-runtimed sub-build.")
+  endif()
+
   # This creates a subbuild which can be used in dependencies with the
   # unified-runtimed target. It invokes the install-unified-runtime-libraries
   # target to install the UR runtime libraries.
@@ -226,9 +263,29 @@ if(CMAKE_SYSTEM_NAME STREQUAL Windows)
       -DUMF_BUILD_EXAMPLES:BOOL=${UMF_BUILD_EXAMPLES}
       -DUMF_BUILD_SHARED_LIBRARY:BOOL=${UMF_BUILD_SHARED_LIBRARY}
       -DUMF_LINK_HWLOC_STATICALLY:BOOL=${UMF_LINK_HWLOC_STATICALLY}
-      -DUMF_DISABLE_HWLOC:BOOL=${UMF_DISABLE_HWLOC}
       # Enable d suffix in UMF
       -DUMF_USE_DEBUG_POSTFIX:BOOL=ON
+      # Prevent network access during the debug sub-build. ExternalProject_Add
+      # uses a separate CMake invocation that does not inherit the parent cache,
+      # so FETCHCONTENT_FULLY_DISCONNECTED must be forwarded explicitly.
+      -DFETCHCONTENT_FULLY_DISCONNECTED:BOOL=ON
+      # These variables must be explicitly forwarded to the inner ExternalProject
+      # build on Windows because it uses a separate CMake invocation via
+      # ExternalProject_Add, which does not inherit the parent's cache. Without
+      # forwarding, the sub-build falls back to system defaults and fails to
+      # find Blender's bundled Python and parallel hashmap headers.
+      -DXPTIFW_PARALLEL_HASHMAP_HEADERS:STRING=${XPTIFW_PARALLEL_HASHMAP_HEADERS}
+      -DPython3_ROOT_DIR:STRING=${Python3_ROOT_DIR}
+      -DPython3_EXECUTABLE:STRING=${Python3_EXECUTABLE}
+      -DPYTHON_EXECUTABLE:STRING=${PYTHON_EXECUTABLE}
+      -DLEVEL_ZERO_LIBRARY:STRING=${LEVEL_ZERO_LIBRARY}
+      -DLEVEL_ZERO_INCLUDE_DIR:STRING=${LEVEL_ZERO_INCLUDE_DIR}
+      -DUR_COMPUTE_RUNTIME_FETCH_REPO:BOOL=OFF
+      -DFETCHCONTENT_SOURCE_DIR_UNIFIED-MEMORY-FRAMEWORK:STRING=${FETCHCONTENT_SOURCE_DIR_UNIFIED-MEMORY-FRAMEWORK}
+      -DFETCHCONTENT_SOURCE_DIR_HWLOC_TARG:STRING=${FETCHCONTENT_SOURCE_DIR_HWLOC_TARG}
+      -DCMAKE_PREFIX_PATH:STRING=${CMAKE_PREFIX_PATH}
+      -DXPTIFW_PARALLEL_HASHMAP_HEADERS:STRING=${XPTIFW_PARALLEL_HASHMAP_HEADERS}
+      -DPHMAP_LOC:STRING=${PHMAP_LOC}
   )

