+    # would otherwise insert before the suffix, which would produce names
+    # like _tf_d_d.pyd.
+    _pxr_set_config_postfix(${LIBRARY_NAME} "")
     if(WIN32)
         # Python modules must be suffixed with .pyd on Windows.
         set_target_properties(${LIBRARY_NAME}
@@ -1315,7 +1388,15 @@ function(_pxr_library NAME)
     endif()
 
