/* Maps the GLSL `GL_EXT_ray_query` API onto Metal's inline ray query.
 * Only active for shaders that declare an acceleration structure.
 * `metal::raytracing` is provided by the backend (see `mtl_shader.mm`). */

#pragma once

#ifdef MTL_USE_RAY_QUERY

#  pragma blender dead_code_elimination off

#  define gpu_RayFlagsNone 0u
#  define gpu_RayFlagsOpaque 1u
#  define gpu_RayFlagsNoOpaque 2u
#  define gpu_RayFlagsTerminateOnFirstHit 4u
#  define gpu_RayFlagsSkipClosestHitShader 8u
#  define gpu_RayFlagsCullBackFacingTriangles 16u
#  define gpu_RayFlagsCullFrontFacingTriangles 32u
#  define gpu_RayFlagsCullOpaque 64u
#  define gpu_RayFlagsCullNoOpaque 128u

#  define gpu_RayQueryCommittedIntersectionNone 0u
#  define gpu_RayQueryCommittedIntersectionTriangle 1u
#  define gpu_RayQueryCommittedIntersectionGenerated 2u
#  define gpu_RayQueryCandidateIntersectionTriangle 0u
#  define gpu_RayQueryCandidateIntersectionAABB 1u

/* MSL forbids `intersection_query` as a struct field, so alias the GLSL query type to it. */
using rayQuery = intersection_query<instancing, triangle_data>;

inline void rayQueryInitialize(thread rayQuery &rq,
                               instance_acceleration_structure topLevel,
                               uint rayFlags,
                               uint cullMask,
                               float3 origin,
                               float tMin,
                               float3 direction,
                               float tMax)
{
  intersection_params params;
  if (rayFlags & gpu_RayFlagsTerminateOnFirstHit) {
    params.accept_any_intersection(true);
  }
  if (rayFlags & gpu_RayFlagsOpaque) {
    params.force_opacity(forced_opacity::opaque);
  }
  else if (rayFlags & gpu_RayFlagsNoOpaque) {
    params.force_opacity(forced_opacity::non_opaque);
  }
  if (rayFlags & gpu_RayFlagsCullBackFacingTriangles) {
    params.set_triangle_cull_mode(triangle_cull_mode::back);
  }
  else if (rayFlags & gpu_RayFlagsCullFrontFacingTriangles) {
    params.set_triangle_cull_mode(triangle_cull_mode::front);
  }
  if (rayFlags & gpu_RayFlagsCullOpaque) {
    params.set_opacity_cull_mode(opacity_cull_mode::opaque);
  }
  else if (rayFlags & gpu_RayFlagsCullNoOpaque) {
    params.set_opacity_cull_mode(opacity_cull_mode::non_opaque);
  }
  rq.reset(ray(origin, direction, tMin, tMax), topLevel, cullMask, params);
}

inline bool rayQueryProceed(thread rayQuery &rq)
{
  return rq.next();
}

inline void rayQueryTerminate(thread rayQuery &rq)
{
  rq.abort();
}

inline void rayQueryGenerateIntersection(thread rayQuery &rq, float tHit)
{
  rq.commit_bounding_box_intersection(tHit);
}

inline void rayQueryConfirmIntersection(thread rayQuery &rq)
{
  rq.commit_triangle_intersection();
}

inline uint rayQueryGetIntersectionType(thread rayQuery &rq, bool committed)
{
  if (committed) {
    switch (rq.get_committed_intersection_type()) {
      case intersection_type::triangle:
        return gpu_RayQueryCommittedIntersectionTriangle;
      case intersection_type::bounding_box:
        return gpu_RayQueryCommittedIntersectionGenerated;
      default:
        return gpu_RayQueryCommittedIntersectionNone;
    }
  }
  return (rq.get_candidate_intersection_type() == intersection_type::bounding_box) ?
             gpu_RayQueryCandidateIntersectionAABB :
             gpu_RayQueryCandidateIntersectionTriangle;
}

inline float rayQueryGetRayTMin(thread rayQuery &rq)
{
  return rq.get_ray_min_distance();
}

/* Not mapped to Metal: no query-side ray-flags accessor, and MSL forbids caching the flags on the
 * query object. Gated off so a shader using it fails to compile rather than silently reading 0. */
#  if 0
inline uint rayQueryGetRayFlags(thread rayQuery &rq)
{
  return 0u;
}
#  endif

inline float3 rayQueryGetWorldRayOrigin(thread rayQuery &rq)
{
  return rq.get_world_space_ray_origin();
}

inline float3 rayQueryGetWorldRayDirection(thread rayQuery &rq)
{
  return rq.get_world_space_ray_direction();
}

inline float rayQueryGetIntersectionT(thread rayQuery &rq, bool committed)
{
  return committed ? rq.get_committed_distance() : rq.get_candidate_triangle_distance();
}

inline uint rayQueryGetIntersectionInstanceId(thread rayQuery &rq, bool committed)
{
  return committed ? rq.get_committed_instance_id() : rq.get_candidate_instance_id();
}

inline uint rayQueryGetIntersectionInstanceCustomIndex(thread rayQuery &rq, bool committed)
{
  /* Metal's per-instance `userID` is the custom index. Currently 0 for every instance (matches
   * the Vulkan backend) until the GPU API exposes a per-instance custom index. */
  return committed ? rq.get_committed_user_instance_id() : rq.get_candidate_user_instance_id();
}

/* Not mapped to Metal: no inline equivalent. Gated off so use is a compile error, not a wrong 0.
 */
#  if 0
inline uint rayQueryGetIntersectionInstanceShaderBindingTableRecordOffset(
    thread rayQuery &rq, bool committed)
{
  return 0u;
}
#  endif

inline uint rayQueryGetIntersectionGeometryIndex(thread rayQuery &rq, bool committed)
{
  return committed ? rq.get_committed_geometry_id() : rq.get_candidate_geometry_id();
}

inline uint rayQueryGetIntersectionPrimitiveIndex(thread rayQuery &rq, bool committed)
{
  return committed ? rq.get_committed_primitive_id() : rq.get_candidate_primitive_id();
}

inline float2 rayQueryGetIntersectionBarycentrics(thread rayQuery &rq, bool committed)
{
  return committed ? rq.get_committed_triangle_barycentric_coord() :
                     rq.get_candidate_triangle_barycentric_coord();
}

inline bool rayQueryGetIntersectionFrontFace(thread rayQuery &rq, bool committed)
{
  return committed ? rq.is_committed_triangle_front_facing() :
                     rq.is_candidate_triangle_front_facing();
}

inline bool rayQueryGetIntersectionCandidateAABBOpaque(thread rayQuery &rq)
{
  return !rq.is_candidate_non_opaque_bounding_box();
}

inline float3 rayQueryGetIntersectionObjectRayDirection(thread rayQuery &rq, bool committed)
{
  return committed ? rq.get_committed_ray_direction() : rq.get_candidate_ray_direction();
}

inline float3 rayQueryGetIntersectionObjectRayOrigin(thread rayQuery &rq, bool committed)
{
  return committed ? rq.get_committed_ray_origin() : rq.get_candidate_ray_origin();
}

inline float4x3 rayQueryGetIntersectionObjectToWorld(thread rayQuery &rq, bool committed)
{
  return committed ? rq.get_committed_object_to_world_transform() :
                     rq.get_candidate_object_to_world_transform();
}

inline float4x3 rayQueryGetIntersectionWorldToObject(thread rayQuery &rq, bool committed)
{
  return committed ? rq.get_committed_world_to_object_transform() :
                     rq.get_candidate_world_to_object_transform();
}

#  pragma blender dead_code_elimination on

#endif /* MTL_USE_RAY_QUERY */
