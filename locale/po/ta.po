msgid "Pivot in terms of the stroke point parameter u (0 <= u <= 1)"
msgstr "வீச்சு புள்ளி அளவுரு u (0 <= u <= 1) இன் அடிப்படையில் முன்னிலை"


msgid "Pivot X"
msgstr "பிவோட் ஃச்"


msgid "2D X coordinate of the absolute pivot"
