msgctxt "Operator"
msgid "Add Feather Vertex"
msgstr "இறகு வெர்டெக்ச் சேர்க்கவும்"


msgid "Add vertex to feather"
msgstr "இறகுக்கு வெர்டெக்ச் சேர்க்கவும்"


