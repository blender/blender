msgstr "பண்புக்கூறு"


msgid "Converter"
msgstr "மாற்றி"


msgid "Distort"
msgstr "அழி"


msgid "Filter"
msgstr "வடிகட்டி"


msgid "Matte"
msgstr "மேட்"


msgid "Script"
msgstr "கையால் எழுதப்பட்ட தாள்"


msgid "Pattern"
msgstr "முறை"


msgid "Interface"
