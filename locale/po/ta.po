msgid "Select Time Marker"
msgstr "நேர மார்க்கரைத் தேர்ந்தெடுக்கவும்"


msgid "Select time marker(s)"
msgstr "நேர மார்க்கர் (கள்) தேர்ந்தெடுக்கவும்"


