msgid "Kink"
msgstr "கின்க்"


msgid "Type of periodic offset on the curve"
msgstr "வளைவில் அவ்வப்போது ஆஃப்செட் வகை"


msgctxt "ParticleSettings"
msgid "None"
msgstr "எதுவுமில்லை"


msgctxt "ParticleSettings"
msgid "Braid"
msgstr "பின்னல்"


msgctxt "ParticleSettings"
msgid "Curl"
msgstr "சுருட்டை"


msgctxt "ParticleSettings"
msgid "Radial"
