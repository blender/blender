msgid "Phase of the sinus displacement"
msgstr "சைனச் இடப்பெயர்ச்சியின் கட்டம்"


msgid "Wavelength"
msgstr "அலைநீளம்"


msgid "Wavelength of the sinus displacement"
msgstr "சைனச் இடப்பெயர்ச்சியின் அலைநீளம்"


