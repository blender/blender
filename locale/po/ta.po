msgid "Active Vertex Color Index"
msgstr "செயலில் உள்ள வெர்டெக்ச் வண்ண அட்டவணை"


msgid "Active vertex color index"
msgstr "செயலில் உள்ள வெர்டெக்ச் வண்ண அட்டவணை"


msgid "Mask Layer"
