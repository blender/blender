msgctxt "Scene"
msgid "Type"
msgstr "தட்டச்சு செய்க"


msgctxt "Scene"
msgid "New"
msgstr "புதிய"


msgid "Add a new, empty scene with default settings"
msgstr "இயல்புநிலை அமைப்புகளுடன் புதிய, வெற்று காட்சியைச் சேர்க்கவும்"


msgctxt "Scene"
