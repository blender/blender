msgstr "திசையன் மதிப்பு"


msgid "Integer Value"
msgstr "முழுஎண் மதிப்பு"


msgid "3D Vector Value"
msgstr "3D வெக்டர் மதிப்பு"


msgid "8-Bit Integer Value"
msgstr "8-பிட் முழுஎண் மதிப்பு"


msgid "Text Value"
msgstr "உரை மதிப்பு"


