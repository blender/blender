msgstr "ஃச் மேக்ச்"


msgid "X Min"
msgstr "ஃச் மணித்துளி"


msgid "Y Max"
msgstr "ஒய் அதிகபட்சம்"


msgid "Y Min"
msgstr "ஒய் மணித்துளி"


msgctxt "Operator"
