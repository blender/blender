msgid "Copy Settings"
msgstr "அமைப்புகளை நகலெடுக்கவும்"


msgid "Linked Copy"
msgstr "இணைக்கப்பட்ட நகல்"


msgid "Full Copy"
msgstr "முழு நகல்"


msgctxt "Operator"
msgid "New Sequencer Scene"
msgstr "புதிய சீக்வென்சர் காட்சி"


