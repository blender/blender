msgctxt "Mask"
msgid "Mask Tool"
msgstr "முகமூடி கருவி"


msgctxt "Mask"
msgid "Draw"
msgstr "வரை"


msgctxt "Mask"
msgid "Smooth"
msgstr "மென்மையான"


