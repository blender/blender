msgstr "முகமூடி அடுக்கை அகற்று"


msgctxt "Operator"
msgid "New Mask"
msgstr "புதிய முகமூடி"


msgid "Create new mask"
msgstr "புதிய முகமூடியை உருவாக்கவும்"


