msgstr "கேச் மெச்"


msgid "MDD"
msgstr "எம்டிடி"


msgid "PC2"
msgstr "பிசி 2"


msgid "Deform Mode"
msgstr "சிதைவு பயன்முறை"


msgid "Overwrite"
msgstr "மேலெழுதும்"


