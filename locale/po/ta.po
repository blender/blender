msgstr "u (x) அச்சு"


msgid "V (Y) Axis"
msgstr "v (y) அச்சு"


msgid "W (Z) Axis"
msgstr "w (z) அச்சு"


msgctxt "Operator"
msgid "Make Regular"
msgstr "வழக்கமான செய்யுங்கள்"


