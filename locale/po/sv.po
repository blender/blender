msgctxt "Operator"
msgid "Revert"
msgstr "Återställ"


msgid "Reload the saved file"
msgstr "Ladda om den sparade filen"


msgid "Add external feature set (rigs, metarigs, ui templates)"
msgstr "Lägg till extern funktionsuppsättning (riggar, metariggar, gränssnittsmallar)"


msgid "Remove external feature set (rigs, metarigs, ui templates)"
msgstr "Ta bort extern funktionsuppsättning (riggar, metariggar, gränssnittsmallar)"


msgid "Save the current file in the desired location"
msgstr "Spara den aktuella filen på önskad plats"


msgid "Compress"
msgstr "Komprimera"


msgid "Write compressed .blend file"
msgstr "Skriv komprimerad .blend-fil"


msgid "Save Copy"
msgstr "Spara kopia"


msgid "Save a copy of the actual working state but does not make saved file active"
msgstr "Spara en kopia av det aktuella arbetsläget utan att göra den sparade filen aktiv"


msgid "Remap Relative"
msgstr "Mappa om relativa"


msgid "Remap relative paths when saving to a different directory"
msgstr "Mappa om relativa sökvägar när du sparar i en annan katalog"


msgid "Show Save Modified Images Dialog"
msgstr "Visa dialogrutan för att spara ändrade bilder"


msgid "Show a popup dialog to save modified images before saving the blend file"
msgstr "Visa ett poppuppfönster för att spara ändrade bilder innan blend-filen sparas"


msgctxt "Operator"
msgid "Save Autosave"
msgstr "Spara autosparning"


msgid "Create an autosave in the temp directory for the current file"
msgstr "Skapa en autosparning i den tillfälliga katalogen för den aktuella filen"


msgctxt "Operator"
msgid "Save Startup File"
msgstr "Spara startfil"


msgid "Make the current file the default startup file"
msgstr "Gör den aktuella filen till standardstartfil"


msgctxt "Operator"
msgid "Save Blender File"
msgstr "Spara Blender-fil"


msgid "Save the current Blender file"
msgstr "Spara den aktuella Blender-filen"


msgid "Exit Blender after saving"
msgstr "Avsluta Blender efter att ha sparat"


msgid "Save the current Blender file with a numerically incremented name that does not overwrite any existing files"
msgstr "Spara den aktuella Blender-filen under ett numeriskt ökat namn utan att skriva över befintliga filer"


msgctxt "Operator"
msgid "Save Preferences"
msgstr "Spara inställningar"


msgid "Make the current preferences default"
msgstr "Gör de aktuella inställningarna till standardinställningar"


msgctxt "Operator"
msgid "Search Menu"
msgstr "Sökmeny"


msgid "Pop-up a search over all menus in the current context"
msgstr "Öppna en sökning bland alla menyer i aktuell kontext"


msgctxt "Operator"
msgid "Search Operator"
msgstr "Sökoperator"


msgid "Pop-up a search over all available operators in current context"
msgstr "Öppna en sökning bland alla tillgängliga operatorer i aktuell kontext"


msgctxt "Operator"
msgid "Search Single Menu"
msgstr "Sök i enstaka meny"


msgid "Pop-up a search for a menu in current context"
msgstr "Öppna en sökning efter en meny i aktuell kontext"


msgid "Initial Query"
msgstr "Inledande sökfråga"


msgid "Query to insert into the search box"
msgstr "Sökfråga att infoga i sökrutan"


msgid "Menu Name"
msgstr "Menynamn"


msgid "Menu to search in"
msgstr "Meny att söka i"


msgctxt "Operator"
msgid "Set Stereo 3D"
msgstr "Ställ in stereo 3D"


msgid "Toggle 3D stereo support for current window (or change the display mode)"
msgstr "Växla 3D-stereostöd för aktuellt fönster (eller ändra visningsläget)"


msgid "Anaglyph Type"
msgstr "Anaglyftyp"


msgid "Red-Cyan"
msgstr "Röd-cyan"


msgid "Green-Magenta"
msgstr "Grön-magenta"


msgid "Yellow-Blue"
msgstr "Gul-blå"


msgid "Anaglyph"
msgstr "Anaglyf"


msgid "Render views for left and right eyes as two differently filtered colors in a single image (anaglyph glasses are required)"
msgstr "Rendera vyer för vänster och höger öga som två olika filtrerade färger i en enda bild (anaglyfglasögon krävs)"


msgid "Interlace"
msgstr "Sammanflätning"


msgid "Render views for left and right eyes interlaced in a single image (3D-ready monitor is required)"
msgstr "Rendera vyer för vänster och höger öga sammanflätade i en enda bild (3D-kompatibel bildskärm krävs)"


msgid "Time Sequential"
msgstr "Tidssekventiell"


msgid "Render alternate eyes (also known as page flip, quad buffer support in the graphic card is required)"
msgstr "Rendera växelvis för ögonen (kallas även sidvändning; kräver stöd för fyrdubbla buffertar i grafikkortet)"


msgid "Side-by-Side"
msgstr "Sida vid sida"


msgid "Render views for left and right eyes side-by-side"
msgstr "Rendera vyer för vänster och höger öga sida vid sida"


msgid "Top-Bottom"
msgstr "Över-under"


msgid "Render views for left and right eyes one above another"
msgstr "Rendera vyer för vänster och höger öga ovanför varandra"


msgid "Interlace Type"
msgstr "Sammanflätningstyp"


msgid "Row Interleaved"
msgstr "Sammanflätad per rad"


msgid "Column Interleaved"
msgstr "Sammanflätad per kolumn"


msgid "Checkerboard Interleaved"
msgstr "Sammanflätad i schackbräde"


msgid "Swap Left/Right"
msgstr "Byt vänster/höger"


msgid "Swap left and right stereo channels"
msgstr "Byt vänster och höger stereokanaler"


msgid "Cross-Eyed"
msgstr "Korsögd"


msgid "Right eye should see left image and vice versa"
msgstr "Höger öga ska se vänster bild och vice versa"


msgctxt "Operator"
msgid "Set Blend File Working Color Space"
msgstr "Ange .blend-filens arbetsfärgrymd"


msgid "Change the working color space of all colors in this blend file"
msgstr "Ändra arbetsfärgrymden för alla färger i denna .blend-fil"


msgid "Convert Colors in All Data-blocks"
msgstr "Konvertera färger i alla datablock"


msgid "Change colors in all data-blocks to the new working space"
msgstr "Ändra färgerna i alla datablock till den nya arbetsfärgrymden"


msgid "Color space to set"
msgstr "Färgrymd att ange"


msgctxt "Operator"
msgid "Splash Screen"
msgstr "Startskärm"


msgid "Open the splash screen with release info"
msgstr "Öppna startskärmen med versionsinformation"


msgctxt "Operator"
msgid "About Blender"
msgstr "Om Blender"


msgid "Open a window with information about Blender"
msgstr "Öppna ett fönster med information om Blender"


msgctxt "Operator"
msgid "Export STL"
msgstr "Exportera STL"


msgid "Save the scene to an STL file"
msgstr "Spara scenen som en STL-fil"


msgid "Batch Export"
msgstr "Batchexport"


msgid "Export each object to a separate file"
msgstr "Exportera varje objekt till en separat fil"


msgid "Apply current scene's unit (as defined by unit scale) to exported data"
msgstr "Tillämpa den aktuella scenens enhet (enligt enhetsskalan) på exporterade data"


msgctxt "Operator"
msgid "Import STL"
msgstr "Importera STL"


msgid "Import an STL file as an object"
msgstr "Importera en STL-fil som ett objekt"


msgid "Facet Normals"
msgstr "Facetnormaler"


msgid "Use (import) facet normals (note that this will still give flat shading)"
msgstr "Använd (importera) fasettnormaler (observera att detta fortfarande ger platt skuggning)"


msgid "Validate Mesh"
msgstr "Validera nät"


msgid "Brush type identifier for which the most appropriate tool will be looked up"
msgstr "Identifierare för borsttyp som används för att hitta det lämpligaste verktyget"


msgid "Set Fallback"
msgstr "Ställ in reservlösning"


msgid "Set the fallback tool instead of the primary tool"
msgstr "Ange reservverktyget i stället för det primära verktyget"


msgid "Cycle"
msgstr "Växla"


msgid "Cycle through tools in this group"
msgstr "Växla mellan verktygen i den här gruppen"


msgid "Identifier of the tool"
msgstr "Verktygets identifierare"


msgid "Set the fallback tool instead of the primary"
msgstr "Ställ in reservverktyget istället för det primära"


msgid "Include tool subgroups"
msgstr "Inkludera verktygsundergrupper"


msgid "Index in Toolbar"
msgstr "Index i verktygsfältet"


msgid "URL to open"
msgstr "URL att öppna"


msgid "Site"
msgstr "Webbplats"


msgctxt "Operator"
msgid "Export USD"
msgstr "Exportera USD"


msgid "Export current scene in a USD archive"
msgstr "Exportera aktuell scen i ett USD-arkiv"


msgid "Set the accessibility description for the exported stage's default prim"
msgstr "Ange tillgänglighetsbeskrivningen för standardprimet i den exporterade USD-scenen"


msgid "Set the accessibility label for the exported stage's default prim"
msgstr "Ange tillgänglighetsetiketten för standardprimet i den exporterade USD-scenen"


msgid "Allow Unicode"
msgstr "Tillåt Unicode"


msgid "Preserve UTF-8 encoded characters when writing USD prim and property names (requires software utilizing USD 24.03 or greater when opening the resulting files)"
msgstr "Bevara UTF-8-kodade tecken när USD-prim- och egenskapsnamn skrivs (kräver programvara som använder USD 24.03 eller senare för att öppna de resulterande filerna)"


msgid "Blender Names"
msgstr "Blender-namn"


msgid "Author USD custom attributes containing the original Blender object and object data names"
msgstr "Skapa USD-anpassade attribut som innehåller de ursprungliga namnen på Blender-objekt och objektdata"


msgid "Convert Orientation"
msgstr "Konvertera orientering"


msgid "Convert orientation axis to a different convention to match other applications"
msgstr "Konvertera orienteringsaxeln till en annan konvention för att stämma med andra program"


msgid "Set the USD Stage meters per unit to the chosen measurement, or a custom value"
msgstr "Ange meter per enhet för USD-scenen till det valda måttet eller ett anpassat värde"


msgid "Meters"
msgstr "Meter"


msgid "Scene meters per unit to 1.0"
msgstr "Ange scenens meter per enhet till 1,0"


msgid "Kilometers"
msgstr "Kilometer"


msgid "Scene meters per unit to 1000.0"
msgstr "Ange scenens meter per enhet till 1000,0"


msgid "Centimeters"
msgstr "Centimeter"


msgid "Scene meters per unit to 0.01"
msgstr "Ange scenens meter per enhet till 0,01"


msgid "Scene meters per unit to 0.001"
msgstr "Ange scenens meter per enhet till 0,001"


msgid "Inches"
msgstr "Tum"


msgid "Scene meters per unit to 0.0254"
msgstr "Ange scenens meter per enhet till 0,0254"


msgid "Feet"
msgstr "Fot"


msgid "Scene meters per unit to 0.3048"
msgstr "Ange scenens meter per enhet till 0,3048"


msgid "Yards"
msgstr "Yard"


msgid "Scene meters per unit to 0.9144"
msgstr "Ange scenens meter per enhet till 0,9144"


msgid "Specify a custom scene meters per unit value"
msgstr "Ange ett anpassat värde för scenens meter per enhet"


msgid "World Dome Light"
msgstr "Kupolljus för värld"


msgid "Convert the world material to a USD dome light. Currently works for simple materials, consisting of an environment texture connected to a background shader, with an optional vector multiply of the texture color"
msgstr "Konvertera världsmaterialet till ett USD-kupolljus. Fungerar för närvarande för enkla material, bestående av en miljötextur kopplad till en bakgrundsshader, med en valfri vektormultiplikation av texturfärgen"


msgid "Namespace"
msgstr "Namnområde"


msgid "If set, add the given namespace as a prefix to exported custom property names. This only applies to property names that do not already have a prefix (e.g., it would apply to name 'bar' but not 'foo:bar') and does not apply to blender object and data names which are always exported in the 'userProperties:blender' namespace"
msgstr "Om angivet läggs det angivna namnområdet till som prefix för exporterade anpassade egenskapsnamn. Detta gäller endast egenskapsnamn som inte redan har ett prefix (t.ex. namnet ”bar”, men inte ”foo:bar”) och gäller inte Blender-objekt och datanamn som alltid exporteras i namnområdet ”userProperties:blender”"


msgid "Use Settings for"
msgstr "Använd inställningar för"


msgid "Export all frames in the render frame range, rather than only the current frame"
msgstr "Exportera alla bildrutor i renderingsintervallet i stället för endast den aktuella bildrutan"


msgid "Export armatures and meshes with armature modifiers as USD skeletons and skinned meshes"
msgstr "Exportera armaturer och nät med armaturmodifierare som USD-skelett och skinnade nät"


msgid "Export all cameras"
msgstr "Exportera alla kameror"


msgid "Export all curves"
msgstr "Exportera alla kurvor"


msgid "Export custom properties as USD attributes"
msgstr "Exportera anpassade egenskaper som USD-attribut"


msgid "Export hair particle systems as USD curves"
msgstr "Exportera hårpartikelsystem som USD-kurvor"


msgid "Export all lights"
msgstr "Exportera alla lampor"


msgid "Export viewport settings of materials as USD preview materials, and export material assignments as geometry subsets"
msgstr "Exportera visningsområdesinställningar för material som USD-förhandsgranskningsmaterial och exportera materialtilldelningar som geometriunderuppsättningar"


msgid "Include mesh color attributes in the export"
msgstr "Inkludera nätets färgattribut i exporten"


msgid "Export all meshes"
msgstr "Exportera alla nät"


msgid "Include normals of exported meshes in the export"
msgstr "Inkludera normaler för exporterade nät i exporten"


msgid "Export all point clouds"
msgstr "Exportera alla punktmoln"


msgid "Export shape keys as USD blend shapes"
msgstr "Exportera formnycklar som USD-blandningsformer"


msgid "Subdivision"
msgstr "Underindelning"


msgid "Choose how subdivision modifiers will be mapped to the USD subdivision scheme during export"
msgstr "Välj hur subdivisionsmodifierare mappas till USD-underindelningsschemat under exporten"


msgid "Scheme = None. Export base mesh without subdivision"
msgstr "Schema = Inget. Exportera basnät utan underindelning"


msgid "Tessellate"
msgstr "Tessellera"


msgid "Scheme = None. Export subdivided mesh"
msgstr "Schema = Inget. Exportera underindelad mesh"


msgid "Best Match"
msgstr "Bästa match"


msgid "Scheme = Catmull-Clark, when possible. Reverts to exporting the subdivided mesh for the Simple subdivision type"
msgstr "Schema = Catmull-Clark när det är möjligt. Återgå till export av det underindelade nätet för underindelningstypen Simple"


msgid "Export Textures"
msgstr "Exportera texturer"


msgid "Texture export method"
msgstr "Texturexportmetod"


msgid "Use original location of textures"
msgstr "Använd texturernas ursprungliga plats"


msgid "Preserve"
msgstr "Bevara"


msgid ""
"Preserve file paths of textures from already imported USD files.\n"
"Export remaining textures to a 'textures' folder next to the USD file"
msgstr ""
"Bevara filsökvägar för texturer från redan importerade USD-filer.\n"
"Exportera återstående texturer till en mapp med namnet ”textures” bredvid USD-filen"


msgid "New Path"
msgstr "Ny sökväg"


msgid "Export textures to a 'textures' folder next to the USD file"
msgstr "Exportera texturer till mappen ”textures” bredvid USD-filen"


msgid "UV Maps"
msgstr "UV-kartor"


msgid "Include all mesh UV maps in the export"
msgstr "Inkludera alla UV-kartor för nät i exporten"


msgid "Export all volumes"
msgstr "Exportera alla volymer"


msgid "MaterialX Network"
msgstr "MaterialX-nätverk"


msgid "Generate a MaterialX network representation of the materials"
msgstr "Skapa en MaterialX-nätverksrepresentation av materialen"


msgid "USD Preview Surface Network"
msgstr "Nätverk för USD Preview Surface"


msgid "Generate an approximate USD Preview Surface shader representation of a Principled BSDF node network"
msgstr "Skapa en ungefärlig shaderrepresentation av USD Preview Surface för ett Principled BSDF-nodnätverk"


msgid "Incremental Save"
msgstr "Inkrementell sparning"


msgid "Incrementally save after the specified number of frames to reduce peak memory usage. Incremental saves can result in longer export times and potential issues with some file synchronization services. Zero disables incremental save"
msgstr "Spara stegvis efter det angivna antalet bildrutor för att minska högsta minnesanvändningen. Stegvisa sparningar kan ge längre exporttider och problem med vissa filsynkroniseringstjänster. Noll inaktiverar stegvis sparning"


msgid "Merge parent Xform"
msgstr "Sammanfoga överordnad Xform"


msgid "Merge USD primitives with their Xform parent if possible. USD does not allow nested UsdGeomGprims, intermediary Xform prims will be defined to keep the USD file valid when encountering object hierarchies."
msgstr "Slå samman USD-primitiver med deras överordnade Xform om möjligt. USD tillåter inte kapslade UsdGeomGprims. Mellanliggande Xform-primitiver definieras för att hålla USD-filen giltig vid objekthierarkier"


msgid "Meters Per Unit"
msgstr "Meter per enhet"


msgid "Custom value for meters per unit in the USD Stage"
msgstr "Anpassat värde för meter per enhet i USD-scenen"


msgid "Only export deform bones and their parents"
msgstr "Exportera endast deformerande ben och deras föräldrar"


msgid "Overwrite Textures"
msgstr "Skriv över texturer"


msgid "Overwrite existing files when exporting textures"
msgstr "Skriv över befintliga filer vid export av texturer"


msgid "Use relative paths to reference external files (i.e. textures, volumes) in USD, otherwise use absolute paths"
msgstr "Använd relativa sökvägar för externa filer (t.ex. texturer och volymer) i USD, annars absoluta sökvägar"


msgid "Rename UV Maps"
msgstr "Byt namn på UV-kartor"


msgid "Rename active render UV map to \"st\" to match USD conventions"
msgstr "Byt namn på aktiv renderings-UV-karta till ”st” för att matcha USD-konventioner"


msgid "Root Prim"
msgstr "Rotprim"


msgid "If set, add a transform primitive with the given path to the stage as the parent of all exported data"
msgstr "Om angivet läggs en transformeringsprimitiv med den angivna sökvägen till i scenen som överordnad för all exporterad data"


msgid "Selection Only"
msgstr "Endast markerade"


msgid "Only export selected objects. Unselected parents of selected objects are exported as empty transform"
msgstr "Exportera endast markerade objekt. Omarkerade överordnade objekt till markerade objekt exporteras som tomma transformeringar"


msgid "Triangulate Meshes"
msgstr "Triangulera nät"


msgid "Triangulate meshes during export"
msgstr "Triangulera nät under export"


msgid "USDZ Custom Downscale Size"
msgstr "Anpassad USDZ-nedskalningsstorlek"


msgid "Custom size for downscaling exported textures"
msgstr "Anpassad storlek för nedskalning av exporterade texturer"


msgid "USDZ Texture Downsampling"
msgstr "Nedsampling av USDZ-texturer"


msgid "Choose a maximum size for all exported textures"
msgstr "Välj en maximal storlek för alla exporterade texturer"


msgid "Keep all current texture sizes"
msgstr "Behåll alla nuvarande texturstorlekar"


msgid "Resize to a maximum of 256 pixels"
msgstr "Ändra storlek till maximalt 256 pixlar"


msgid "Resize to a maximum of 512 pixels"
msgstr "Ändra storlek till maximalt 512 pixlar"


msgid "Resize to a maximum of 1024 pixels"
msgstr "Ändra storlek till maximalt 1024 pixlar"


msgid "Resize to a maximum of 2048 pixels"
msgstr "Ändra storlek till maximalt 2048 pixlar"


msgid "Resize to a maximum of 4096 pixels"
msgstr "Ändra storlek till maximalt 4096 pixlar"


msgid "Specify a custom size"
msgstr "Ange en anpassad storlek"


msgid "Instancing"
msgstr "Instansiering"


msgid "Export instanced objects as references in USD rather than real objects"
msgstr "Exportera instansierade objekt som referenser i USD i stället för som riktiga objekt"


msgid "Xform Ops"
msgstr "Transformeringsoperatorer"


msgid "The type of transform operators to write"
msgstr "Typ av transformeringsoperatorer att skriva"


msgid "Translate, Rotate, Scale"
msgstr "Förflytta, rotera, skala"


msgid "Export with translate, rotate, and scale Xform operators"
msgstr "Exportera med Xform-operatorerna förflyttning, rotation och skalning"


msgid "Translate, Orient, Scale"
msgstr "Förflytta, orientera, skala"


msgid "Export with translate, orient quaternion, and scale Xform operators"
msgstr "Exportera med Xform-operatorerna förflyttning, orienteringskvaternion och skalning"


msgid "Export matrix operator"
msgstr "Exportera matrisoperator"


msgctxt "Operator"
msgid "Import USD"
msgstr "Importera USD"


msgid "Import USD stage into current scene"
msgstr "Importera USD-scenen till aktuell scen"


msgid "Apply Unit Conversion Scale"
msgstr "Tillämpa enhetsomvandlingsskala"


msgid "Scale the scene objects by the USD stage's meters per unit value. This scaling is applied in addition to the value specified in the Scale option"
msgstr "Skala scenobjekten efter värdet meter per enhet i USD-scenen. Skalningen tillämpas utöver värdet som anges i alternativet Skala"


msgid "Create Collection"
msgstr "Skapa samling"


msgid "Add all imported objects to a new collection"
msgstr "Lägg till alla importerade objekt i en ny samling"


msgid "Convert the first discovered USD dome light to a world background shader"
msgstr "Konvertera den första upptäckta USD-kupollampan till en bakgrundsshader för världen"


msgid "Import All Materials"
msgstr "Importera alla material"


msgid "Also import materials that are not used by any geometry. Note that when this option is false, materials referenced by geometry will still be imported"
msgstr "Importera även material som inte används av någon geometri. Observera att när alternativet är falskt importeras fortfarande material som refereras av geometri"


msgid "Defined Primitives Only"
msgstr "Endast definierade primitiva typer"


msgid "Import only defined USD primitives. When disabled this allows importing USD primitives which are not defined, such as those with an override specifier"
msgstr "Importera endast definierade USD-primitiv. När denna funktion är inaktiverad kan USD-primitiv som inte är definierade importeras, till exempel sådana med en överskrivningsspecifikator"


msgid "Import guide geometry"
msgstr "Importera ledgeometri"


msgid "Import proxy geometry"
msgstr "Importera proxygeometri"


msgid "Import final render geometry"
msgstr "Importera slutlig renderingsgeometri"


msgid "USD Shapes"
msgstr "USD-former"


msgid "Import Subdivision Scheme"
msgstr "Importera underindelningsschema"


msgid "Create subdivision surface modifiers based on the USD SubdivisionScheme attribute"
msgstr "Skapa modifierare för subdivisionsyta baserat på USD-attributet SubdivisionScheme"


msgid "Textures Directory"
msgstr "Texturkatalog"


msgid "Path to the directory where imported textures will be copied"
msgstr "Sökväg till katalogen där importerade texturer kommer att kopieras"


msgid "Import Textures"
msgstr "Importera texturer"


msgid "Behavior when importing textures from a USDZ archive"
msgstr "Beteende vid import av texturer från ett USDZ-arkiv"


msgid "Don't import textures"
msgstr "Importera inte texturer"


msgid "Packed"
msgstr "Packad"


msgid "Import textures as packed data"
msgstr "Importera texturer som packade data"


msgid "Copy files to textures directory"
msgstr "Kopiera filer till texturkatalogen"


msgid "Import USD Preview"
msgstr "Importera USD Preview"


msgid "Convert UsdPreviewSurface shaders to Principled BSDF shader networks"
msgstr "Konvertera UsdPreviewSurface-shaders till Principled BSDF-shadernätverk"


msgid "Visible Primitives Only"
msgstr "Endast synliga primitiver"


msgid "Do not import invisible USD primitives. Only applies to primitives with a non-animated visibility attribute. Primitives with animated visibility will always be imported"
msgstr "Importera inte osynliga USD-primitiv. Gäller endast primitiv med ett icke-animerat synlighetsattribut. Primitiv med animerad synlighet importeras alltid"


msgid "Light Intensity Scale"
msgstr "Ljusintensitetsskala"


msgid "Scale for the intensity of imported lights"
msgstr "Skala för intensiteten hos importerade ljus"


msgid "Allow USD primitives to merge with their Xform parent if they are the only child in the hierarchy"
msgstr "Tillåt USD-primitiv att slås samman med sin Xform-förälder om de är det enda barnet i hierarkin"


msgid "Import each USD material as a unique Blender material"
msgstr "Importera varje USD-material som ett unikt Blender-material"


msgid "Material Purpose"
msgstr "Materialsyfte"


msgid "Attempt to import materials with the given purpose. If no material with this purpose is bound to the primitive, fall back on loading any other bound material"
msgstr "Försök importera material med angivet syfte. Om inget material med detta syfte är bundet till primitiven läses i stället något annat bundet material in"


msgid "All Purpose"
msgstr "Alla syften"


msgid "Attempt to import 'allPurpose' materials."
msgstr "Försök att importera ”allPurpose”-material."


msgid "Attempt to import 'preview' materials. Load 'allPurpose' materials as a fallback"
msgstr "Försök att importera ”preview”-material. Läs ”allPurpose”-material som reserv"


msgid "Attempt to import 'full' materials. Load 'allPurpose' or 'preview' materials, in that order, as a fallback"
msgstr "Försök att importera ”full”-material. Läs ”allPurpose”- eller ”preview”-material, i den ordningen, som reserv"


msgid "Path Mask"
msgstr "Sökvägmask"


msgid "Import only the primitive at the given path and its descendants. Multiple paths may be specified in a list delimited by commas or semicolons"
msgstr "Importera endast primitivet på den angivna sökvägen och dess underordnade objekt. Flera sökvägar kan anges i en lista avgränsad med kommatecken eller semikolon"


msgid "Behavior when importing USD attributes as Blender custom properties"
msgstr "Beteende vid import av USD-attribut som anpassade egenskaper i Blender"


msgid "Do not import USD custom attributes"
msgstr "Importera inte anpassade USD-attribut"


msgid "Import USD attributes in the 'userProperties' namespace as Blender custom properties. The namespace will be stripped from the property names"
msgstr "Importera USD-attribut i namnområdet \"userProperties\" som anpassade egenskaper i Blender. Namnområdet kommer att tas bort från egenskapsnamnen"


msgid "All Custom"
msgstr "Alla anpassade"


msgid "Import all USD custom attributes as Blender custom properties. Namespaces will be retained in the property names"
msgstr "Importera alla anpassade USD-attribut som anpassade egenskaper i Blender. Namnområden behålls i egenskapsnamnen"


msgid "Mesh Attributes"
msgstr "Nätattribut"


msgid "Read USD Primvars as mesh attributes"
msgstr "Läs USD Primvars som nätattribut"


msgid "Read mesh color attributes"
msgstr "Läs nätets färgattribut"


msgid "Read mesh UV coordinates"
