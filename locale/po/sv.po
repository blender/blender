msgstr "Tillämpa avtagande för att undvika skarpa kanter när ljusgeometrin skär andra objekt"


msgid "Spot Light"
msgstr "Strålkastarljus"


msgid "Directional cone Light"
msgstr "Riktat konformigt ljus"


msgid "The energy this light would emit over its entire area if it wasn't limited by the spot angle, in units of radiant power (W)"
msgstr "Den energi ljuset skulle avge över hela sin yta om den inte begränsades av strålvinkeln, mätt i strålningseffekt (W)"


msgid "Show Cone"
msgstr "Visa kon"


msgid "Display transparent cone in 3D view to visualize which objects are contained in it"
msgstr "Visa en genomskinlig kon i 3D-vyn för att visa vilka objekt den innehåller"


msgid "Spot Blend"
msgstr "Strålkastarblandning"


msgid "The softness of the spotlight edge"
msgstr "Mjukt strålkastarkant"


msgid "Beam Angle"
msgstr "Strålvinkel"


msgid "Angular diameter of the spotlight beam"
msgstr "Strålkastarstrålens vinkeldiameter"


msgid "Cast a square spot light shape"
msgstr "Kasta en fyrkantig strålkastarform"


msgid "Sun Light"
msgstr "Solljus"


msgid "Constant direction parallel ray Light"
msgstr "Parallellstrålande ljus med konstant riktning"


msgid "Angular diameter of the Sun as seen from the Earth"
msgstr "Solens vinkeldiameter sedd från jorden"


msgctxt "Light"
msgid "Strength"
msgstr "Styrka"


msgid "Sunlight strength in watts per meter squared (W/m²)"
msgstr "Solljusets styrka i watt per kvadratmeter (W/m²)"


msgid "Cascade Count"
msgstr "Antal kaskader"


msgid "Number of texture used by the cascaded shadow map"
msgstr "Antal texturer som används av den kaskadbaserade skuggkartan"


msgid "Exponential Distribution"
msgstr "Exponentiell fördelning"


msgid "Higher value increase resolution towards the viewpoint"
msgstr "Högre värde ökar upplösningen mot synpunkten"


msgid "Cascade Fade"
msgstr "Kaskadtoning"


msgid "How smooth is the transition between each cascade"
msgstr "Hur mjuk övergången är mellan varje kaskad"


msgid "Cascade Max Distance"
msgstr "Största kaskadavstånd"


msgid "End distance of the cascaded shadow map (only in perspective view)"
msgstr "Slutavstånd för den kaskadformade skuggkartan (endast i perspektivvy)"


