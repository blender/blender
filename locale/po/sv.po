msgstr "Styr vilken nyckelruta som ska förskjutas och hur långt"


msgctxt "Operator"
msgid "Blend to Default Value"
msgstr "Blanda till standardvärde"


msgid "Blend selected keys to their default value from their current position"
msgstr "Blanda markerade nyckelrutor från deras aktuella position till standardvärdet"


msgid "How much to blend to the default value"
msgstr "Hur mycket ska blandas till standardvärdet"


msgctxt "Operator"
msgid "Blend to Ease Keyframes"
msgstr "Blanda till mjuka nyckelrutor"


msgid "Blends keyframes from current state to an ease-in or ease-out curve"
msgstr "Blandar nyckelrutor från aktuellt tillstånd till en mjukstart- eller mjukslutskurva"


msgid "Favor either original data or ease curve"
msgstr "Föredra antingen originaldata eller mjuk kurva"


msgctxt "Operator"
msgid "Blend to Neighbor"
msgstr "Blanda till granne"


msgid "Blend selected keyframes to their left or right neighbor"
msgstr "Blanda valda nyckelrutor med deras vänstra eller högra granne"


