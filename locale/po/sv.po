msgid "Blendfile Import Context"
msgstr "Importkontext för blend-fil"


msgid "Contextual data for a blendfile library/linked-data related operation. Currently only exposed as read-only data for the pre/post blendimport handlers"
msgstr "Kontextdata för en åtgärd som rör ett blend-filbibliotek eller länkade data. För närvarande endast tillgängliga som skrivskyddade data för hanterare före och efter blend-import."


msgid "Options for this blendfile import operation"
msgstr "Alternativ för denna blend-filimport"


msgid "Only link data, instead of appending it"
msgstr "Länka endast data i stället för att lägga till den"


msgid "Make paths of used library blendfiles relative to current blendfile"
msgstr "Gör sökvägarna till använda biblioteks-blend-filer relativa till aktuell blend-fil"


msgid "Generate a placeholder (empty ID) if not found in any library files"
msgstr "Skapa en platshållare (tomt ID) om den inte finns i någon biblioteksfil"


msgid "Force loaded ID to be tagged as indirectly linked (used in reload context only)"
msgstr "Tvinga inläst ID att märkas som indirekt länkat (används endast vid omladdning)"


msgid "Set fake user on appended IDs"
msgstr "Ange falsk användare för tillagda ID:n"


msgid "Append (make local) also indirect dependencies of appended IDs coming from other libraries. NOTE: All IDs (including indirectly linked ones) coming from the same initial library are always made local"
msgstr "Lägg till (gör lokala) även indirekta beroenden till tillagda ID:n från andra bibliotek. OBS: Alla ID:n (även indirekt länkade) från samma ursprungliga bibliotek görs alltid lokala."


msgid "Try to re-use previously appended matching IDs when appending them again, instead of creating local duplicates"
msgstr "Försök att återanvända tidigare tillagda matchande ID:n när du lägger till dem igen i stället för att skapa lokala dubbletter"


msgid "Clear the asset data on append (it is always kept for linked data)"
msgstr "Rensa resursdata vid tillägg (bevaras alltid för länkade data)"


