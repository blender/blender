msgid "Distance to Guides"
msgstr "Avstånd till styrkurvor"


msgid "Distance around each guide to spawn interpolated curves"
msgstr "Avstånd runt varje styrkurva för att generera interpolerade kurvor"


msgid "Follow Surface Normal"
msgstr "Följ ytnormalen"


msgid "Align the interpolated curves to the surface normal"
msgstr "Riktar in de interpolerade kurvorna efter ytnormalen"


msgid "Index of the main guide curve per curve"
msgstr "Index för huvudkurvan per kurva"


msgid "Interpolation Guides"
msgstr "Interpoleringsstyrkurvor"


msgid "Amount of guides to be used for interpolation per curve"
msgstr "Antal styrkurvor som ska användas för interpolering per kurva"


msgid "Part by Mesh Islands"
msgstr "Dela vid nätöar"


msgid "Use mesh islands of the surface geometry for parting"
msgstr "Använd nätöar i ytgeometrin för delning"


msgid "Redistribute Curve Points"
msgstr "Omfördela kurvpunkter"


msgid "Redistributes existing control points evenly along each curve"
msgstr "Omfördelar befintliga kontrollpunkter jämnt längs varje kurva"


msgid "Feature Awareness"
msgstr "Funktionskänslighet"


msgid "Use simple feature awareness to keep feature definition"
msgstr "Använder enkel funktionskänslighet för att behålla funktionsdefinitionen"


msgid "Restore Curve Segment Length"
msgstr "Återställ kurvsegmentets längd"


msgid "Restores the length of each curve segment using a previous state after deformation"
msgstr "Återställer längden på varje kurvsegment med hjälp av ett tidigare tillstånd efter deformation"


msgid "Pin at Parameter"
msgstr "Fäst vid parameter"


msgid "Pin each curve at a certain point for the operation"
msgstr "Fäster varje kurva vid en viss punkt för åtgärden"


msgid "Reference Position"
msgstr "Referensposition"


msgid "Reference position before deformation"
msgstr "Referensposition före deformation"


msgid "Only affect selected elements"
msgstr "Påverkar endast valda element"


msgid "Roll Hair Curves"
msgstr "Rulla hårkurvor"


msgid "Rolls up hair curves starting from their tips"
msgstr "Rullar upp hårkurvor från spetsarna"


msgid "Factor to blend the overall effect"
msgstr "Faktor för att blanda den totala effekten"


msgid "Amount of randomization of the direction of the roll"
msgstr "Slumpningens grad för rullningens riktning"


msgid "Retain Overall Shape"
msgstr "Behåll den övergripande formen"


msgid "Offset the roll along the original curve to retain shape"
msgstr "Förskjuter rullningen längs den ursprungliga kurvan för att behålla formen"


msgid "Roll Depth"
msgstr "Rullens djup"


msgid "Depth offset of the roll"
msgstr "Rullens djupförskjutning"


msgid "Roll Direction"
msgstr "Rullningsriktning"


msgid "Axis around which each curve is rolled"
msgstr "Axel runt vilken varje kurva rullas"


msgid "Roll Length"
msgstr "Rullängd"


msgid "Length of each curve to be rolled"
msgstr "Längd på varje kurva som ska rullas"


msgid "Roll Radius"
msgstr "Rullradie"


msgid "Radius of the rolls"
msgstr "Rullarnas radie"


msgid "Roll Taper"
msgstr "Rullavsmalning"


msgid "Taper of the roll"
msgstr "Rullens avsmalning"


msgid "Variation Level"
msgstr "Variationsnivå"


msgid "Level of smoothing on the roll path to include shape variation"
msgstr "Utjämningsnivå på rullbanan för att inkludera formvariationer"


msgid "Rotate Hair Curves"
msgstr "Rotera hårkurvor"


msgid "Rotates each hair curve around an axis"
msgstr "Roterar varje hårkurva kring en axel"


msgid "Rotation axis (default: tangent at root)"
msgstr "Rotationsaxel (standard: tangent vid roten)"


msgid "Factor to influence the rotation angle"
msgstr "Faktor som påverkar rotationsvinkeln"


msgid "Lock Ends"
msgstr "Lås ändar"


msgid "Lock rotation to the axis between the curve ends"
msgstr "Lås rotationen till axeln mellan kurvans ändpunkter"


msgid "Random offset to the rotation angle per curve"
msgstr "Slumpmässig förskjutning av rotationsvinkeln per kurva"


msgid "Sets the radius attribute of hair curves according to a profile shape"
msgstr "Ställer in radieattributet för hårkurvor enligt en profilform"


msgid "Factor of the radius at the maximum"
msgstr "Faktor för radien vid maximalt värde"


msgid "Factor of the radius at the minimum"
msgstr "Faktor för radien vid minimum"


msgid "Base radius to be set if 'Replace Radius' is enabled"
msgstr "Basradie som ska ställas in om ”Ersätt radie” är aktiverat"


msgid "Replace Radius"
msgstr "Ersätt radie"


msgid "Replace the original radius"
msgstr "Ersätt den ursprungliga radien"


msgid "Shape of the radius along the curve"
msgstr "Radieform längs kurvan"


msgid "Shrinkwrap Hair Curves"
msgstr "Krympanpassa hårkurvor"


msgid "Shrinkwraps hair curves to a mesh surface from below and optionally from above"
msgstr "Krympanpassar hårkurvor till en nätyta underifrån och valfritt ovanifrån"


msgid "Blend shrinkwrap for points above the surface"
msgstr "Blanda krympanpassning för punkter ovanför ytan"


msgid "Lock Roots"
msgstr "Låsrötter"


msgid "Lock the position of root points"
msgstr "Lås rotpunkternas position"


msgid "Distance from the surface used for shrinkwrap"
msgstr "Avstånd från ytan som används för krympanpassning"


msgid "Smoothing Steps"
msgstr "Utjämningssteg"


msgid "Amount of steps of smoothing applied after shrinkwrap"
msgstr "Antal utjämningssteg som tillämpas efter krympanpassning"


msgid "Surface geometry used for shrinkwrap"
msgstr "Ytgeometri som används för krympanpassning"


msgid "Surface object used for shrinkwrap"
msgstr "Ytobjekt som används för krympanpassning"


msgid "Smooth Hair Curves"
msgstr "Jämna ut hårkurvor"


msgid "Smoothes the shape of hair curves"
msgstr "Jämnar ut formen på hårkurvor"


msgid "Amount of smoothing"
msgstr "Mängd utjämning"


msgid "Amount of smoothing steps"
msgstr "Antal utjämningssteg"


msgid "Lock Tips"
msgstr "Lås spetsar"


msgid "Lock tip position when smoothing"
msgstr "Lås spetsens position vid utjämning"


msgid "Weight used for smoothing"
msgstr "Vikt som används för utjämning"


msgid "Straighten Hair Curves"
msgstr "Räta ut hårkurvor"


msgid "Straightens hair curves between root and tip"
msgstr "Rätar ut hårkurvor mellan rot och spets"


msgid "Amount of straightening"
msgstr "Rätningsgrad"


msgid "Trim Hair Curves"
msgstr "Trimma hårkurvor"


msgid "Trims or scales hair curves to a certain length"
msgstr "Trimmar eller skalar hårkurvor till en viss längd"


msgid "Target length for the operation"
msgstr "Mållängd för åtgärden"


msgid "Multiply the original length by a factor"
msgstr "Multiplicerar den ursprungliga längden med en faktor"


msgid "Mask to blend overall effect"
msgstr "Mask för att blanda den samlade effekten"


msgid "Trim hair curves randomly up to a certain amount"
msgstr "Trimmar hårkurvor slumpmässigt med upp till en viss mängd"


msgid "Replace Length"
msgstr "Ersätt längd"


msgid "Use the length input to fully replace the original length"
msgstr "Använder längdindatan för att helt ersätta den ursprungliga längden"


msgid "Scale each curve uniformly to reach the target length"
msgstr "Skalar varje kurva enhetligt för att nå mållängden"


msgid "Distance from the ground plane"
msgstr "Avstånd från markplanet"

