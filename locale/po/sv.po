msgstr "Flytta det aktiva anteckningslagret uppåt/nedåt i listan"


msgctxt "Operator"
msgid "Remove Annotation Layer"
msgstr "Ta bort anteckningslager"


msgid "Remove active Annotation layer"
msgstr "Ta bort aktivt anteckningslager"


msgctxt "Operator"
msgid "Blend Offset Keyframes"
msgstr "Blanda offset-nyckelrutor"


