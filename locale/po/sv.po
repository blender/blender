msgstr "Lägg till F-modifierare i de aktiva/markerade F-kurvorna"


msgid "Only Active"
msgstr "Endast aktiv"


msgid "Only add F-Modifier to active F-Curve"
msgstr "Lägg endast till F-modifierare i den aktiva F-kurvan"


msgctxt "Operator"
msgid "Copy F-Modifiers"
msgstr "Kopiera F-modifierare"


msgid "Copy the F-Modifier(s) of the active F-Curve"
msgstr "Kopiera F-modifieraren/F-modifierarna för den aktiva F-kurvan"


msgctxt "Operator"
msgid "Delete F-Curve Modifiers"
msgstr "Ta bort F-kurvmodifierare"


msgid "Remove Modifier(s) from the selected F-Curves"
msgstr "Ta bort modifierare från de markerade F-kurvorna"


msgid "Decide what the operator will remove"
msgstr "Ange vad operatorn ska ta bort"


