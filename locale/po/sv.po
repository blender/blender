msgid "End Points"
msgstr "Slutpunkter"


msgid "Specify the line's start and end points"
msgstr "Ange linjens start- och slutpunkter"


msgid "Mesh to Curve"
msgstr "Nät till kurva"


msgid "Generate a curve from a mesh"
msgstr "Skapa en kurva från ett nät"


msgid "Convert mesh edges to curve segments. Attributes are propagated to curve points."
msgstr "Konvertera nätkanter till kurvsegment. Attribut överförs till kurvpunkter."


msgid "Convert each mesh face to a cyclic curve. Face attributes are propagated to curves."
msgstr "Konvertera varje nätyta till en cyklisk kurva. Ytattribut överförs till kurvor."


msgid "Mesh to Density Grid"
msgstr "Nät till densitetsrutnät"


msgid "Create a filled volume grid from a mesh"
msgstr "Skapa ett fyllt volymrutnät från ett nät"


msgid "Mesh to Points"
msgstr "Nät till punkter"


msgid "Generate a point cloud from a mesh's vertices"
msgstr "Generera ett punktmoln från ett näts vertexer"


msgid "Create a point in the point cloud for each selected vertex"
msgstr "Skapa en punkt i punktmolnet för varje vald vertex"


msgid "Create a point in the point cloud for each selected edge"
msgstr "Skapa en punkt i punktmolnet för varje vald kant"


msgid "Create a point in the point cloud for each selected face"
msgstr "Skapa en punkt i punktmolnet för varje vald yta"


msgid "Create a point in the point cloud for each selected face corner"
msgstr "Skapa en punkt i punktmolnet för varje valt ythörn"


