msgstr "Använd målets position och, valfritt, rotation för att definiera en vägg eller ett golv som ägaren inte kan passera"


msgid "Follow Path"
msgstr "Följ bana"


msgid "Use to animate an object/bone following a path"
msgstr "Används för att animera ett objekt eller ben som följer en bana"


msgid "Geometry Attribute"
msgstr "Geometriattribut"


