msgstr "Utgångsvägar"


msgid "The File Output node is only supported for scene compositing"
msgstr "File Output-noden stöds endast för scenkompositering"


msgid "Invalid path template in File Output node. Skipping writing file."
msgstr "Ogiltig sökvägsmall i File Output-noden. Filen skrivs inte."


