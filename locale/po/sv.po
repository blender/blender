msgid "Tonal Range"
msgstr "Tonintervall"


msgid "If the difference in hue between the color and key color is less than this threshold, it is keyed"
msgstr "Om skillnaden i färgton mellan färgen och nyckelfärgen är mindre än tröskelvärdet nycklas den"


msgid "If the difference in saturation between the color and key color is less than this threshold, it is keyed"
msgstr "Om skillnaden i mättnad mellan färgen och nyckelfärgen är mindre än tröskelvärdet nycklas den"


msgid "If the difference in value between the color and key color is less than this threshold, it is keyed"
msgstr "Om skillnaden i värde mellan färgen och nyckelfärgen är mindre än tröskelvärdet nycklas den"


msgid "Limit by a single channel"
msgstr "Begränsa till en enda kanal"


