msgid "The transformation of the target bone is evaluated relative to its local coordinate system, followed by a correction for the difference in target and owner rest pose orientations. When applied as local transform to the owner produces the same global motion as the target if the parents are still in rest pose."
msgstr "Målbenets transformering utvärderas i förhållande till dess lokala koordinatsystem och korrigeras sedan för skillnaden mellan målets och ägarens orienteringar i viloposition. Tillämpad som lokal transformering på ägaren ger den samma globala rörelse som målet, om de överordnade benen fortfarande är i viloposition."


msgid "Camera Solver"
msgstr "Kameralösare"


msgid "Follow Track"
msgstr "Följ spår"


msgid "Object Solver"
msgstr "Objektlösare"


msgid "Copy Location"
msgstr "Kopiera position"


msgid "Copy the location of a target (with an optional offset), so that they move together"
msgstr "Kopiera ett måls position, med valfri förskjutning, så att de flyttas tillsammans"


msgid "Copy Rotation"
msgstr "Kopiera rotation"


msgid "Copy the rotation of a target (with an optional offset), so that they rotate together"
msgstr "Kopiera ett måls rotation, med valfri förskjutning, så att de roterar tillsammans"


msgid "Copy Scale"
msgstr "Kopiera skala"


msgid "Copy the scale factors of a target (with an optional offset), so that they are scaled by the same amount"
msgstr "Kopiera ett måls skalfaktorer, med valfri förskjutning, så att de skalas lika mycket"


msgid "Copy Transforms"
msgstr "Kopiera transformationer"


msgid "Copy all the transformations of a target, so that they move together"
msgstr "Kopiera ett måls alla transformeringar så att de flyttas tillsammans"


msgid "Limit Distance"
msgstr "Begränsa avståndet"


msgid "Restrict movements to within a certain distance of a target (at the time of constraint evaluation only)"
msgstr "Begränsa rörelser till ett givet avstånd från ett mål (endast när begränsningen utvärderas)"


msgid "Limit Location"
msgstr "Begränsa position"


msgid "Restrict movement along each axis within given ranges"
msgstr "Begränsa rörelsen längs varje axel inom givna intervall"


msgid "Limit Rotation"
msgstr "Begränsa rotation"


msgid "Restrict rotation along each axis within given ranges"
msgstr "Begränsa rotation längs varje axel inom angivna intervall"


msgid "Limit Scale"
msgstr "Begränsa skala"


msgid "Restrict scaling along each axis with given ranges"
msgstr "Begränsa skalning längs varje axel till angivna intervall"


msgid "Maintain Volume"
msgstr "Behåll volymen"


msgid "Compensate for scaling one axis by applying suitable scaling to the other two axes"
msgstr "Kompensera för skalning av en axel genom att tillämpa lämplig skalning på de andra två axlarna"


msgid "Transformation"
msgstr "Transformering"


msgid "Use one transform property from target to control another (or same) property on owner"
msgstr "Använd en transformeringsegenskap hos målet för att styra en annan, eller samma, egenskap hos ägaren"


msgid "Transform Cache"
msgstr "Transformcache"


msgid "Look up the transformation matrix from an external file"
msgstr "Hämta transformeringsmatrisen från en extern fil"


msgid "Clamp To"
msgstr "Fäst vid"


msgid "Restrict movements to lie along a curve by remapping location along curve's longest axis"
msgstr "Begränsa rörelser till en kurva genom att mappa om positionen längs kurvans längsta axel"


msgid "Damped Track"
msgstr "Dämpad spårning"


msgid "Point towards a target by performing the smallest rotation necessary"
msgstr "Peka mot ett mål med minsta möjliga rotation"


msgid "Inverse Kinematics"
msgstr "Invers kinematik"


msgid "Control a chain of bones by specifying the endpoint target (Bones only)"
msgstr "Styr en kedja av ben genom att ange slutmålet (endast ben)"


msgid "Locked Track"
msgstr "Låst spårning"


msgid "Rotate around the specified ('locked') axis to point towards a target"
msgstr "Rotera runt den angivna ('låsta') axeln för att peka mot ett mål"


msgid "Spline IK"
msgstr "Spline IK"


msgid "Align chain of bones along a curve (Bones only)"
msgstr "Rikta in en benkedja längs en kurva (endast ben)"


msgid "Stretch To"
msgstr "Sträck mot"


