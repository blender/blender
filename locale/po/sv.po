msgid "Hair"
msgstr "Hår"


msgid "Hair strands"
msgstr "Hårstrån"


msgctxt "Material"
msgid "Shader Ball"
msgstr "Shaderkula"


msgid "Shader ball"
msgstr "Shaderkula"


msgctxt "Material"
msgid "Cloth"
msgstr "Tyg"


msgid "Cloth"
msgstr "Tyg"


msgctxt "Material"
msgid "Fluid"
msgstr "Vätska"


msgid "Refraction Depth"
msgstr "Refraktionsdjup"


msgid "Approximate the thickness of the object to compute two refraction events (0 is disabled) (Deprecated)"
msgstr "Uppskatta objektets tjocklek för att beräkna två refraktionshändelser (0 inaktiverar funktionen) (föråldrat)"


msgid "Roughness of the material"
msgstr "Materialets grovhet"


msgid "Show Backface"
msgstr "Visa baksidor"


msgid "Render multiple transparent layers (may introduce transparency sorting problems) (Deprecated: use 'use_tranparency_overlap')"
msgstr "Rendera flera transparenta lager (kan orsaka problem vid sortering av transparens) (föråldrat: använd ”use_tranparency_overlap”)"


msgid "Specular Color"
msgstr "Spekulär färg"


msgid "Specular color of the material"
msgstr "Materialets spekulära färg"


msgid "Specular"
msgstr "Spekulär"


msgid "How intense (bright) the specular reflection is"
msgstr "Hur intensiv (ljusstark) den spekulära reflektionen är"


msgid "Surface Render Method"
msgstr "Renderingsmetod för yta"


msgid "Controls the blending and the compatibility with certain features"
msgstr "Styr blandningen och kompatibiliteten med vissa funktioner"


msgid "Dithered"
msgstr "Dithrad"


msgid "Allows for grayscale hashed transparency, and compatible with render passes and raytracing. Also known as deferred rendering."
msgstr "Tillåter hashad gråskaletransparens och är kompatibel med renderingspass och strålspårning. Kallas även uppskjuten rendering."


msgid "Blended"
msgstr "Blandad"


msgid "Allows for colored transparency, but incompatible with render passes and raytracing. Also known as forward rendering."
msgstr "Tillåter färgad transparens men är inte kompatibel med renderingspass och strålspårning. Kallas även framåtrendering."


msgid "Texture Slot Images"
msgstr "Texturplatsbilder"


msgid "Texture images used for texture painting"
msgstr "Texturbilder som används för texturmålning"


msgid "Texture Slots"
msgstr "Texturplatser"


msgid "Thickness Mode"
msgstr "Tjockleksläge"


msgid "Approximation used to model the light interactions inside the object"
msgstr "Approximation som används för att modellera ljusinteraktioner inuti objektet"


msgid "Approximate the object as a sphere whose diameter is equal to the thickness defined by the node tree"
msgstr "Approximerar objektet som en sfär med en diameter som motsvarar tjockleken som nodträdet definierar"


msgid "Slab"
msgstr "Platta"


msgid "Approximate the object as an infinite slab of thickness defined by the node tree"
msgstr "Approximerar objektet som en oändlig platta med tjockleken som nodträdet definierar"


msgid "Backface Culling"
msgstr "Borttagning av baksidor"


msgid "Use back face culling to hide the back side of faces"
msgstr "Använd borttagning av baksidor för att dölja baksidan av ytor"


msgid "Light Probe Volume Backface Culling"
msgstr "Borttagning av baksidor för ljussondsvolym"


msgid "Consider material single sided for light probe volume capture. Additionally helps rejecting probes inside the object to avoid light leaks."
msgstr "Betrakta materialet som enkelsidigt vid infångning av ljussondsvolym. Hjälper även till att avvisa sonder inuti objektet för att undvika ljusläckage."


msgid "Shadow Backface Culling"
msgstr "Borttagning av baksidor för skuggor"


msgid "Use back face culling when casting shadows"
msgstr "Använd borttagning av baksidor vid skuggkastning"


msgid "Use shader nodes to render the material"
msgstr "Använd shader-noder för att rendera materialet"


msgid "Preview World"
msgstr "Förhandsgranska omgivning"


msgid "Use the current world background to light the preview render"
msgstr "Använd den aktuella omgivningsbakgrunden för att belysa förhandsgranskningen"


msgid "Raytrace Transmission"
msgstr "Strålspårad transmission"


msgid "Use raytracing to determine transmitted color instead of using only light probes. This prevents the surface from contributing to the lighting of surfaces not using this setting."
msgstr "Använd strålspårning för att avgöra överförd färg i stället för enbart ljussonder. Detta förhindrar att ytan bidrar till belysningen av ytor som inte använder inställningen."


msgid "Use raytracing to determine transmitted color instead of using only light probes. This prevents the surface from contributing to the lighting of surfaces not using this setting. Deprecated: use 'use_raytrace_refraction'."
msgstr "Använd strålspårning för att avgöra överförd färg i stället för enbart ljussonder. Detta förhindrar att ytan bidrar till belysningen av ytor som inte använder inställningen. Föråldrat: använd ”use_raytrace_refraction”."


msgid "Subsurface Translucency"
msgstr "Translucens under ytan"


msgid "Add translucency effect to subsurface (Deprecated)"
msgstr "Lägg till translucenseffekt under ytan (föråldrat)"


msgid "Thickness From Shadow"
msgstr "Tjocklek från skugga"


msgid "Use the shadow maps from shadow casting lights to refine the thickness defined by the material node tree"
msgstr "Använd skuggkartor från skuggkastande ljus för att förfina den tjocklek som materialets nodträd definierar"


msgid "Use Transparency Overlap"
msgstr "Använd transparensöverlappning"


msgid "Render multiple transparent layers (may introduce transparency sorting problems)"
msgstr "Rendera flera transparenta lager (kan orsaka problem vid sortering av transparens)"


msgid "Transparent Shadows"
msgstr "Transparenta skuggor"


msgid "Use transparent shadows for this material if it contains a Transparent BSDF, disabling will render faster but not give accurate shadows"
