msgstr "Δεδομένα κινησιοδότησης για μπλοκ δεδομένων"


msgid "Action"
msgstr "Ενέργεια"


msgid "Active Action for this data-block"
msgstr "Ενεργή Ενέργεια για αυτό το μπλοκ δεδομένων"


msgid "Method used for combining Active Action's result with result of NLA stack"
msgstr "Η μέθοδος η οποία χρησιμοποιείται για το συνδιασμό του αποτελέσματος της Ενεργής Ενέργειας με το αποτελέσματα της στοίβας NLA"


msgid "Replace"
msgstr "Αντικατάσταση"


msgid "Combine"
msgstr "Συνδυασμός"


msgid "Add"
msgstr "Πρόσθεση"


msgid "Subtract"
msgstr "Αφαίρεση"


msgid "Multiply"
msgstr "Πολλαπλασιασμός"


msgid "Nothing"
msgstr "Τίποτα"


msgid "Strip has no influence past its extents"
msgstr "Η λωρίδα δεν έχει επιρροή πέρα από τα όριά της"


msgid "Hold"
msgstr "Κράτα"


msgid "Hold the first frame if no previous strips in track, and always hold last frame"
msgstr "Κράτησε το πρώτο καρέ εάν δεν υπάρχουν προηγούμενες λωρίδες στην τροχιά, και πάντα κράτησε το τελευταίο καρέ"


msgid "Only hold last frame"
msgstr "Κράτησε μόνο το τελευταίο καρέ"


msgid "Action Influence"
msgstr "Επιρροή Ενέργειας"


msgid "Amount the Active Action contributes to the result of the NLA stack"
msgstr "Το πόσο συνεισφέρει η Ενεργή Ενέργεια στο αποτέλεσμα της στοίβας NLA"


msgid "Action Slot"
msgstr "Θέση Ενεργειών"


msgid "Slots"
msgstr "Θέσεις"


msgid "The list of slots in this animation data-block"
msgstr "Η λίστα θέσεων για αυτό το μπλοκ δεδομένων σε αυτήν την κινησιοδότηση"


msgid "Drivers"
msgstr "Οδηγοί"


msgid "NLA Tracks"
msgstr "NLA Tracks"


msgid "NLA Tracks (i.e. Animation Layers)"
msgstr "NLA Tracks (δηλ. Επίπεδα Κινησιοδότησης)"


msgid "NLA Evaluation Enabled"
msgstr "Αξιολόγηση NLA Ενεργή"


msgid "NLA stack is evaluated when evaluating this block"
msgstr "Η NLA stack αξιολογείται όταν αξιολογείται αυτό το μπλοκ"


msgid "Collection of Driver F-Curves"
msgstr "Συλλογή Καμπυλών F Οδηγών"


msgid "Animation Visualization"
msgstr "Απεικόνιση Κινησιοδότησης"


msgid "Settings for the visualization of motion"
msgstr "Ρυθμίσεις για την απεικόνιση της κίνησης"


msgid "Motion Paths"
msgstr "Διαδρομές Κίνησης"


msgid "Motion Path settings for visualization"
msgstr "Ρυθμίσεις Διαδρομών Κίνησης για απεικόνιση"


msgid "Motion Path Settings"
msgstr "Ρυθμίσεις Διαδρομών Κίνησης"


msgid "Motion Path settings for animation visualization"
msgstr "Ρυθμίσεις Διαδρομή Κίνησης για την απεικόνιση κινησιοδοτήσεων"


msgid "Heads"
msgstr "Κεφάλια"


