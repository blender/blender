msgstr "Υπολογισμός διαδρομών οστών από τα κεφάλια"


msgid "Tails"
msgstr "Ουρές"


msgid "Calculate bone paths from tails"
msgstr "Υπολογισμός διαδρομών οστών από τις ουρές"


msgid "After Current"
msgstr "Μετά το τρέχον"


msgid "Number of frames to show after the current frame (only for 'Around Frame' Onion-skinning method)"
msgstr "Ο αριθμός των καρέ που θα εμφανιστούν μετά το τρέχον καρέ (Μόνο για τη μέθοδο Onion-skinning 'Γύρω από το καρέ')"


msgid "Before Current"
msgstr "Πριν το τρέχον"


msgid "Number of frames to show before the current frame (only for 'Around Frame' Onion-skinning method)"
msgstr "Ο αριθμός των καρέ που θα εμφανιστούν πριν το τρέχον καρέ (Μόνο για τη μέθοδο Onion-skinning 'Γύρω από το καρέ')"


msgid "End Frame"
msgstr "Τελευταίο Καρέ"


msgid "End frame of range of paths to display/calculate (not for 'Around Frame' Onion-skinning method)"
