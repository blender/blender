msgstr "ძალიან კაშკაშა მარცვლოვანება შემცირებული სიმკვეთრითა და კონტრასტით."


msgid "Cinematic Gritty"
msgstr "კინემატროგრაფიული კონტრასტული"


msgid "Cinematic Soft"
msgstr "კინემატოგრაფიული რბილი"


msgid "User-defined settings. Be careful."
msgstr "მომხმარებლის მიერ განსაზღვრული ანაწყობები. ფრთხილად იყავი."


msgid "Custom Style"
msgstr "მორგებული სტილი"


msgid "Home Movie"
msgstr "სახლის კინოთეატრი"


msgid "Pro Photography"
msgstr "პროფესიონალური ფოტოგრაფია"


msgid "Studio Broadcast"
msgstr "სტუდიური მაუწყებლობა"


msgid "Super 35 mm"
msgstr "სუპერ 35 მმ"


msgid "Balanced grain typical of modern films (2K)"
msgstr "თანამედროვე ფირებისთვის (2K) დამახასიათებელი დაბალანსებული მარცვლოვნება"


msgid "Super 8 mm"
msgstr "სუპერ 8 მმ"


msgid "Large, dancing grain with strong structure"
msgstr "დიდი, ცვალებადი მარცვლოვანება მკაფიო სტრუქტურით"


msgid "Xpro Sharp"
msgstr "Xpro მკვეთრი"


msgid "Xpro or cross-processing is the deliberate processing of the film in chemical solution intended for a different type of film"
msgstr "Xpro, ან ქროსპროცესირება წარმოადგენს ფირის განგებ დამუშავებას სხვა ტიპის ფირისთვის განკუთვნილ ქიმიურ ხსნარში"


msgid "Project with Depth"
msgstr "პროეცირება სიღრმით"


msgid "Transforms 2D coordinates with their corresponding depth into a 3D vector "
msgstr "2D კოორდინატებსა და მათ შესაბამის სიღრმეს 3D ვექტორად აქცევს "


msgid "Retime"
msgstr "დროის შეცვლა"


msgid "Adjusts timing by offsetting, scaling, looping, and snapping the scene frame"
msgstr "სცენის კადრის აცდენით, მასშტაბირებით, გაციკლურებითა და მიკვრით არეგულირებს დროს"


msgid "Cycle Length"
msgstr "ციკლის ხანგრძლივობა"


msgid "Number of frames to cycle through. Not affected by Speed."
msgstr "კადრების რაოდენობა, რომლებიც ციკლურად უნდა დატრიალდეს. სისწრაფეს გავლენა არ აქვს."


msgid "Restart from start frame when Cycle Length is reached"
msgstr "როცა ციკლი დასრულდება, საწყისი კადრიდან დაიწყე გამეორება"


msgid "Offset to add to the current scene frame. Can also be negative."
msgstr "სცენის მიმდინარე კადრზე დასამატებელი აცდენა. შეიძლება, უარყოფითიც იყოს."


msgid "Multiply the current scene frame by this factor"
msgstr "გაამრავლე სცენის მიმდინარე კადრი ამ მამრავლზე"


msgid "Snap scene frame to increments"
msgstr "მიაკარი სცენის კადრი ნაზრდებს"


msgid "Screen to 3D Space"
msgstr "ეკრანის სივრციდან 3D-ში"


msgid "Convert coordinates from screen to 3D space"
msgstr "გადაიყვანე კოორდინატები ეკრანის სივრციდან 3D სივრცეში"


msgid "Depth from camera in scene units. Same as depth pass"
msgstr "სიღრმე კამერიდან, სცენის ერთეულებში. იგივეა, რაც სიღრმის გადავლა"


msgid "2D screen space coordinates in the [0, 1] range"
msgstr "2D ეკრანის სივრცის კოორდინატები [0, 1] დიაპაზონში"


msgid "Projected 3D vector in 3D space"
msgstr "პროეცირებული 3D ვექტორი 3D სივრცეში"


msgid "Sensor Noise"
msgstr "სენსორის ხმაური"


msgid "Simulates the random pixel noise produced by a camera sensor."
msgstr "ახდენს კამერის სენსორის მიერ წარმოშობილი შემთხვევითი პიქსელური ხმაურის სიმულაციას."


msgid "Change noise on every frame"
msgstr "შეცვალე ხმაური ყოველ კადრზე"


msgid "Chroma Noise"
msgstr "ქრომატული ხმაური"


msgid "The amount of color noise"
msgstr "ფერის ხმაურის ოდენობა"


msgid "Luminance Noise"
msgstr "სიკაშკაშის ხმაური"


msgid "The amount of value-based noise"
msgstr "მნიშვნელობაზე დაფუძნებული ხმაურის ოდენობა"


msgid "Separate Cylindrical"
msgstr "ცილინდრული განცალკევება"


msgid "Decompose a vector into its cylindrical components."
msgstr "დაშალე ვექტორი თავის ცილინდრულ კომპონენტებად."


msgid "Separate Spherical"
msgstr "სფერული განცალკევება"


msgid "Decompose a vector into its spherical components."
msgstr "დაშალე ვექტორი თავის სფერულ კომპონენტებად."


msgid "Applies a brown tint to mimic vintage photo tones."
msgstr "ვინტაჟური ფოტოს ტონების იმიტაციისთვის ადებს მოწაბლისფრო ელფერს."


msgid "Split Toning"
msgstr "ტონირების გაყოფა"


msgid "Tints highlights and shadows with separate colors."
msgstr "შუქციმებსა და ჩრდილებს ცალცალკე ანიჭებს სხვადასხვა ელფერს."


msgid "How dominant highlights are compared to shadows"
msgstr "როგორ ხდება დომინანტი შუქციმების შედარება ჩრდილებთან"


msgid "Factor Highlights"
msgstr "შუქციმების კოეფიციენტი"


msgid "Factor Shadows"
msgstr "ჩრდილების კოეფიციენტი"


msgid "Controls transition between highlights and shadows"
msgstr "აკონტროლებს შუქციმებსა და ჩრდილებს შორის გარდასვლას"


msgid "Transform and Project"
msgstr "გარდაქმნა და პროეცირება"


msgid "Computes a normalized 2D vector and its corresponding depths from a 3D vector and a given projection"
msgstr "გამოითვლის ნორმალიზებულ 2D ვექტორსა და მის შესაბამის სიღრმეებს 3D ვექტორიდან და მოცემული პროეცირებიდან"


msgid "Tune Image"
msgstr "გამოსახულების დამუშავება"


msgid "Enhances contrast, color, clarity, and sharpness."
msgstr "აუმჯობესებს კონტრასტს, ფერს, სიცხადესა და სიმკვეთრეს."


msgid "Clarity"
msgstr "სიცხადე"


msgid "Low frequency contrast using an unsharp mask"
msgstr "დაბალი სიხშირის კონტრასტი, რომელიც არამკვეთრ ნიღაბს იყენებს"


msgid "Color Boost"
msgstr "ფერის გაძლიერება"


msgid "Saturate the image"
msgstr "დაამატე გამოსახულებას სიხასხასე"


msgid "Add more contrast relative to brightness"
msgstr "დაამატე მეტი კონტრასტი სიკაშკაშესთან მიმართებაში"


msgid "Higher frequency contrast using an unsharp mask"
msgstr "უფრო მაღალი სიხშირის კონტრასტი, რომელიც არამკვეთრ ნიღაბს იყენებს"


msgid "Preserve Colors"
msgstr "ფერების შენარჩუნება"


msgid "Avoid color clipping by working in logarithmic space"
msgstr "ერიდე ფერის მოკვეცას ლოგარითმულ სივრცეში მუშაობით"


msgid "The amount of diamond sharpening"
msgstr "ალმასისებური გამკვეთრების ოდენობა"


msgid "Unsharp Mask"
msgstr "ნიღბის სიმკვეთრის კლება"


msgid "Sharpen an image by increasing contrast along edges."
msgstr "გაამკვეთრე გამოსახულება კიდეების გასწვრივ კონტრასტის გაზრდით."


msgid "The amount of sharpening"
msgstr "გამკვეთრების ოდენობა"


msgid "The pixel radius of the sharpening mask"
msgstr "გამამკვეთრებელი ნიღბის პიქსელური რადიუსი"


msgid "Edge threshold"
msgstr "კიდის მიჯნა"


msgid "Darkens edges."
msgstr "ამუქებს კიდეებს."


msgid "Rotation of the area to be darkened"
msgstr "ჩასამუქებელი არის ბრუნვა"


msgid "Corner Roundness"
msgstr "კუთხის სიმრგვალე"


msgid "Circularity of the effect"
msgstr "ეფექტის წრიულობა"


msgid "Smoothness of the transition between dark and bright regions"
msgstr "მუქ და ნათელ მონაკვეთებს შორის გარდასვლის სითანაბრე"


msgid "The region where the image will be darkened"
msgstr "მონაკვეთი, სადაც გამოსახულება ჩამუქდება"


msgid "Relative translation of area to be darkened"
msgstr "ჩასამუქებელი არეალის ფარდობითი გადაადგილება"


msgid "Relative size of area to be darkened"
msgstr "ჩასამუქებელი არეალის ფარდობითი ზომა"


msgid "Cloth Dynamics (Experimental)"
msgstr "ქსოვილის დინამიკა (ექსპერიმენტალური)"


msgid "Bendiness"
msgstr "ღუნვადობა"


msgid "Higher values increase how much the cloth bends."
msgstr "მაღალი მნიშვნელობები ზრდის ქსოვილის მოხრის უნარს."


msgid "Cloth Tags"
msgstr "ქსოვილის ტეგები"


msgid "Comma-separated list of tags which can be used to apply only a subset of effectors to this cloth."
msgstr "მძიმით დაყოფილი სია ტეგებისა, რომელთა მეშვეობითაც შეგიძლია, ამ ქსოვილზე მხოლოდ ეფექტორთა ქვეწყება გამოიყენო."


msgid "Collision Radius"
msgstr "შეჯახების რადიუსი"


msgid "Collision radius for each vertex."
msgstr "შეჯახების რადიუსი თითოეული წვეროსთვის."


msgid "Constraint Steps"
msgstr "ბორკილის საფეხურები"


msgid "Number of steps done to solve constraints in each substep."
msgstr "რამდენ საფეხურად უნდა მოხდეს ბორკილების ამოხსნა თითოეულ ქვესაფეხურში."


msgid "Damping settings for increased simulation stability."
msgstr "დემპფირების ანაწყობები სიმულაციის მეტი სტაბილურობისთვის."


msgid "Effectors"
msgstr "ეფექტორები"


msgid "Additional effectors for the simulation."
msgstr "დამატებითი ეფექტორები სიმულაციისთვის."


msgid "Optional additional simulation effectors."
msgstr "სიმულაციის ნებაყოფლობითი დამატებითი ეფექტორები."


msgid "Effectors Collection"
msgstr "ეფექტორების კოლექცია"


msgid "A collection containing effectors for the simulation. This includes e.g. forces, colliders and custom effectors."
msgstr "კოლექცია, რომელიც სიმულაციისთვის ეფექტორებს შეიცავს. ამაში შედის მაგ., ძალები, კოლაიდერები და მორგებული ეფექტორები."


msgid "Extra Sim Attributes"
msgstr "სიმულაციის დამატებით ატრიბუტები"


msgid "Comma-separated list of custom attributes which should be persisted between simulation steps."
msgstr "მძიმით დაყოფილი სია მორგებული ატრიბუტებისა, რომლებიც სიმულაციის საფეხურებს შორის უნდა უცვლელად დარჩეს."


msgid "Friction coefficient for each vertex."
msgstr "ხახუნის კოეფიციენტი თითოეული წვეროსთვის."


msgid "Add gravity to the simulation."
msgstr "დაამატე სიმულაციას მიზიდულობა."


msgid "Direction and strength of the gravity."
msgstr "მიზიდულობის მიმართულება და სიძლიერე."


msgid "Optional gravity force."
msgstr "ნებაყოფლობითი მიზიდულობის ძალა."


msgid "Invert Pin Group"
msgstr "ჩამაგრებული ჯგუფის შებრუნება"


msgid "Invert which vertices are pinned and which are not."
msgstr "შეაბრუნე, რომელიც წვეროებია ჩამაგრებული და რომლები არა."


msgid "Damping increases the stability of the simulation while also slowing it down."
msgstr "დემპფირება სიმულაციის სტაბილურობას ზრდის და, ამავდროულად, ანელებს მას."


msgid "Mass assigned to each vertex in the solver."
msgstr "ამომხსნელში თითოეული წვეროსთვის მინიჭებული მასა."


msgid "How strong each vertex is pinned to its input position."
msgstr "რამდენად ძლიერადაა თითოეული წვერო თავის შენატან პოზიციაზე დამაგრებული."


msgid "Residual Error"
msgstr "ნარჩენი ცდომილება"


msgid "Average relative constraint error. 1 is good, higher is worse."
msgstr "ფარდობითი ბორკილის საშუალო ცდომილება. 1 კარგია, ხოლო მეტი - უარესი."


msgid "Custom simulation space (by default, simulation space is world space)."
msgstr "სიმულაციის მორგებული სივრცე (სიმულაციის ნაგულისხმები სივრცე სამყაროს სივრცეა)."


msgid "Settings affecting the solver speed and quality."
msgstr "ანაწყობები, რომლებიც ამომხსნელის სისწრაფესა და ხარისხზე ზემოქმედებს."


msgid "Stretchiness"
msgstr "წელვადობა"


msgid "Higher values make the cloth more elastic."
msgstr "მაღალი მნიშვნელობები ქსოვილს უფრო ელასტიურს ხდის."


msgid "Settings for structural constraints like bendiness and stretchiness."
msgstr "ანაწყობები სტრუქტურული ბორკილებისთვის, მაგალითად ღუნვადობისა და წელვადობისთვის."


msgid "Number of simulation steps per frame."
msgstr "სიმულაციის საფეხურების რაოდენობა ყოველ კადრზე."


msgid "Tearing"
msgstr "გახევა"


msgid "Enable dynamic tearing of the mesh."
msgstr "ჩართე მეშის დინამიკური დახევა."


msgid "Optional tearing."
msgstr "არასავალდებულო გახევა."


msgid "Tearing Edge Group"
msgstr "გასახევ წიბოთა ჯგუფი"


msgid "Selection of edges which are allowed to tear."
msgstr "წიბოები, რომელთა დახევაც დაშვებულია."


msgid "Tearing Mode"
msgstr "გახევის რეჟიმი"


msgid "How to choose which edges are allowed to tear."
msgstr "როგორ მოხდეს იმ წიბოების არჩევა, რომელთა დახევაც დაშვებულია."


msgid "Tearing Threshold"
msgstr "გახევის მიჯნა"


msgid "The higher the value, the stronger the stress required to tear an edge."
msgstr "რაც უფრო მაღალია მნიშვნელობა, უფრო მეტი ზეწოლაა საჭირო წიბოს გასახევად."


msgid "Tearing Voronoi Scale"
msgstr "გახევის ვორონოის მასშტაბი"


msgid "Scale of Voronoi patches whose boundaries can tear."
msgstr "მასშტაბი ვორონოის ნაჭრებისა, რომელთა საზღვრებიც შეიძლება, გაიხეს."


msgid "Collider"
msgstr "კოლაიდერი"


msgid "If true, the simulated geometry should stay within the mesh instead of it being pushed out of it."
msgstr "თუ ჭეშმარიტია, სიმულირებული გეომეტრია მეშის ფარგლებში უნდა დარჩეს და არა გასცდეს მათ."


msgid "The collider effector bundle that can be passed into a simulation."
