msgstr "სცენის მეტრი ერთეულში 0.001-ზე"


msgid "Inches"
msgstr "დუიმები"


msgid "Scene meters per unit to 0.0254"
msgstr "სცენის მეტრი ერთეულში 0.0254-ზე"


msgid "Feet"
msgstr "ფუტები"


msgid "Scene meters per unit to 0.3048"
