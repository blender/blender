msgstr "ძიება/ჩანაცვლება"


msgid "Replace text in the name"
msgstr "ჩაანაცვლე ტექსტი სახელში"


msgid "Set Name"
msgstr "სახელის დაყენება"


msgid "Set a new name or prefix/suffix the existing one"
msgstr "დააყენე ახალი სახელი, ან გაუკეთე თავსართი/ბოლოსართი უკვე არსებულს"


msgid "Strip Characters"
