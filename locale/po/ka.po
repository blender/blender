msgctxt "Operator"
msgid "Copy Effect"
msgstr "ეფექტის კოპირება"


msgid "Duplicate effect at the same position in the stack"
msgstr "დაადუბლირე ეფექტი სტეკში იმავე პოზიციაზე"


