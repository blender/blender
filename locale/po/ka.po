msgctxt "Operator"
msgid "Clear Pose Scale"
msgstr "პოზის მასშტაბის გასუფთავება"


msgid "Reset scaling of selected bones to their default values"
msgstr "დააბრუნე მონიშნულ ძვალთა მასშტაბირება ნაგულისხმებ მნიშვნელობებზე"


