msgid "Baked Animation"
msgstr "გამოცხობილი ანიმაცია"


msgid "Export baked keyframe animation"
msgstr "დააექსპორტირე გამოცხობილი საკვანძო ფაზებიანი ანიმაცია"


msgid "Force Start/End Keying"
