msgstr "დააყენე ობიექტის დაქვემდებარება მშობლის შექცეული კორექციის დაუყენებლად"


msgid "Keep Transform"
msgstr "გარდაქმნის დატოვება"


msgid "Preserve the world transform throughout parenting"
msgstr "შეინარჩუნე სამყაროსეული გარდაქმნა დაქვემდებარებისას"


msgid "Set the object's parenting"
msgstr "დააყენე ობიექტის დაქვემდებარება"


msgid "Apply transformation before parenting"
msgstr "მიუსადაგე გარდაქმნა დაქვემდებარებამდე"


