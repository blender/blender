msgstr "Sony კამერის შემავალი სივრცე S-Log3 გადაცემის ფუნქციისა და Venice S-Gamut3-ის პირველადი ფერების გამოყენებით."


msgid "S-Log3 Venice S-Gamut3.Cine"
msgstr "S-Log3 Venice S-Gamut3.Cine"


msgid "Sony camera input space using S-Log3 transfer function and Venice S-Gamut3.Cine primaries."
msgstr "Sony კამერის შემავალი სივრცე S-Log3 გადაცემის ფუნქციისა და Venice S-Gamut3.Cine-ის პირველადი ფერების გამოყენებით."


msgid "V-Log V-Gamut"
msgstr "V-Log V-Gamut"


msgid "Panasonic camera input space using V-Log transfer function and V-Gamut primaries."
msgstr "Panasonic კამერის შემავალი სივრცე V-Log გადაცემის ფუნქციისა და V-Gamut-ის პირველადი ფერების გამოყენებით."


msgid "sRGB IEC 61966-2-1 compound (piece-wise) encoding"
msgstr "sRGB IEC 61966-2-1 რთული (ცალ-ცალკე) დაშიფრვა"


msgid "sRGB-encoded AP1 with ACES white point. For use with scene-referred textures."
msgstr "sRGB-თ დაშიფრული AP1 ACES თეთრი წერტილით. სცენაში მითითებულ ტექსტურებთან გამოსაყენებლად."


msgid "sRGB-encoded P3-D65 with illuminant D65 white point. For use with scene-referred textures."
msgstr "sRGB-თ დაშიფრული P3-D65 მანათებელი D65 თეთრი წერილით. სცენაში მითითებულ ტექსტურებთან გამოსაყენებლად."


msgid "Working color space of the current file"
msgstr "ამ ფაილის სამუშაო ფერის სივრცე"


msgid "Do not perform any color transform on load, treat colors as in scene linear space already"
