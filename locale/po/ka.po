msgctxt "Operator"
msgid "Add Particle System Slot"
msgstr "ნაწილაკების სისტემის სლოტის დამატება"


msgid "Add a particle system"
msgstr "დაამატე ნაწილაკთა სისტემა"


msgctxt "Operator"
msgid "Remove Particle System Slot"
