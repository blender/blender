msgctxt "Operator"
msgid "Add to Keying Set"
msgstr "ჩასოლვის ნაკრებზე დამატება"


msgid "Add current UI-active property to current keying set"
msgstr "დაამატე მიმდინარე UI-აქტიური თვისება მიმდინარე ჩასოლვის ნაკრებს"


