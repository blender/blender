msgstr "Növü çıxar"


msgid "Only remove the specified type of F-Curve modifier"
msgstr "Yalnız göstərilmiş növ F-Əyri modifikatorunu silir"


msgctxt "Operator"
msgid "Paste F-Modifiers"
msgstr "F-modifikatorları yapışdır"


msgid "Add copied F-Modifiers to the selected F-Curves"
msgstr "Kopyalanmış F-Modifikatorları seçilmiş F-əyrilərə əlavə edir"


msgid "Only paste F-Modifiers on active F-Curve"
msgstr "Yalnız aktiv F-əyrisinə F-modifikatorları yapışdırır"


msgid "Replace existing F-Modifiers, instead of just appending to the end of the existing list"
msgstr "Mövcud F-Modifikatorları əvəz edir, sadəcə mövcud siyahının sonuna əlavə etmək əvəzinə"


msgid "Place the cursor on the midpoint of selected keyframes"
msgstr "Kursoru seçilmiş açar kadrların orta nöqtəsinə yerləşdirir"


msgctxt "Operator"
msgid "Gaussian Smooth"
msgstr "Qauss ilə hamarla"


msgid "Smooth the curve using a Gaussian filter"
msgstr "Qauss filtrindən istifadə edərək əyrini hamarla"


