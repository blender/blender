msgstr "Açarın özünə təsiri"


msgid "Keep"
msgstr "Saxla"


msgid "Leave as is"
msgstr "Olduğu kimi burax"


msgid "Effect on the left handle"
msgstr "Sol tutacaqda təsir"


msgid "Effect on the right handle"
msgstr "Sağ tutacaq üzərində təsir"


msgid "Mouse Click Side"
msgstr "Siçan klikinin tərəfi"


msgctxt "Operator"
msgid "Shear Keyframes"
msgstr "Açar kadrları əyilt"


