msgstr "Açar dəsti açar kadrını sil"


msgid "Delete keyframes on the current frame for all properties in the specified Keying Set"
msgstr "Göstərilən Açar dəstindəki bütün xüsusiyyətlər üçün cari kadrdakı açar kadrları silir"


msgid "The Keying Set to use"
msgstr "İstifadə ediləcək açar dəsti"


msgctxt "Operator"
msgid "Delete Keyframe (Buttons)"
msgstr "Açar kadrı sil (düymələr)"


msgid "Delete current keyframe of current UI-active property"
msgstr "UI-də aktiv olan xüsusiyyətin cari açar kadrını silir"


msgid "Delete keyframes from all elements of the array"
msgstr "Massivin bütün elementlərindən açar kadrları silir"


msgctxt "Operator"
msgid "Delete Keying-Set Keyframe (by name)"
msgstr "Açar dəsti açar kadrını sil (ada görə)"


msgid "Alternate access to 'Delete Keyframe' for keymaps to use"
msgstr "Klavişlər xəritələri üçün 'Açar kadrı sil'ə alternativ giriş"


msgctxt "Operator"
msgid "Delete Keyframe"
msgstr "Açar kadrı sil"


msgid "Remove keyframes on current frame for selected objects and bones"
msgstr "Seçilmiş obyektlər və sümüklər üçün cari kadrdakı açar kadrları silir"


msgid "Remove keyframes on current frame for selected strips"
msgstr "Seçilmiş zolaqlar üçün cari kadrdakı açar kadrları silir"


msgctxt "Operator"
msgid "Insert Keyframe"
msgstr "Açar kadr əlavə et"


msgid "Insert keyframes on the current frame using either the active keying set, or the user preferences if no keying set is active"
msgstr "Cari kadrda açar kadrları aktiv açar dəsti ilə, və ya aktiv açar dəsti yoxdursa istifadəçi tənzimləmələri ilə əlavə edir"


msgctxt "Operator"
msgid "Insert Keyframe (Buttons)"
msgstr "Açar kadr əlavə et (düymələr)"


msgid "Insert a keyframe for current UI-active property"
msgstr "UI-da aktiv olan cari xüsusiyyət üçün açar kadr əlavə edir"


msgid "Insert a keyframe for all element of the array"
msgstr "Massivin bütün elementləri üçün açar kadr əlavə et"


msgctxt "Operator"
msgid "Insert Keyframe (by name)"
msgstr "Açar kadr əlavə et (ad üzrə)"


msgid "Alternate access to 'Insert Keyframe' for keymaps to use"
msgstr "Klavişlər xəritələri üçün 'Açar kadr əlavə et'ə alternativ giriş"


msgctxt "Operator"
msgid "Insert Keyframe Menu"
msgstr "Açar kadr menyusunu əlavə et"


msgid "Insert Keyframes for specified Keying Set, with menu of available Keying Sets if undefined"
msgstr "Göstərilən Açar Dəsti üçün açar kadrlar əlavə edir, təyin olunmayıbsa mövcud Açar Dəstlərinin menyusu ilə"


msgid "Always Show Menu"
msgstr "Həmişə menyunu göstər"


msgctxt "Operator"
msgid "Set Active Keying Set"
msgstr "Aktiv açar dəstini təyin et"


msgid "Set a new active keying set"
msgstr "Yeni aktiv açar dəsti təyin et"


msgctxt "Operator"
msgid "Add Empty Keying Set"
msgstr "Boş açar dəsti əlavə et"


msgid "Add a new (empty) keying set to the active Scene"
msgstr "Aktiv Səhnəyə yeni (boş) açar dəsti əlavə edir"


msgid "Filter folders"
msgstr "Qovluqları süz"


msgid "Filter Python"
msgstr "Python süzgəci"


msgid "Filter text"
msgstr "Mətn süzgəci"


msgctxt "Operator"
msgid "Add Empty Keying Set Path"
msgstr "Boş açar dəsti yolu əlavə et"


msgid "Add empty path to active keying set"
msgstr "Aktiv açar dəstinə boş yol əlavə et"


msgctxt "Operator"
msgid "Remove Active Keying Set Path"
msgstr "Aktiv açar dəsti yolunu çıxar"


msgid "Remove active Path from active keying set"
msgstr "Aktiv açar dəstindən aktiv yolu çıxar"


msgctxt "Operator"
msgid "Remove Active Keying Set"
msgstr "Aktiv açar dəstini çıxar"


msgid "Remove the active keying set"
msgstr "Aktiv açar dəstini sil"


msgctxt "Operator"
msgid "Add to Keying Set"
msgstr "Açar dəstinə əlavə et"


msgid "Add current UI-active property to current keying set"
msgstr "Cari UI-aktiv xüsusiyyətini cari açar dəstinə əlavə edir"


msgid "Add all elements of the array to a Keying Set"
msgstr "Massivin bütün elementlərini Açar dəstinə əlavə edir"


msgctxt "Operator"
msgid "Remove from Keying Set"
msgstr "Açar dəstindən çıxar"


msgid "Remove current UI-active property from current keying set"
msgstr "Cari açar dəstindən cari UI-aktiv xüsusiyyəti çıxarır"


msgctxt "Operator"
msgid "Merge Animation"
msgstr "Animasiyanı birləşdir"


msgid "Merge the animation of the selected objects into the action of the active object. Actions are not deleted by this, but might end up with zero users"
msgstr "Seçilmiş obyektlərin animasiyasını aktiv obyektin hərəkətinə birləşdirir. Hərəkətlər bununla silinmir, lakin istifadəçi sayı sıfıra düşə bilər"


msgctxt "Operator"
msgid "Paste Driver"
msgstr "Drayveri yapışdır"


msgid "Paste the driver in the internal clipboard to the highlighted button"
msgstr "Daxili buferdəki drayveri vurğulanmış düyməyə yapışdırır"


msgctxt "Operator"
msgid "Clear Preview Range"
msgstr "Önizləmə aralığını təmizlə"


msgid "Clear preview range"
msgstr "Önizləmə aralığını təmizlə"


msgctxt "Operator"
msgid "Set Preview Range"
msgstr "Önizləmə aralığını təyin et"


msgid "Interactively define frame range used for playback"
msgstr "Oynatma üçün istifadə olunan kadr diapazonunu interaktiv təyin edir"


msgctxt "Operator"
msgid "Replace Action"
msgstr "Hərəkəti əvəz et"


msgid "Swap all users of one action to another one. The normal action slot assignment rules apply. This ignores the NLA and Action Constraints"
msgstr "Bir Hərəkətin bütün istifadəçilərini başqasına dəyişir. Normal Hərəkət slotu təyinat qaydaları tətbiq olunur. Bu, NLA və Action Constraint-lərini nəzərə almır"


msgid "Replacement Action"
msgstr "Əvəzedici hərəkət"


msgid "The replacement Action's session uid to remap all selected Action's users to"
msgstr "Bütün seçilmiş Hərəkət istifadəçilərinin yenidən xəritələnəcəyi əvəzedici Hərəkətin sessiya uid-i"


msgid "Old Action"
msgstr "Köhnə hərəkət"


msgid "Old Action's session uid to replace"
msgstr "Dəyişdiriləcək köhnə Hərəkətin sessiya uid-i"


msgctxt "Operator"
msgid "Replace with Duplicate Action"
msgstr "Çoxaldılmış hərəkətlə əvəz et"


msgid "Duplicates the action of the active object and swaps all users of that action to that duplicate"
msgstr "Aktiv obyektin hərəkətini çoxaldır və həmin hərəkətin bütün istifadəçilərini bu nüsxəyə keçirir"


msgctxt "Operator"
msgid "Replace with New Action"
msgstr "Yeni hərəkətlə əvəz et"


msgid "Swap all users of one action to a new action. This ignores the NLA and Action Constraints"
msgstr "Bir hərəkətin bütün istifadəçilərini yeni hərəkətə dəyişir. Bu, NLA və Hərəkət Məhdudiyyətlərini nəzərə almır"


msgctxt "Operator"
msgid "Convert Rotation Mode"
msgstr "Fırlanma rejimini çevir"


msgid "On all selected, change the rotation mode and convert any existing animation into that new mode"
msgstr "Bütün seçilmişlərdə fırlanma rejimini dəyişir və mövcud animasiyanı həmin yeni rejimə çevirir"


msgid "Creates a key on every frame before conversion so interpolation is preserved in the new mode"
msgstr "Yeni rejimdə interpolyasiyanı qorumaq üçün çevrilmədən əvvəl hər kadrda açar kadr yaradır"


msgid "The rotation mode to convert the selection to"
msgstr "Seçimin çevriləcəyi fırlanma rejimi"


msgctxt "Operator"
msgid "Frame Scene/Preview Range"
msgstr "Səhnə/önizləmə diapazonuna kadrla"


msgid "Reset the horizontal view to the current scene frame range, taking the preview range into account if it is active"
msgstr "Üfüqi görünüşü cari səhnənin kadr diapazonuna sıfırlayır, aktivdirsə önizləmə diapazonunu nəzərə alır"


msgctxt "Operator"
msgid "Separate Slots"
msgstr "Slotları ayır"


msgid "Move all slots of the action on the active object into newly created, separate actions. All users of those slots will be reassigned to the new actions. The current action won't be deleted but will be empty and might end up having zero users"
msgstr "Aktiv obyektdəki hərəkətin bütün yuvalarını yeni, ayrı hərəkətlərə köçürür. Bu yuvaların bütün istifadəçiləri yeni hərəkətlərə yenidən təyin olunacaq. Cari hərəkət silinməyəcək, lakin boş olacaq və sıfır istifadəçiyə malik ola bilər"


msgctxt "Operator"
msgid "Move Slots to new Action"
msgstr "Slotları yeni hərəkətə daşı"


msgid "Move the selected slots into a newly created action"
msgstr "Seçilmiş slotları yeni yaradılmış hərəkətə köçürür"


msgid "Create a new action slot for this data-block, to hold its animation"
msgstr "Bu məlumat bloku üçün animasiyasını saxlamaq üçün yeni hərəkət slotu yaradır"


msgid "Un-assign the action slot from this constraint"
msgstr "Bu məhdudiyyətdən hərəkət yuvasının təyinatını ləğv edir"


msgid "Un-assign the action slot, effectively making this data-block non-animated"
msgstr "Hərəkət slotunun təyinatını ləğv edir, bu data-bloku effektiv olaraq animasiyasız edir"


msgid "Un-assign the action slot from this NLA strip, effectively making it non-animated"
msgstr "Hərəkət slotunu bu NLA zolağından təyinatdan çıxarır, nəticədə o, animasiyasız olur."


msgctxt "Operator"
msgid "Set Start Frame"
msgstr "Başlanğıc kadrı təyin et"


msgid "Set the current frame as the preview or scene start frame"
msgstr "Cari kadrı önizləmə və ya səhnənin başlanğıc kadrı kimi təyin edir"


msgid "Moves any F-Curves for the `hide` property of selected armatures into the action of the object. This will only operate on the first layer and strip of the action"
msgstr "Seçilmiş armaturların `hide` xüsusiyyəti üçün olan F-əyrilərini obyektin hərəkətinə köçürür. Bu, yalnız hərəkətin birinci təbəqəsi və zolağı üzərində işləyəcək"


msgctxt "Operator"
msgid "View In Graph Editor"
msgstr "Qrafik redaktorunda göstər"


msgid "Frame the property under the cursor in the Graph Editor"
msgstr "Qrafik redaktorunda kursor altındakı xüsusiyyəti çərçivəyə alır"


msgid "Show All"
msgstr "Hamısını göstər"


msgid "Frame the whole array property instead of only the index under the cursor"
msgstr "Bütün massiv xüsusiyyətini yalnız kursorun altındakı indeks əvəzinə çərçivəyə alır"


msgid "Isolate"
msgstr "İzolyasiya"


msgid "Hides all F-Curves other than the ones being framed"
msgstr "Çərçivəyə alınanlardan başqa bütün F-əyriləri gizlədir"


msgctxt "Operator"
msgid "Copy World Space Range"
msgstr "Dünya fəza diapazonunu kopyala"


msgid "Copy animation from selected elements to the clipboard"
msgstr "Seçilmiş elementlərdən animasiyanı buferə kopyalayır"


msgid "End frame to copy from"
msgstr "Kopyalanacaq son kadr"


msgid "Range Mode"
msgstr "Diapazon rejimi"


msgid "Determines which range should be copied"
msgstr "Hansı diapazonun kopyalanacağını müəyyən edir"


msgid "Use the range provided in the operator properties"
msgstr "Operator xüsusiyyətlərində verilmiş diapazondan istifadə edir"


msgid "Playback Range"
msgstr "Oynatma diapazonu"


msgid "Use the playback range of the scene"
msgstr "Səhnənin oxutma diapazonundan istifadə edir"


msgid "Start frame to copy from"
msgstr "Kopyalanacaq başlanğıc kadr"


msgctxt "Operator"
msgid "Paste World Space"
msgstr "Dünya fəzasını yapışdır"


msgid "Paste the animation from the clipboard to selected elements"
msgstr "Animasiyanı buferdən seçilmiş elementlərə yapışdırır"


msgid "Paste data to the same frames they were copied from"
msgstr "Məlumatı kopyalandığı eyni kadrlara yapışdırır"


msgid "Start at Current Frame"
msgstr "Cari kadrdan başla"


msgid "Paste data starting at current frame"
msgstr "Məlumatı cari kadrdan başlayaraq yapışdır"


msgctxt "Operator"
msgid "Align Bones"
msgstr "Sümükləri düzləndir"


msgid "Align selected bones to the active bone (or to their parent)"
msgstr "Seçilmiş sümükləri aktiv sümük (və ya onların ana sümüyü) ilə düzləşdirir"


msgctxt "Operator"
msgid "Assign to Collection"
msgstr "Kolleksiyaya təyin et"


msgid "Assign all selected bones to a collection, or unassign them, depending on whether the active bone is already assigned or not"
msgstr "Aktiv sümük artıq təyin olunubsa və ya olunmayıbsa, asılı olaraq bütün seçilmiş sümükləri kolleksiyaya təyin edir və ya təyinatı ləğv edir"


msgid "Collection Index"
msgstr "Kolleksiya indeksi"


msgid "Index of the collection to assign selected bones to. When the operator should create a new bone collection, use new_collection_name to define the collection name, and set this parameter to the parent index of the new bone collection"
msgstr "Seçilmiş sümükləri təyin ediləcək kolleksiyanın indeksi. Operator yeni sümük kolleksiyası yaratmalı olduqda, kolleksiyanın adını təyin etmək üçün new_collection_name istifadə edin və bu parametri yeni sümük kolleksiyasının valideyn indeksinə təyin edin"


msgid "Name of a to-be-added bone collection. Only pass this if you want to create a new bone collection and assign the selected bones to it. To assign to an existing collection, do not include this parameter and use collection_index"
msgstr "Əlavə ediləcək sümük kolleksiyasının adı. Yalnız yeni sümük kolleksiyası yaratmaq və seçilmiş sümükləri ona təyin etmək istəyirsinizsə bunu təyin edin. Mövcud kolleksiyaya təyin etmək üçün bu parametri daxil etməyin və collection_index istifadə edin"


msgctxt "Operator"
msgid "Auto-Name by Axis"
msgstr "Oxa görə avtomatik adlandır"


msgid "Automatically renames the selected bones according to which side of the target axis they fall on"
msgstr "Seçilmiş sümükləri hədəf oxun hansı tərəfində yerləşmələrinə görə avtomatik yenidən adlandırır"


msgid "Axis to tag names with"
msgstr "Adları etiketləmək üçün ox"


msgid "X-Axis"
msgstr "X-ox"


msgid "Left/Right"
msgstr "Sol/Sağ"


msgid "Y-Axis"
msgstr "Y-ox"


msgid "Front/Back"
msgstr "Ön/Arxa"


msgid "Top/Bottom"
msgstr "Üst/Alt"


msgctxt "Operator"
msgid "Add Bone"
msgstr "Sümük əlavə et"


msgid "Add a new bone located at the 3D cursor"
msgstr "3D kursorun yerində yeni sümük əlavə et"


msgid "Initial orientation of the new bone"
msgstr "Yeni sümüyün ilkin istiqaməti"


msgid "Make the bone visually point upwards so the long axis is aligned with the World/Object positive Z axis (depending on the choice above)"
msgstr "Sümüyü vizual olaraq yuxarı yönəldir ki, uzun ox Dünya/Obyekt müsbət Z oxu ilə hizalansın (yuxarıdakı seçimdən asılı olaraq)"


msgid "Axes"
msgstr "Oxlar"


msgid "Align the new bone to match the axes of the World/Object (depending on the choice above)"
msgstr "Yeni sümüyü Dünya/Obyekt oxlarına uyğunlaşdırır (yuxarıdakı seçimdən asılı olaraq)"


msgid "Align new bone to match the axes of the 3D cursor"
msgstr "Yeni sümüyü 3D kursorun oxlarına uyğunlaşdırır"


msgid "Align new bone to match the axes of the 3D viewport"
msgstr "Yeni sümüyü 3D görünüş sahəsinin oxlarına uyğunlaşdırır"


msgid "Length of the new bone"
msgstr "Yeni sümüyün uzunluğu"


msgid "Name of the newly created bone"
msgstr "Yeni yaradılmış sümüyün adı"


msgid "Co-ordinate system the new bone will be created in"
msgstr "Yeni sümüyün yaradılacağı koordinat sistemi"


msgid "The newly created bone will use Object Space co-ordinate system"
msgstr "Yeni yaradılmış sümük Obyekt Fəzası koordinat sistemindən istifadə edəcək"


msgid "The newly created bone will use World Space co-ordinate system"
msgstr "Yeni yaradılan sümük Dünya fəzası koordinat sistemindən istifadə edəcək"


msgid "Enable bone to deform geometry"
msgstr "Həndəsəni deformasiya etmək üçün sümüyü aktivləşdir"


msgctxt "Operator"
msgid "Recalculate Roll"
msgstr "Yuvarlanmanı yenidən hesabla"


msgid "Automatically fix alignment of select bones' axes"
msgstr "Seçilmiş sümüklərin oxlarının düzləndirilməsini avtomatik düzəldir"


msgid "Negate the alignment axis"
msgstr "Düzləşdirmə oxunu inkar et"


msgid "Shortest Rotation"
msgstr "Ən qısa fırlanma"


msgid "Ignore the axis direction, use the shortest rotation to align"
msgstr "Ox istiqamətini nəzərə almayın, düzləşdirmək üçün ən qısa fırlanmadan istifadə edin"


msgid "Local +X Tangent"
msgstr "Lokal +X tangens"


msgid "Local +Z Tangent"
msgstr "Lokal +Z tangens"


msgid "Global +X Axis"
msgstr "Qlobal +X oxu"


msgid "Global +Y Axis"
msgstr "Qlobal +Y oxu"


msgid "Global +Z Axis"
msgstr "Qlobal +Z oxu"


msgid "Local -X Tangent"
msgstr "Lokal -X tangens"


msgid "Local -Z Tangent"
msgstr "Lokal -Z tangens"


msgid "Global -X Axis"
msgstr "Qlobal -X oxu"


msgid "Global -Y Axis"
msgstr "Qlobal -Y oxu"


msgid "Global -Z Axis"
msgstr "Qlobal -Z oxu"


msgid "View Axis"
msgstr "Görünüş oxu"


msgctxt "Operator"
msgid "Extrude to Cursor"
msgstr "Kursora ekstruziya et"


msgid "Create a new bone going from the last selected joint to the mouse position"
msgstr "Son seçilmiş oynaqdan siçan mövqeyinə qədər yeni sümük yaradır"


msgctxt "Operator"
msgid "Add Bone Collection"
msgstr "Sümük kolleksiyası əlavə et"


msgid "Add a new bone collection"
msgstr "Yeni sümük kolleksiyası əlavə et"


msgctxt "Operator"
msgid "Add Selected Bones to Collection"
msgstr "Seçilmiş sümükləri kolleksiyaya əlavə et"


msgid "Add selected bones to the chosen bone collection"
msgstr "Seçilmiş sümükləri seçilmiş sümük kolleksiyasına əlavə edir"


msgid "Bone Collection"
msgstr "Sümük kolleksiyası"


msgid "Name of the bone collection to assign this bone to; empty to assign to the active bone collection"
msgstr "Bu sümüyü təyin etmək üçün sümük kolleksiyasının adı; aktiv sümük kolleksiyasına təyin etmək üçün boş"


msgctxt "Operator"
msgid "Add Selected Bones to New Collection"
msgstr "Seçilmiş sümükləri yeni kolleksiyaya əlavə et"


msgid "Create a new bone collection and assign all selected bones"
msgstr "Yeni sümük kolleksiyası yaradır və bütün seçilmiş sümükləri təyin edir"


msgid "Name of the bone collection to create"
msgstr "Yaradılacaq sümük kolleksiyasının adı"


msgctxt "Operator"
msgid "Deselect Bone Collection"
msgstr "Sümük kolleksiyasının seçimini ləğv et"


msgid "Deselect bones of active Bone Collection"
msgstr "Aktiv sümük kolleksiyasının sümüklərinin seçimini ləğv et"


msgctxt "Operator"
msgid "Move Bone Collection"
msgstr "Sümük kolleksiyasını daşı"


msgid "Change position of active Bone Collection in list of Bone collections"
msgstr "Sümük kolleksiyaları siyahısında aktiv Sümük Kolleksiyasının yerini dəyişir"


msgid "Direction to move the active Bone Collection towards"
msgstr "Aktiv Sümük Kolleksiyasını daşıyacağı istiqamət"


msgctxt "Operator"
msgid "Remove Bone Collection"
msgstr "Sümük kolleksiyasını çıxar"


msgid "Remove the active bone collection"
msgstr "Aktiv sümük kolleksiyasını çıxar"


msgctxt "Operator"
msgid "Select Bones of Bone Collection"
msgstr "Sümük kolleksiyasının sümüklərini seç"


msgid "Select bones in active Bone Collection"
msgstr "Aktiv Sümük Kolleksiyasındakı sümükləri seç"


msgctxt "Operator"
msgid "Remove Selected from Bone collections"
msgstr "Kemik kolleksiyalarından seçilmişləri çıxar"


msgid "Remove selected bones from the active bone collection"
