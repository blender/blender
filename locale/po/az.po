msgid "Splash Screen"
msgstr "Açılış ekranını göstər"


msgid "Open the splash screen with release info"
msgstr "Buraxılış məlumatı ilə açılış ekranını aç"


msgctxt "Operator"
msgid "About Blender"
msgstr "Blender haqqında"


msgid "Open a window with information about Blender"
msgstr "Blender haqqında məlumat olan pəncərə aç"


msgctxt "Operator"
msgid "Import SPZ"
msgstr "SPZ idxal et"


msgid "Import an SPZ file as a gaussian splat point cloud object"
msgstr "SPZ faylını Qauss splat nöqtə buludu obyekti kimi idxal edir"


msgctxt "Operator"
msgid "Export STL"
msgstr "STL ixrac et"


msgid "Save the scene to an STL file"
msgstr "Səhnəni STL faylına saxla"


msgid "Batch Export"
msgstr "Toplu ixrac"


msgid "Export each object to a separate file"
msgstr "Hər obyekti ayrı fayla ixrac edir"


msgid "Apply current scene's unit (as defined by unit scale) to exported data"
msgstr "Vahid miqyası ilə təyin olunan cari səhnənin vahidini ixrac edilmiş verilərə tətbiq edin"


msgctxt "Operator"
msgid "Import STL"
msgstr "STL idxal et"


msgid "Import an STL file as an object"
msgstr "STL faylını obyekt kimi idxal et"


msgid "Facet Normals"
msgstr "Fasetli normallar"


msgid "Use (import) facet normals (note that this will still give flat shading)"
msgstr "Facet normallarını (idxal) istifadə edir (bunun yenə də düz kölgələndirmə verəcəyini nəzərə alın)"


msgid "Validate Mesh"
msgstr "Mesh-i doğrula"


msgid "Brush type identifier for which the most appropriate tool will be looked up"
msgstr "Ən uyğun alətin axtarılacağı fırça növünün identifikatoru"


msgid "Set Fallback"
msgstr "Ehtiyatı təyin et"


msgid "Set the fallback tool instead of the primary tool"
msgstr "Əsas alət əvəzinə ehtiyat alətini təyin edir"


msgid "Cycle"
msgstr "Dövr"


msgid "Cycle through tools in this group"
msgstr "Bu qrupdakı alətlər arasında keçid edir"


msgid "Identifier of the tool"
msgstr "Alətin identifikatoru"


msgid "Set the fallback tool instead of the primary"
msgstr "Əsas alət əvəzinə ehtiyat alətini təyin edir"


msgid "Include tool subgroups"
msgstr "Alət alt qruplarını daxil et"


msgid "Index in Toolbar"
msgstr "Alətlər panelindəki indeks"


msgid "URL to open"
msgstr "Açılacaq URL"


msgid "Site"
msgstr "Sayt"


msgctxt "Operator"
msgid "Export USD"
msgstr "USD ixrac et"


msgid "Export current scene in a USD archive"
msgstr "Cari səhnəni USD arxivinə ixrac edir"


msgid "Set the accessibility description for the exported stage's default prim"
msgstr "İxrac olunmuş səhnənin standart primi üçün əlçatanlıq təsvirini təyin edir"


msgid "Set the accessibility label for the exported stage's default prim"
msgstr "İxrac olunmuş mərhələnin standart primitivi üçün əlçatanlıq etiketini təyin edir"


msgid "Allow Unicode"
msgstr "Unicode-a icazə ver"


msgid "Preserve UTF-8 encoded characters when writing USD prim and property names (requires software utilizing USD 24.03 or greater when opening the resulting files)"
msgstr "USD prim və xüsusiyyət adlarını yazarkən UTF-8 kodlaşdırılmış simvolları qoruyur (nəticə fayllarını açarkən USD 24.03 və ya daha yeni versiyasından istifadə edən proqram tələb olunur)"


msgid "Blender Names"
msgstr "Blender adları"


msgid "Author USD custom attributes containing the original Blender object and object data names"
msgstr "Orijinal Blender obyektinin və obyekt məlumatı adlarını ehtiva edən USD fərdi atributlarını yaradır"


msgid "Convert Orientation"
msgstr "İstiqaməti çevir"


msgid "Convert orientation axis to a different convention to match other applications"
msgstr "Digər tətbiqlərlə uyğunlaşmaq üçün istiqamət oxunu fərqli konvensiyaya çevirir"


msgid "Set the USD Stage meters per unit to the chosen measurement, or a custom value"
msgstr "USD Stage-in vahid başına metrini seçilmiş ölçüyə və ya fərdi dəyərə təyin edir"


msgid "Meters"
msgstr "Metr"


msgid "Scene meters per unit to 1.0"
msgstr "Səhnənin vahid başına metr dəyəri 1.0-a"


msgid "Kilometers"
msgstr "Kilometrlər"


msgid "Scene meters per unit to 1000.0"
msgstr "Vahid başına səhnə metri: 1000.0"


msgid "Centimeters"
msgstr "Santimetr"


msgid "Scene meters per unit to 0.01"
msgstr "Səhnədə vahid başına metri 0.01 et"


msgid "Scene meters per unit to 0.001"
msgstr "Səhnənin vahid başına metrini 0.001-ə çevir"


msgid "Inches"
msgstr "İnç"


msgid "Scene meters per unit to 0.0254"
msgstr "Vahid başına səhnə metri: 0.0254"


msgid "Feet"
msgstr "Fut"


msgid "Scene meters per unit to 0.3048"
msgstr "Vahid başına səhnə metri: 0.3048"


msgid "Yards"
msgstr "Yard"


msgid "Scene meters per unit to 0.9144"
msgstr "Vahid başına səhnə metri: 0.9144"


msgid "Specify a custom scene meters per unit value"
msgstr "Səhnənin hər vahidi üçün metr dəyərini fərdi təyin edir"


msgid "World Dome Light"
msgstr "Dünya gümbəz işığı"


msgid "Convert the world material to a USD dome light. Currently works for simple materials, consisting of an environment texture connected to a background shader, with an optional vector multiply of the texture color"
msgstr "Dünya materialını USD dome işığına çevirir. Hal-hazırda sadə materiallar üçün işləyir: fon şeyderinə qoşulmuş mühit teksturasından ibarət, teksturanın rəngi ilə isteğe bağlı vektor vurması ilə"


msgid "Namespace"
msgstr "Ad fəzası"


msgid "If set, add the given namespace as a prefix to exported custom property names. This only applies to property names that do not already have a prefix (e.g., it would apply to name 'bar' but not 'foo:bar') and does not apply to blender object and data names which are always exported in the 'userProperties:blender' namespace"
msgstr "Aktiv olduqda, verilmiş ad sahəsi ixrac olunan fərdi xüsusiyyət adlarına prefiks kimi əlavə edilir. Bu, artıq prefiksi olmayan xüsusiyyət adlarına tətbiq olunur (məsələn, 'bar' adına tətbiq olunur, 'foo:bar' adına isə yox) və həmişə 'userProperties:blender' ad sahəsində ixrac olunan blender obyekt və məlumat adlarına tətbiq olunmur"


msgid "Use Settings for"
msgstr "Bunun üçün tənzimləmələrdən istifadə et"


msgid "Export all frames in the render frame range, rather than only the current frame"
msgstr "Yalnız cari kadr əvəzinə render kadr diapazonundakı bütün kadrları ixrac edir"


msgid "Export armatures and meshes with armature modifiers as USD skeletons and skinned meshes"
msgstr "Armaturları və armatur modifikatorlu mesh-ləri USD skeletləri və skinned mesh-ləri kimi ixrac edir"


msgid "Export all cameras"
msgstr "Bütün kameraları ixrac et"


msgid "Export all curves"
msgstr "Bütün əyriləri ixrac et"


msgid "Export custom properties as USD attributes"
msgstr "Fərdi xüsusiyyətləri USD atributları kimi ixrac et"


msgid "Export hair particle systems as USD curves"
msgstr "Saç hissəcik sistemlərini USD əyriləri kimi ixrac et"


msgid "Export all lights"
msgstr "Bütün işıqları ixrac et"


msgid "Export viewport settings of materials as USD preview materials, and export material assignments as geometry subsets"
msgstr "Materialların görünüş sahəsi tənzimləmələrini USD önizləmə materialları kimi ixrac edir, material təyinatlarını isə həndəsə alt çoxluqları kimi ixrac edir"


msgid "Include mesh color attributes in the export"
msgstr "İxracata mesh rəng atributlarını daxil edir"


msgid "Export all meshes"
msgstr "Bütün mesh-ləri ixrac et"


msgid "Include normals of exported meshes in the export"
msgstr "İxracda ixrac olunan ağların normallarını daxil et"


msgid "Export all point clouds"
msgstr "Bütün nöqtə buludlarını ixrac et"


msgid "Export shape keys as USD blend shapes"
msgstr "Forma açarlarını USD qarışıq formaları kimi ixrac edir"


msgid "Subdivision"
msgstr "Alt bölmə"


msgid "Choose how subdivision modifiers will be mapped to the USD subdivision scheme during export"
msgstr "İxrac zamanı subdivision modifikatorlarının USD subdivision sxemi ilə necə uyğunlaşdırılacağını seçir"


msgid "Scheme = None. Export base mesh without subdivision"
msgstr "Sxem = Heç biri. Əsas mesh-i bölünmədən ixrac edir"


msgid "Tessellate"
msgstr "Tessellyasiya"


msgid "Scheme = None. Export subdivided mesh"
msgstr "Sxem = Heç biri. Bölünmüş mesh-i ixrac edir"


msgid "Best Match"
msgstr "Ən yaxşı uyğunluq"


msgid "Scheme = Catmull-Clark, when possible. Reverts to exporting the subdivided mesh for the Simple subdivision type"
msgstr "Mümkün olduqda Scheme = Catmull-Clark. Sadə alt bölmə növü üçün bölünmüş meshi ixrac etməyə qayıdır"


msgid "Export Textures"
msgstr "Teksturaları ixrac et"


msgid "Texture export method"
msgstr "Tekstura ixrac üsulu"


msgid "Use original location of textures"
msgstr "Teksturaların orijinal yerini saxlayır"


msgid "Preserve"
msgstr "Qoru"


msgid ""
"Preserve file paths of textures from already imported USD files.\n"
"Export remaining textures to a 'textures' folder next to the USD file"
msgstr ""
"Artıq idxal olunmuş USD fayllarından teksturaların fayl yollarını saxlayın.\n"
"Qalan teksturaları USD faylının yanındakı 'textures' qovluğuna ixrac edin"


msgid "New Path"
msgstr "Yeni yol"


msgid "Export textures to a 'textures' folder next to the USD file"
msgstr "Teksturaları USD faylının yanındakı 'textures' qovluğuna ixrac edir"


msgid "UV Maps"
msgstr "UV xəritələri"


msgid "Include all mesh UV maps in the export"
msgstr "İxracata bütün mesh UV xəritələrini daxil edir"


msgid "Export all volumes"
msgstr "Bütün həcmləri ixrac et"


msgid "MaterialX Network"
msgstr "MaterialX şəbəkəsi"


msgid "Generate a MaterialX network representation of the materials"
msgstr "Materialların MaterialX şəbəkə təsvirini yaradır"


msgid "USD Preview Surface Network"
msgstr "USD önizləmə səth şəbəkəsi"


msgid "Generate an approximate USD Preview Surface shader representation of a Principled BSDF node network"
msgstr "Principled BSDF düyün şəbəkəsinin təxmini USD Preview Surface şeyder təsvirini yaradır"


msgid "Incremental Save"
msgstr "Artımlı saxlama"


msgid "Incrementally save after the specified number of frames to reduce peak memory usage. Incremental saves can result in longer export times and potential issues with some file synchronization services. Zero disables incremental save"
msgstr "Pik yaddaş istifadəsini azaltmaq üçün hər təyin olunmuş sayda kadrdan sonra artımlı yadda saxla. Artımlı saxlama ixrac müddətini uzada və bəzi fayl sinxronizasiya xidmətləri ilə potensial problemlərə səbəb ola bilər. Sıfır artımlı saxlamanı söndürür"


msgid "Merge parent Xform"
msgstr "Valideyn Xform-u birləşdir"


msgid "Merge USD primitives with their Xform parent if possible. USD does not allow nested UsdGeomGprims, intermediary Xform prims will be defined to keep the USD file valid when encountering object hierarchies."
msgstr "Mümkünsə USD primitivlərini onların Xform valideyni ilə birləşdirir. USD iç-içə UsdGeomGprims-ə icazə vermir; obyekt iyerarxiyaları ilə qarşılaşdıqda USD faylını etibarlı saxlamaq üçün aralıq Xform primitivləri təyin ediləcək."


msgid "Meters Per Unit"
msgstr "Vahid başına metr"


msgid "Custom value for meters per unit in the USD Stage"
msgstr "USD Səhnəsində vahid başına metr üçün fərdi dəyər"


msgid "Only export deform bones and their parents"
msgstr "Yalnız deformasiya sümüklərini və onların valideynlərini ixrac et"


msgid "Overwrite Textures"
msgstr "Teksturaların üzərinə yaz"


msgid "Overwrite existing files when exporting textures"
msgstr "Teksturaları ixrac edərkən mövcud faylların üzərinə yaz"


msgid "Use relative paths to reference external files (i.e. textures, volumes) in USD, otherwise use absolute paths"
msgstr "USD-də xarici faylara (məsələn, teksturalar, həcmlər) istinad etmək üçün nisbi yollardan istifadə edir, əks halda mütləq yollardan"


msgid "Rename UV Maps"
msgstr "UV xəritələrini yenidən adlandır"


msgid "Rename active render UV map to \"st\" to match USD conventions"
msgstr "USD qaydalarına uyğun olması üçün aktiv render UV xəritəsinin adını \"st\" olaraq dəyişir"


msgid "Root Prim"
msgstr "Kök prim"


msgid "If set, add a transform primitive with the given path to the stage as the parent of all exported data"
msgstr "Təyin edilərsə, göstərilən yolla transform primitivini bütün ixrac olunan məlumatların valideyni kimi səhnəyə əlavə edir"


msgid "Selection Only"
msgstr "Yalnız seçim"


msgid "Only export selected objects. Unselected parents of selected objects are exported as empty transform"
msgstr "Yalnız seçilmiş obyektləri ixrac edir. Seçilmiş obyektlərin seçilməmiş valideynləri boş transformasiya kimi ixrac olunur"


msgid "Triangulate Meshes"
msgstr "Mesh-ləri üçbucaqlat"


msgid "Triangulate meshes during export"
msgstr "İxrac zamanı meshləri üçbucaqlandır"


msgid "USDZ Custom Downscale Size"
msgstr "USDZ fərdi kiçiltmə ölçüsü"


msgid "Custom size for downscaling exported textures"
msgstr "İxrac edilən teksturaların kiçildilməsi üçün fərdi ölçü"


msgid "USDZ Texture Downsampling"
msgstr "USDZ tekstura ölçüsünün azaldılması"


msgid "Choose a maximum size for all exported textures"
msgstr "İxrac edilən bütün teksturalar üçün maksimum ölçü seçin"


msgid "Keep all current texture sizes"
msgstr "Bütün cari tekstura ölçülərini saxla"


msgid "Resize to a maximum of 256 pixels"
msgstr "Maksimum 256 piksel ölçüsünə dəyişdir"


msgid "Resize to a maximum of 512 pixels"
msgstr "Maksimum 512 piksel ölçüsünə dəyişdir"


msgid "Resize to a maximum of 1024 pixels"
msgstr "Maksimum 1024 piksel ölçüsünə dəyişdir"


msgid "Resize to a maximum of 2048 pixels"
msgstr "Maksimum 2048 piksel ölçüsünə dəyişdir"


msgid "Resize to a maximum of 4096 pixels"
msgstr "Maksimum 4096 piksel ölçüsünə dəyişdir"


msgid "Specify a custom size"
msgstr "Fərdi ölçü təyin edin"


msgid "Instancing"
msgstr "Nüsxələmə"


msgid "Export instanced objects as references in USD rather than real objects"
msgstr "Nüsxələnmiş obyektləri həqiqi obyektlər əvəzinə USD-də istinad kimi ixrac edir"


msgid "Xform Ops"
msgstr "Xform əməliyyatları"


msgid "The type of transform operators to write"
msgstr "Yazılacaq transformasiya operatorlarının növü"


msgid "Translate, Rotate, Scale"
msgstr "Sürüşdür, Fırlat, Miqyas"


msgid "Export with translate, rotate, and scale Xform operators"
msgstr "Daşıma, fırlanma və miqyas Xform operatorları ilə ixrac edilir"


msgid "Translate, Orient, Scale"
msgstr "Sürüşdür, Yönləndir, Miqyas"


msgid "Export with translate, orient quaternion, and scale Xform operators"
msgstr "Xform operatorlarını translate, orient quaternion və scale ilə ixrac edir"


msgid "Export matrix operator"
msgstr "Matris operatorunu ixrac et"


msgctxt "Operator"
msgid "Import USD"
msgstr "USD idxal et"


msgid "Import USD stage into current scene"
msgstr "USD səhnəsini cari səhnəyə idxal et"


msgid "Apply Unit Conversion Scale"
msgstr "Vahid çevrilməsi miqyasının tətbiqi"


msgid "Scale the scene objects by the USD stage's meters per unit value. This scaling is applied in addition to the value specified in the Scale option"
msgstr "Səhnə obyektlərini USD səhnəsinin vahid başına metr dəyərinə görə miqyaslayır. Bu miqyaslama Miqyas seçimində göstərilən dəyərə əlavə olaraq tətbiq olunur"


msgid "Create Collection"
msgstr "Kolleksiya yarat"


msgid "Add all imported objects to a new collection"
msgstr "Bütün idxal olunmuş obyektləri yeni kolleksiyaya əlavə edir"


msgid "Convert the first discovered USD dome light to a world background shader"
msgstr "Tapılan ilk USD gümbəz işığını dünya fonu şeyderinə çevirir"


msgid "Import All Materials"
msgstr "Bütün materialları idxal et"


msgid "Also import materials that are not used by any geometry. Note that when this option is false, materials referenced by geometry will still be imported"
msgstr "Heç bir həndəsə tərəfindən istifadə olunmayan materialları da idxal edir. Qeyd: bu seçim söndürülüdürsə, həndəsə tərəfindən istinad edilən materiallar yenə də idxal olunacaq"


msgid "Defined Primitives Only"
msgstr "Yalnız müəyyən edilmiş primitivlər"


msgid "Import only defined USD primitives. When disabled this allows importing USD primitives which are not defined, such as those with an override specifier"
msgstr "Yalnız təyin olunmuş USD primitivlərini idxal edir. Söndürüldükdə, override spesifikatoru olanlar kimi təyin olunmamış USD primitivlərinin idxalına icazə verilir"


msgid "Import guide geometry"
msgstr "Bələdçi həndəsəsini idxal et"


msgid "Import proxy geometry"
msgstr "Proksi həndəsəni idxal et"


msgid "Import final render geometry"
msgstr "Son render həndəsəsini idxal et"


msgid "USD Shapes"
msgstr "USD formaları"


msgid "Import Subdivision Scheme"
msgstr "İdxal bölünmə sxemi"


msgid "Create subdivision surface modifiers based on the USD SubdivisionScheme attribute"
msgstr "USD SubdivisionScheme atributuna əsasən bölünmə səth modifikatorları yaradır."


msgid "Textures Directory"
msgstr "Tekstura qovluğu"


msgid "Path to the directory where imported textures will be copied"
msgstr "İdxal olunan teksturaların kopyalanacağı qovluğun yolu"


msgid "Import Textures"
msgstr "Teksturaları idxal et"


msgid "Behavior when importing textures from a USDZ archive"
msgstr "USDZ arxivindən teksturalar idxal edilərkən davranış"


msgid "Don't import textures"
msgstr "Teksturaları idxal etmə"


msgid "Packed"
msgstr "Paketlənmiş"


msgid "Import textures as packed data"
msgstr "Teksturaları paketlənmiş məlumat kimi idxal et"


msgid "Copy files to textures directory"
msgstr "Faylları tekstura qovluğuna kopyala"


msgid "Import USD Preview"
msgstr "USD önizləməsini idxal et"


msgid "Convert UsdPreviewSurface shaders to Principled BSDF shader networks"
msgstr "UsdPreviewSurface şeyderlərini Principled BSDF şeyder şəbəkələrinə çevirir"


msgid "Visible Primitives Only"
msgstr "Yalnız görünən primitivlər"


msgid "Do not import invisible USD primitives. Only applies to primitives with a non-animated visibility attribute. Primitives with animated visibility will always be imported"
msgstr "Görünməz USD primitivlərini idxal etmir. Yalnız animasiya olunmamış görünürlük atributu olan primitivlərə tətbiq olunur. Animasiyalı görünürlüyü olan primitivlər həmişə idxal olunacaq"


msgid "Light Intensity Scale"
msgstr "İşıq intensivliyi miqyası"


msgid "Scale for the intensity of imported lights"
msgstr "İdxal olunmuş işıqların intensivliyi üçün miqyas"


msgid "Allow USD primitives to merge with their Xform parent if they are the only child in the hierarchy"
msgstr "Yalnız iyerarxiyada yeganə uşaq olduqda USD primitivlərinin Xform valideyni ilə birləşməsinə icazə verir"


msgid "Import each USD material as a unique Blender material"
msgstr "Hər USD materialını unikal Blender materialı kimi idxal edir"


msgid "Material Purpose"
msgstr "Material təyinatı"


msgid "Attempt to import materials with the given purpose. If no material with this purpose is bound to the primitive, fall back on loading any other bound material"
msgstr "Verilmiş təyinatlı materialları idxal etməyə cəhd edir. Bu təyinatlı material primitivə bağlı deyilsə, hər hansı digər bağlı materialı yükləməyə keçir"


msgid "All Purpose"
msgstr "Ümumi məqsədli"


msgid "Attempt to import 'allPurpose' materials."
msgstr "'allPurpose' materiallarını idxal etməyə çalışır."


msgid "Attempt to import 'preview' materials. Load 'allPurpose' materials as a fallback"
msgstr "'preview' materiallarını idxal etməyə cəhd edir. Ehtiyat variant kimi 'allPurpose' materiallarını yükləyir."


msgid "Attempt to import 'full' materials. Load 'allPurpose' or 'preview' materials, in that order, as a fallback"
msgstr "'Tam' materialları idxal etməyə çalışır. Geri dönüş kimi, 'allPurpose' və ya 'preview' materiallarını bu ardıcıllıqla yükləyir"


msgid "Path Mask"
msgstr "Yol maskası"


msgid "Import only the primitive at the given path and its descendants. Multiple paths may be specified in a list delimited by commas or semicolons"
msgstr "Yalnız verilmiş yoldakı primitivi və onun törəmələrini idxal edir. Vergüllə və ya nöqtəli vergüllə ayrılmış siyahıda bir neçə yol göstərilə bilər"


msgid "Behavior when importing USD attributes as Blender custom properties"
msgstr "USD atributlarını Blender fərdi xüsusiyyətləri kimi idxal edərkən davranış"


msgid "Do not import USD custom attributes"
msgstr "USD fərdi atributlarını idxal etmə"


msgid "Import USD attributes in the 'userProperties' namespace as Blender custom properties. The namespace will be stripped from the property names"
msgstr "USD atributlarını 'userProperties' ad fəzasında Blender fərdi xüsusiyyətləri kimi idxal edir. Ad fəzası xüsusiyyət adlarından silinəcək"


msgid "All Custom"
msgstr "Bütün fərdi"


msgid "Import all USD custom attributes as Blender custom properties. Namespaces will be retained in the property names"
msgstr "Bütün USD xüsusi atributlarını Blender xüsusi xüsusiyyətləri kimi idxal edir. Ad fəzaları xüsusiyyət adlarında saxlanılacaq"


msgid "Mesh Attributes"
msgstr "Mesh atributları"


msgid "Read USD Primvars as mesh attributes"
msgstr "USD Primvars-ı mesh atributları kimi oxu"


msgid "Read mesh color attributes"
msgstr "Mesh rəng atributlarını oxu"


msgid "Read mesh UV coordinates"
msgstr "Mesh UV koordinatlarını oxu"


msgid "Update the scene's start and end frame to match those of the USD archive"
msgstr "Səhnənin başlanğıc və son kadrlarını USD arxivinin kadrları ilə uyğunlaşdırır"


msgid "Set Material Blend"
msgstr "Material qarışığını təyin et"


msgid "If the Import USD Preview option is enabled, the material blend method will automatically be set based on the shader's opacity and opacityThreshold inputs"
msgstr "USD Önbaxışını idxal et seçimi aktivdirsə, material qarışdırma metodu şeyderin opacity və opacityThreshold girişlərinə əsasən avtomatik təyin olunacaq"


msgid "Scene Instancing"
msgstr "Səhnə nüsxələnməsi"


msgid "Import USD scene graph instances as collection instances"
