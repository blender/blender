msgstr "Diffuz şüadır"


msgid "Is Glossy Ray"
msgstr "Parlaq şüa mı"


msgid "Is Singular Ray"
msgstr "Təkil şüa"


msgid "Is Reflection Ray"
msgstr "Əks olunma şüası"


msgid "Is Transmission Ray"
msgstr "İletim şüasıdırmı"


msgid "Is Volume Scatter Ray"
msgstr "Həcm səpilmə şüasıdır"


msgid "Ray Depth"
msgstr "Şüa dərinliyi"


msgid "Diffuse Depth"
msgstr "Diffuz dərinlik"


msgid "Glossy Depth"
msgstr "Parlaq dərinlik"


msgid "Transparent Depth"
msgstr "Şəffaf dərinlik"


msgid "Transmission Depth"
msgstr "Ötürmə dərinliyi"


msgid "Portal Depth"
msgstr "Portal dərinliyi"


