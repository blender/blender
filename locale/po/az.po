msgstr "Hədəf kadr"


msgid "Destination frame"
msgstr "Təyinat kadrı"


msgid "Only Selected Keyframes"
msgstr "Yalnız seçilmiş açar kadrlar"


msgid "Convert only selected keyframes"
msgstr "Yalnız seçilmiş açar kadrları çevirir"


msgid "Projection Type"
msgstr "Proyeksiya növü"


msgid "No Reproject"
msgstr "Yenidən proyeksiya yoxdur"


msgid "Reproject the strokes using the X-Z plane"
msgstr "Cizgiləri X-Z müstəvisindən istifadə edərək yenidən proyeksiya et"


msgid "Reproject the strokes using the Y-Z plane"
