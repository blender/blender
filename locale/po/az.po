msgstr "Format təqdim olunandan daha çox giriş istifadə edir."


msgid "Invalid identifier: \"{}\""
msgstr "Yanlış identifikator: \"{}\""


msgid "An input name cannot start with a digit: \"{}\""
msgstr "Giriş adı rəqəmlə başlaya bilməz: \"{}\""


msgid "There are no inputs."
