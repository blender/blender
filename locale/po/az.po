msgstr "Seçilmiş açar kadrların tutacaqlarının bərabər uzunluqda olmasını təmin edir, istəyə görə onları üfüqi edir. Automatic, Automatic Clamped və ya Vector tutacaq növləri Aligned-ə çevriləcək"


msgid "Flatten"
msgstr "Düzləşdir"


msgid "Make the values of the selected keyframes' handles the same as their respective keyframes"
msgstr "Seçilmiş açar kadrların tutacaqlarının qiymətlərini onların müvafiq açar kadrları ilə eyniləşdirir"


msgid "Handle Length"
msgstr "Tutacaq uzunluğu"


msgid "Length to make selected keyframes' Bézier handles"
msgstr "Seçilmiş açar kadrların Bézier tutacaqlarını yaratmaq üçün uzunluq"


msgid "Side"
msgstr "Tərəf"


msgid "Side of the keyframes' Bézier handles to affect"
msgstr "Təsir ediləcək açar kadrların Bézier tutacaqlarının tərəfi"


msgid "Equalize selected keyframes' left handles"
msgstr "Seçilmiş açar kadrların sol tutacaqlarını bərabərləşdir"


msgid "Equalize selected keyframes' right handles"
msgstr "Seçilmiş açar kadrların sağ tutacaqlarını bərabərləşdir"


msgid "Equalize both of a keyframe's handles"
msgstr "Açar kadrın hər iki tutacağını bərabərləşdirir"


msgctxt "Operator"
