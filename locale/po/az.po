msgstr "Daha hamar keçid üçün tutacaqları düzləşdirir"


msgctxt "Operator"
msgid "Snap Cursor Value to Selected"
msgstr "Kursor dəyərini seçilmişə yapışdır"


msgid "Place the cursor value on the average value of selected keyframes"
msgstr "Kursor dəyərini seçilmiş açar kadrların orta dəyərinə yerləşdirir"


msgctxt "Operator"
