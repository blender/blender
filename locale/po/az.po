msgstr "Naməlum"


msgid "Format Items"
msgstr "Elementləri formatla"


msgid "Unescaped '}' in format string"
msgstr "Format sətrində qaçırılmamış '}'"


msgid "Empty identifier cannot be used when explicit identifier was used before. For example, \"{} {x}\" is ok but \"{x} {}\" is not."
msgstr "Açıq identifikator əvvəl istifadə edildikdə boş identifikator istifadə oluna bilməz. Məsələn, \"{} {x}\" olar, lakin \"{x} {}\" olmaz."


