msgstr "Vuruş müddətində maska fırçasına keçir"


msgctxt "Operator"
msgid "Stroke Mode"
msgstr "Cizgi rejimi"


msgid "Action taken when a paint stroke is made"
msgstr "Boya cizgisi çəkildikdə görülən hərəkət"


msgctxt "Operator"
msgid "Regular"
msgstr "Adi"


msgctxt "Operator"
msgid "Invert"
