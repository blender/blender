msgid "Light scattering distribution on rough surface"
msgstr "ﺮﺑﺯ ﺢﻄﺳ ﯼﻭﺭ ﺭﻮﻧ ﯽﮔﺪﻨﮐﺍﺮﭘ ﻊﯾﺯﻮﺗ"


msgid "Beckmann"
msgstr "ﻦﻤﮑﺑ"


msgid "GGX"
msgstr "GGX"


