msgctxt "Action"
msgid "Keyframe"
msgstr "ﯼﺪﯿﻠﮐ ﻢﯾﺮﻓ"


msgctxt "Action"
msgid "Breakdown"
msgstr "ﻂﺳﺍﻭ"


msgctxt "Action"
