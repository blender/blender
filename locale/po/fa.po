msgstr "ﯼﺍ‌ﻪﻠﭘ ﯽﺑﺎﯾ‌ﻥﻭﺭﺩ"


msgid "Snap values to nearest grid step, e.g. for a stop-motion look"
msgstr "ﻦﺷﻮﻣ‌ﭖﺎﺘﺳﺍ ﯽﯾﺎﻤﻧﺎﯾﻮﭘ ﻩٔﻮﻠﺟ ﯼﺍﺮﺑ ﻼً﻿ﺜﻣ ،ﻪﮑﺒﺷ ﻡﺎﮔ ﻦﯾﺮﺗ‌ﮏﯾﺩﺰﻧ ﻪﺑ ﺮﯾﺩﺎﻘﻣ ﻥﺪﻧﺎﺒﺴﭼ"


msgctxt "Action"
msgid "Smooth (Gaussian)"
msgstr "(ﯽﺳﻭﺎﮔ) ﯼﺯﺎﺳﺭﺍﻮﻤﻫ"


msgid "Smooth curve using Gaussian smoothing"
msgstr "ﯽﺳﻭﺎﮔ ﺵﻭﺭ ﺎﺑ ﯽﻨﺤﻨﻣ ﯼﺯﺎﺳﺭﺍﻮﻤﻫ"


msgid "Use Influence"
msgstr "ﺮﯿﺛﺄﺗ ﺯﺍ ﻩﺩﺎﻔﺘﺳﺍ"


msgid "F-Curve Modifier's effects will be tempered by a default factor"
msgstr "ﺪﻧﻮﺷ‌ﯽﻣ ﻞﯾﺪﻌﺗ ﺽﺮﻓ‌ﺶﯿﭘ ﺐﯾﺮﺿ ﮏﯾ ﺎﺑ F ﯽﻨﺤﻨﻣ ﻩٔﺪﻨﻨﮐ‌ﺡﻼ﻿ﺻﺍ ﯼﺎﻫﺮﺛﺍ"


msgid "Restrict Frame Range"
msgstr "ﻢﯾﺮﻓ ﻩٔﺯﺎﺑ ﻥﺩﺮﮐﺩﻭﺪﺤﻣ"


msgid "F-Curve Modifier is only applied for the specified frame range to help mask off effects in order to chain them"
msgstr "ﺩﺮﮐ ﻩﺮﯿﺠﻧﺯ ﻭ ﮏﺳﺎﻣ ﺍﺭ ﺎﻫﺮﺛﺍ ﻥﺍﻮﺘﺑ ﺎﺗ ﺩﻮﺷ‌ﯽﻣ ﻝﺎﻤﻋﺍ ﻩﺪﺷ‌ﺺﺨﺸﻣ ﻢﯾﺮﻓ ﻩٔﺯﺎﺑ ﺭﺩ ﻂﻘﻓ F ﯽﻨﺤﻨﻣ ﻩٔﺪﻨﻨﮐ‌ﺡﻼ﻿ﺻﺍ"


msgid "Cycles F-Modifier"
msgstr "F ﯼﺍ‌ﻪﺧﺮﭼ ﻩٔﺪﻨﻨﮐ‌ﺡﻼ﻿ﺻﺍ"


msgid "Repeat the values of the modified F-Curve"
msgstr "ﻩﺪﺷ‌ﺡﻼ﻿ﺻﺍ F ﯽﻨﺤﻨﻣ ﺮﯾﺩﺎﻘﻣ ﺭﺍﺮﮑﺗ"


msgid "After Cycles"
msgstr "ﻦﯿﺴﭘ ﯼﺎﻫ‌ﻪﺧﺮﭼ"


msgid "Maximum number of cycles to allow after last keyframe (0 = infinite)"
msgstr "(ﺖﯾﺎﻬﻧ‌ﯽﺑ = ۰) ﻢﯾﺮﻓ‌ﯽﮐ ﻦﯾﺮﺧﺁ ﺯﺍ ﺲﭘ ﺯﺎﺠﻣ ﻪٔﺧﺮﭼ ﺩﺍﺪﻌﺗ ﺮﺜﮐﺍﺪﺣ"


msgid "Before Cycles"
msgstr "ﻦﯿﺸﯿﭘ ﯼﺎﻫ‌ﻪﺧﺮﭼ"


msgid "Maximum number of cycles to allow before first keyframe (0 = infinite)"
msgstr "(ﺖﯾﺎﻬﻧ‌ﯽﺑ = ۰) ﻢﯾﺮﻓ‌ﯽﮐ ﻦﯿﺘﺴﺨﻧ ﺯﺍ ﺶﯿﭘ ﺯﺎﺠﻣ ﻪٔﺧﺮﭼ ﺩﺍﺪﻌﺗ ﺮﺜﮐﺍﺪﺣ"


msgid "After Mode"
msgstr "ﯼﺪﻌﺑ ﺖﻟﺎﺣ"


msgid "Cycling mode to use after last keyframe"
msgstr "ﻢﯾﺮﻓ‌ﯽﮐ ﻦﯾﺮﺧﺁ ﺯﺍ ﺲﭘ ﻪﺧﺮﭼ ﺖﻟﺎﺣ"


msgid "No Cycles"
msgstr "ﻪﺧﺮﭼ ﻥﻭﺪﺑ"


msgid "Don't do anything"
msgstr "ﻩﺪﻧ ﻡﺎﺠﻧﺍ ﯼﺭﺎﮐ ﭻﯿﻫ"


msgid "Repeat Motion"
msgstr "ﺖﮐﺮﺣ ﺭﺍﺮﮑﺗ"


msgid "Repeat keyframe range as-is"
