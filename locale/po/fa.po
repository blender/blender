msgstr "ﯽﻨﮑﻓﺍﺮﻓ ﺭﻮﺤﻣ"


msgid "Axis constrain to"
msgstr "ﺩﻮﺷ ﺩﻭﺪﺤﻣ ﻥﺁ ﻪﺑ ﺪﯾﺎﺑ ﻪﮐ ﯼﺭﻮﺤﻣ"


msgid "Axis Space"
msgstr "ﺭﻮﺤﻣ ﯼﺎﻀﻓ"


msgid "Space for the projection axis"
msgstr "ﯽﻨﮑﻓﺍﺮﻓ ﺭﻮﺤﻣ ﯼﺎﻀﻓ"


msgid "Project Distance"
msgstr "ﯽﻨﮑﻓﺍﺮﻓ ﻪٔﻠﺻﺎﻓ"


msgid "Limit the distance used for projection (zero disables)"
msgstr "(ﺪﻨﮐ‌ﯽﻣ ﻝﺎﻌﻓﺮﯿﻏ ﺮﻔﺻ) ﯽﻨﮑﻓﺍﺮﻓ ﻪٔﻠﺻﺎﻓ ﻥﺩﺮﮐﺩﻭﺪﺤﻣ"


msgid "Shrinkwrap Type"
msgstr "ﺢﻄﺳ ﻪﺑ ﻥﺪﻧﺎﺒﺴﭼ ﻉﻮﻧ"


msgid "Select type of shrinkwrap algorithm for target position"
msgstr "ﻑﺪﻫ ﺖﯿﻌﻗﻮﻣ ﯼﺍﺮﺑ ﺢﻄﺳ ﻪﺑ ﻥﺪﻧﺎﺒﺴﭼ ﻢﺘﯾﺭﻮﮕﻟﺍ ﻉﻮﻧ ﺏﺎﺨﺘﻧﺍ"


msgid "Nearest Surface Point"
msgstr "ﺢﻄﺳ ﻪٔﻄﻘﻧ ﻦﯾﺮﺗ‌ﮏﯾﺩﺰﻧ"


msgid "Shrink the location to the nearest target surface"
msgstr "ﻑﺪﻫ ﺢﻄﺳ ﻦﯾﺮﺗ‌ﮏﯾﺩﺰﻧ ﻪﺑ ﺖﯿﻌﻗﻮﻣ ﻥﺪﻧﺎﺒﺴﭼ"


msgid "Project"
msgstr "ﺭﻮﺘﮐﮊﻭﺮﭘ"


msgid "Shrink the location to the nearest target surface along a given axis"
msgstr "ﺺﺨﺸﻣ ﺭﻮﺤﻣ ﮏﯾ ﺩﺍﺪﺘﻣﺍ ﺭﺩ ﻑﺪﻫ ﺢﻄﺳ ﻦﯾﺮﺗ‌ﮏﯾﺩﺰﻧ ﻪﺑ ﺖﯿﻌﻗﻮﻣ ﻥﺪﻧﺎﺒﺴﭼ"


msgid "Nearest Vertex"
msgstr "ﺱﺃﺭ ﻦﯾﺮﺗ‌ﮏﯾﺩﺰﻧ"


msgid "Shrink the location to the nearest target vertex"
msgstr "ﻑﺪﻫ ﺱﺃﺭ ﻦﯾﺮﺗ‌ﮏﯾﺩﺰﻧ ﻪﺑ ﺖﯿﻌﻗﻮﻣ ﻥﺪﻧﺎﺒﺴﭼ"


msgid "Target Normal Project"
msgstr "ﻑﺪﻫ ﻝﺎﻣﺮﻧ ﯽﻨﮑﻓﺍﺮﻓ"


msgid "Shrink the location to the nearest target surface along the interpolated vertex normals of the target"
msgstr "ﻑﺪﻫ ﻩٔﺪﺷ‌ﯽﺑﺎﯾ‌ﻥﻭﺭﺩ ﺱﺃﺭ ﯼﺎﻫ‌ﻝﺎﻣﺮﻧ ﺩﺍﺪﺘﻣﺍ ﺭﺩ ﻑﺪﻫ ﺢﻄﺳ ﻦﯾﺮﺗ‌ﮏﯾﺩﺰﻧ ﻪﺑ ﺖﯿﻌﻗﻮﻣ ﻥﺪﻧﺎﺒﺴﭼ"


msgid "Target Mesh object"
msgstr "ﻑﺪﻫ ﺶﻣ ءﯽﺷ"


msgid "Axis that is aligned to the normal"
msgstr "ﺩﻮﺷ‌ﯽﻣ ﺎﺘﺳﺍﺭ‌ﻢﻫ ﻝﺎﻣﺮﻧ ﺎﺑ ﻪﮐ ﯼﺭﻮﺤﻣ"


