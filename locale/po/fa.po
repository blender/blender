msgid "Set color and opacity attributes on Grease Pencil geometry"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﻢﯿﻈﻨﺗ ﺲﯾﺮﮔ ﺩﺍﺪﻣ ﻪٔﺳﺪﻨﻫ ﯼﻭﺭ ﺍﺭ ﯽﮔﺮﯿﺗ ﻭ ﮓﻧﺭ ﯼﺎﻫ‌ﯽﮔﮋﯾﻭ"


msgid "Set the color and opacity for strokes or fills"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﻢﯿﻈﻨﺗ ﺍﺭ ﺎﻫ‌ﯽﮔﺪﺷﺮﭘُ ﺎﯾ ﺎﻫ‌ﻂﺧ ﯽﮔﺮﯿﺗ ﻭ ﮓﻧﺭ"


msgid "Set the color and opacity for the points of the stroke"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﻢﯿﻈﻨﺗ ﺍﺭ ﻂﺧ ﻁﺎﻘﻧ ﯽﮔﺮﯿﺗ ﻭ ﮓﻧﺭ"


msgid "Set the color and opacity for the stroke fills"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﻢﯿﻈﻨﺗ ﺍﺭ ﻂﺧ ﯼﺎﻫ‌ﯽﮔﺪﺷﺮﭘُ ﯽﮔﺮﯿﺗ ﻭ ﮓﻧﺭ"


msgid "Both"
msgstr "ﻭﺩ ﺮﻫ"


msgid "Set the color and opacity for stroke points and fills together"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﻢﯿﻈﻨﺗ ﻥﺎﻣﺯ‌ﻢﻫ ﺍﺭ ﺎﻫ‌ﯽﮔﺪﺷﺮﭘُ ﻭ ﻂﺧ ﻁﺎﻘﻧ ﯽﮔﺮﯿﺗ ﻭ ﮓﻧﺭ"


msgid "Set Grease Pencil Depth"
msgstr "ﺲﯾﺮﮔ ﺩﺍﺪﻣ ﻖﻤﻋ ﻢﯿﻈﻨﺗ"


msgid "Set the Grease Pencil depth order to use"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﻢﯿﻈﻨﺗ ﻩﺩﺎﻔﺘﺳﺍ ﯼﺍﺮﺑ ﺍﺭ ﺲﯾﺮﮔ ﺩﺍﺪﻣ ﻖﻤﻋ ﺐﯿﺗﺮﺗ"


msgid "Depth Order"
msgstr "ﻖﻤﻋ ﺐﯿﺗﺮﺗ"


msgid "Set Grease Pencil Softness"
msgstr "ﺲﯾﺮﮔ ﺩﺍﺪﻣ ﯽﻣﺮﻧ ﻢﯿﻈﻨﺗ"


msgid "Set softness attribute on Grease Pencil geometry"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﻢﯿﻈﻨﺗ ﺲﯾﺮﮔ ﺩﺍﺪﻣ ﻪٔﺳﺪﻨﻫ ﯼﻭﺭ ﺍﺭ ﯽﻣﺮﻧ ﯽﮔﮋﯾﻭ"


msgid "Set Grid Background"
msgstr "ﻪﮑﺒﺷ ﻪٔﻨﯿﻣﺯ‌ﺲﭘ ﻢﯿﻈﻨﺗ"


msgid "Set the background value used for inactive voxels and tiles"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﻢﯿﻈﻨﺗ ﺍﺭ ﻝﺎﻌﻓﺮﯿﻏ ﯼﺎﻫ‌ﯽﺷﺎﮐ ﻭ ﺎﻫ‌ﻞﺴﮐﻭ ﯼﺍﺮﺑ ﻩﺩﺎﻔﺘﺳﺍ ﺩﺭﻮﻣ ﻪٔﻨﯿﻣﺯ‌ﺲﭘ ﺭﺍﺪﻘﻣ"


