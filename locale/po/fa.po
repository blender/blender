msgstr "ﻑﺬﺣ ﻥﻭﺪﺑ"


msgid "Front"
msgstr "ﻮﻠﺟ"


msgid "No projection when in front of the face"
msgstr "ﺩﻮﺸﻧ ﯽﻨﮑﻓﺍﺮﻓ ﺪﺷﺎﺑ ﻪﺟﻭ ﯼﻮﻠﺟ ﺮﮔﺍ"


msgid "Back"
msgstr "ﺐﻘﻋ"


msgid "No projection when behind the face"
msgstr "ﺩﻮﺸﻧ ﯽﻨﮑﻓﺍﺮﻓ ﺪﺷﺎﺑ ﻪﺟﻭ ﺖﺸﭘ ﺮﮔﺍ"


msgid "Distance to Target"
msgstr "ﻑﺪﻫ ﺎﺗ ﻪﻠﺻﺎﻓ"


