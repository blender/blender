msgctxt "Action"
msgid "Bounce"
msgstr "ﻥﺍﻮﺨﺘﺳﺍ"


msgid "Exponentially decaying parabolic bounce, like when objects collide"
msgstr "ﺎﯿﺷﺍ ﺩﺭﻮﺧﺮﺑ ﺪﻨﻧﺎﻣ ،ﯽﯾﺎﻤﻧ ﺖﻓﺍ ﺎﺑ ﺭﺍﻭ‌ﯽﻤﻬﺳ ﺶﻬﺟ"


msgctxt "Action"
msgid "Elastic"
