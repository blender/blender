msgstr "(ﻝﺮﺘﻨﮐ ﻪٔﻄﻘﻧ ﺯﺍ ﺶﯿﭘ) ﭗﭼ ﻩٔﺮﯿﮕﺘﺳﺩ ﺕﺎﺼﺘﺨﻣ"


msgid "Left Handle Type"
msgstr "ﭗﭼ ﻩٔﺮﯿﮕﺘﺳﺩ ﻉﻮﻧ"


msgid "Completely independent manually set handle"
msgstr "ﻞﻘﺘﺴﻣ ﻼً﻿ﻣﺎﮐ ﯽِﺘﺳﺩ ﻩٔﺮﯿﮕﺘﺳﺩ"


msgid "Manually set handle with rotation locked together with its pair"
msgstr "ﺶﺘﻔﺟ ﻪﺑ ﺖﺒﺴﻧ ﻩﺪﺷ‌ﻞﻔﻗ ﺶﺧﺮﭼ ﺎﺑ ﯽﺘﺳﺩ ﻩٔﺮﯿﮕﺘﺳﺩ"


msgid "Automatic handles that create straight lines"
msgstr "ﺪﻧﺯﺎﺳ‌ﯽﻣ ﻢﯿﻘﺘﺴﻣ ﻂﺧ ﻪﮐ ﯼﺭﺎﮐﺩﻮﺧ ﯼﺎﻫ‌ﻩﺮﯿﮕﺘﺳﺩ"


msgid "Automatic handles that create smooth curves"
msgstr "ﺪﻧﺯﺎﺳ‌ﯽﻣ ﺭﺍﻮﻤﻫ ﯼﺎﻫ‌ﯽﻨﺤﻨﻣ ﻪﮐ ﯼﺭﺎﮐﺩﻮﺧ ﯼﺎﻫ‌ﻩﺮﯿﮕﺘﺳﺩ"


msgid "Auto Clamped"
msgstr "ﻩﺪﺷﺩﻭﺪﺤﻣ ﺭِﺎﮐﺩﻮﺧ"


msgid "Automatic handles that create smooth curves which only change direction at keyframes"
msgstr "ﺪﻨﻫﺩ‌ﯽﻣ ﺖﻬﺟ ﺮﯿﯿﻐﺗ ﯼﺪﯿﻠﮐ ﯼﺎﻫ‌ﻢﯾﺮﻓ ﺭﺩ ﻂﻘﻓ ﻭ ﺪﻧﺯﺎﺳ‌ﯽﻣ ﺭﺍﻮﻤﻫ ﯽﻨﺤﻨﻣ ﻪﮐ ﯼﺭﺎﮐﺩﻮﺧ ﯼﺎﻫ‌ﻩﺮﯿﮕﺘﺳﺩ"


msgid "Right Handle"
msgstr "ﺖﺳﺍﺭ ﻩٔﺮﯿﮕﺘﺳﺩ"


msgid "Coordinates of the right handle (after the control point)"
msgstr "(ﻝﺮﺘﻨﮐ ﻪٔﻄﻘﻧ ﺯﺍ ﺲﭘ) ﺖﺳﺍﺭ ﻩٔﺮﯿﮕﺘﺳﺩ ﺕﺎﺼﺘﺨﻣ"


msgid "Right Handle Type"
msgstr "ﺖﺳﺍﺭ ﻩٔﺮﯿﮕﺘﺳﺩ ﻉﻮﻧ"


msgctxt "Action"
msgid "Interpolation"
msgstr "ﯽﺑﺎﯾ‌ﻥﻭﺭﺩ"


msgid "Interpolation method to use for segment of the F-Curve from this Keyframe until the next Keyframe"
msgstr "ﯼﺪﻌﺑ ﯼﺪﯿﻠﮐ‌ﻢﯾﺮﻓ ﺎﺗ ﯼﺪﯿﻠﮐ‌ﻢﯾﺮﻓ ﻦﯾﺍ ﺯﺍ F ﯽﻨﺤﻨﻣ ﻪٔﻌﻄﻗ ﯽﺑﺎﯾ‌ﻥﻭﺭﺩ ﺵﻭﺭ"


msgctxt "Action"
msgid "Constant"
msgstr "ﺖﺑﺎﺛ"


msgid "No interpolation, value of A gets held until B is encountered"
msgstr "ﺩﻮﺷ‌ﯽﻣ ﻆﻔﺣ B ﻪﺑ ﻥﺪﯿﺳﺭ ﺎﺗ A ﺭﺍﺪﻘﻣ ؛ﯽﺑﺎﯾ‌ﻥﻭﺭﺩ ﻥﻭﺪﺑ"


msgctxt "Action"
msgid "Linear"
msgstr "ﯽﻄﺧ"


msgid "Straight-line interpolation between A and B (i.e. no ease in/out)"
msgstr "(ﺎﻬﺘﻧﺍ ﺎﯾ ﺍﺪﺘﺑﺍ ﻥﺪﺷ‌ﻡﺮﻧ ﻥﻭﺪﺑ) B ﻭ A ﻦﯿﺑ ﻢﯿﻘﺘﺴﻣ ﻂﺧ ﯽﺑﺎﯾ‌ﻥﻭﺭﺩ"


msgctxt "Action"
msgid "Bézier"
msgstr "ﻪﯾﺰﺑ"


msgid "Smooth interpolation between A and B, with some control over curve shape"
msgstr "ﯽﻨﺤﻨﻣ ﻞﮑﺷ ﻝﺮﺘﻨﮐ ﻥﺎﮑﻣﺍ ﺎﺑ B ﻭ A ﻦﯿﺑ ﺭﺍﻮﻤﻫ ﯽﺑﺎﯾ‌ﻥﻭﺭﺩ"


msgctxt "Action"
msgid "Sinusoidal"
msgstr "ﯽﺳﻮﻨﯿﺳ"


msgid "Sinusoidal easing (weakest, almost linear but with a slight curvature)"
msgstr "(ﺎﻨﺤﻧﺍ ﯽﮐﺪﻧﺍ ﺎﺑ ﯽﻄﺧ ﺎًﺒﯾﺮﻘﺗ ؛ﻦﯾﺮﺗ‌ﻒﯿﻌﺿ) ﯽﺳﻮﻨﯿﺳ ﯼﺯﺎﺳ‌ﻡﺮﻧ"


msgctxt "Action"
msgid "Quadratic"
msgstr "ﻭﺩ‌ﻪﺟﺭﺩ"


msgid "Quadratic easing"
msgstr "ﻭﺩ‌ﻪﺟﺭﺩ ﯼﺯﺎﺳ‌ﻡﺮﻧ"


msgctxt "Action"
msgid "Cubic"
msgstr "ﯽﺒﻌﮑﻣ"


msgid "Cubic easing"
msgstr "ﻪﺳ‌ﻪﺟﺭﺩ ﯼﺯﺎﺳ‌ﻡﺮﻧ"


msgctxt "Action"
msgid "Quartic"
msgstr "ﺭﺎﻬﭼ‌ﻪﺟﺭﺩ"


msgid "Quartic easing"
msgstr "ﺭﺎﻬﭼ‌ﻪﺟﺭﺩ ﯼﺯﺎﺳ‌ﻡﺮﻧ"


msgctxt "Action"
msgid "Quintic"
msgstr "ﺞﻨﭘ‌ﻪﺟﺭﺩ"


msgid "Quintic easing"
msgstr "ﺞﻨﭘ‌ﻪﺟﺭﺩ ﯼﺯﺎﺳ‌ﻡﺮﻧ"


msgctxt "Action"
msgid "Exponential"
msgstr "ﯽﯾﺎﻤﻧ"


msgid "Exponential easing (dramatic)"
msgstr "(ﺪﯾﺪﺷ) ﯽﯾﺎﻤﻧ ﯼﺯﺎﺳ‌ﻡﺮﻧ"


msgctxt "Action"
msgid "Circular"
msgstr "ﯼﺍ‌ﻩﺮﯾﺍﺩ"


msgid "Circular easing (strongest and most dynamic)"
msgstr "(ﻦﯾﺮﺗﺎﯾﻮﭘ ﻭ ﻦﯾﺮﺗ‌ﯼﻮﻗ) ﯼﺍ‌ﻩﺮﯾﺍﺩ ﯼﺯﺎﺳ‌ﻡﺮﻧ"


