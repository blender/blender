msgstr "(ﺪﻨﻫﺩ‌ﯽﻣ ﺶﯾﺍﺰﻓﺍ ﺰﯿﻧ ﺍﺭ ﺭﺪﻧﺭ ﻥﺎﻣﺯ ﺎﻣﺍ ،ﺪﻨﻫﺩ‌ﯽﻣ ﺮﺗ‌ﺕﺎﯿﺋﺰﺟﺮﭘ ﻭ ﺮﺗ‌ﻖﯿﻗﺩ ﯼﺍ‌ﻪﺠﯿﺘﻧ ﺮﺘﻤﮐ ﺮﯾﺩﺎﻘﻣ) ﻦﮐ ﯼﺪﻨﺑ‌ﺱﺎﯿﻘﻣ ﺭﺪﻧﺭ ﻡﺎﮕﻨﻫ ﺍﺭ ﻢﺠﺣ ﻥﺯ‌ﻪﯾﺎﺳ ﯼﺎﻫ‌ﻪﻧﻮﻤﻧ ﻥﺎﯿﻣ ﻪٔﻠﺻﺎﻓ"


msgid "AO Distance"
msgstr "ﯽﻄﯿﺤﻣ ﺩﺍﺪﺴﻧﺍ ﻪٔﻠﺻﺎﻓ"


msgid "AO distance used for approximate global illumination (0 means use world setting)"
msgstr "(ﻥﺎﻬﺟ ﺕﺎﻤﯿﻈﻨﺗ ﺯﺍ ﻩﺩﺎﻔﺘﺳﺍ ﯽﻨﻌﯾ ۰) ﯽﺒﯾﺮﻘﺗ ﯼﺮﺳﺍﺮﺳ ﯽﯾﺎﻨﺷﻭﺭ ﯼﺍﺮﺑ ﯽﻄﯿﺤﻣ ﺩﺍﺪﺴﻧﺍ ﻪٔﻠﺻﺎﻓ"


msgid "Cast Shadow Caustics"
msgstr "ﻪﯾﺎﺳ ﮏﯿﺘﺳﺎﮐ ﺩﺎﺠﯾﺍ"


msgid "With refractive materials, generate approximate caustics in shadows of this object. Up to 10 bounces inside this object are taken into account. Lights, caster and receiver objects must have shadow caustics options set to enable this"
msgstr "ﺪﺷﺎﺑ ﻩﺪﺷ ﻢﯿﻈﻨﺗ ﻩﺪﻨﻨﮐ‌ﺖﻓﺎﯾﺭﺩ ﻭ ﻩﺪﻨﻨﮐﺩﺎﺠﯾﺍ ﯼﺎﯿﺷﺍ ﻭ ﺎﻫﺭﻮﻧ ﯼﺍﺮﺑ ﺪﯾﺎﺑ ﻪﯾﺎﺳ ﮏﯿﺘﺳﺎﮐ ﻪٔﻨﯾﺰﮔ ،ﯼﺯﺎﺳ‌ﻝﺎﻌﻓ ﯼﺍﺮﺑ .ﺩﻮﺷ‌ﯽﻣ ﻪﺒﺳﺎﺤﻣ ءﯽﺷ ﻦﯾﺍ ﻥﻭﺭﺩ ﺏﺎﺗﺯﺎﺑ ۱۰ ﺎﺗ .ﻦﮐ ﺩﺎﺠﯾﺍ ءﯽﺷ ﻦﯾﺍ ﯼﺎﻫ‌ﻪﯾﺎﺳ ﺭﺩ ﺍﺭ ﯽﺒﯾﺮﻘﺗ ﯼﺎﻫ‌ﮏﯿﺘﺳﺎﮐ ،ﻩﺪﻨﻫﺩ‌ﺖﺴﮑﺷ ﺩﺍﻮﻣ ﺎﺑ"


msgid "Receive Shadow Caustics"
