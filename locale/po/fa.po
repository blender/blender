msgstr "ﺭﻮﺤﻣ ﺮﻫ ﺭﺩ ﻩﺪﺷ‌ﺏﺎﺨﺘﻧﺍ ﯼﺎﻫ‌ﺱﺃﺭ ﻪٔﺘﺳﻮﭘ ﻉﺎﻌﺷ ﻥﺩﺮﮐﺮﺑﺍﺮﺑ"


msgctxt "Operator"
msgid "Skin Root Mark"
msgstr "ﻪﺘﺳﻮﭘ ﻪٔﺸﯾﺭ ﯼﺭﺍﺬﮔ‌ﺖﻣﻼ﻿ﻋ"


msgid "Mark selected vertices as roots"
msgstr "ﻪﺸﯾﺭ ﻥﺍﻮﻨﻋ‌ﻪﺑ ﻩﺪﺷ‌ﺏﺎﺨﺘﻧﺍ ﯼﺎﻫ‌ﺱﺃﺭ ﯼﺭﺍﺬﮔ‌ﺖﻣﻼ﻿ﻋ"


msgctxt "Operator"
msgid "Add Speaker"
msgstr "ﻮﮔﺪﻨﻠﺑ ﻥﺩﻭﺰﻓﺍ"


msgid "Add a speaker object to the scene"
msgstr "ﻪﻨﺤﺻ ﻪﺑ ﻮﮔﺪﻨﻠﺑ ءﯽﺷ ﻥﺩﻭﺰﻓﺍ"


msgid "Ensure Modifier"
msgstr "ﺮﮔ‌ﺡﻼ﻿ﺻﺍ ﺩﻮﺟﻭ ﺯﺍ ﻥﺎﻨﯿﻤﻃﺍ"


msgid "Create the corresponding modifier if it does not exist"
msgstr "ﻦﮐ ﺩﺎﺠﯾﺍ ﺍﺭ ﺮﻇﺎﻨﺘﻣ ﺮﮔ‌ﺡﻼ﻿ﺻﺍ ،ﺩﻮﺒﻧ ﺕﺭﻮﺻ ﺭﺩ"


msgid "Apply the subdivision surface level as an offset relative to the current level"
msgstr "ﯽﻠﻌﻓ ﺢﻄﺳ ﻪﺑ ﺖﺒﺴﻧ ﯽﯾﺎﺟ‌ﻪﺑﺎﺟ ﺕﺭﻮﺻ‌ﻪﺑ ﻢﯿﺴﻘﺗ‌ﺢﻄﺳ ﺢﻄﺳ ﻝﺎﻤﻋﺍ"


msgctxt "Operator"
msgid "Surface Deform Bind"
msgstr "ﯽﺤﻄﺳ ﻞﮑﺷﺮﯿﯿﻐﺗ ﻝﺎﺼﺗﺍ"


msgid "Bind mesh to target in surface deform modifier"
msgstr "ﯽﺤﻄﺳ ﻞﮑﺷﺮﯿﯿﻐﺗ ﺮﮔ‌ﺡﻼ﻿ﺻﺍ ﺭﺩ ﻑﺪﻫ ﻪﺑ ﺶﻣ ﻝﺎﺼﺗﺍ"


msgctxt "Operator"
msgid "Add Text"
msgstr "ﻦﺘﻣ ﻥﺩﻭﺰﻓﺍ"


msgid "Add a text object to the scene"
msgstr "ﻪﻨﺤﺻ ﻪﺑ ﻦﺘﻣ ءﯽﺷ ﻥﺩﻭﺰﻓﺍ"


msgctxt "Operator"
msgid "Clear Track"
msgstr "ﯽﺑﺎﯾﺩﺭ ﻥﺩﺮﮐ‌ﮎﺎﭘ"


msgid "Clear tracking constraint or flag from object"
msgstr "ءﯽﺷ ﺯﺍ ﯽﺑﺎﯾﺩﺭ ﻢﭼﺮﭘ ﺎﯾ ﺪﯿﻗ ﻥﺩﺮﮐ‌ﮎﺎﭘ"


msgid "Clear Track"
msgstr "ﯽﺑﺎﯾﺩﺭ ﻥﺩﺮﮐ‌ﮎﺎﭘ"


msgid "Clear and Keep Transformation (Clear Track)"
msgstr "ﻞﯾﺪﺒﺗ ﻆﻔﺣ ﻭ ﯽﺑﺎﯾﺩﺭ ﻥﺩﺮﮐ‌ﮎﺎﭘ"


msgctxt "Operator"
msgid "Make Track"
msgstr "ﯽﺑﺎﯾﺩﺭ ﺩﺎﺠﯾﺍ"


msgid "Make the object track another object, using various methods/constraints"
msgstr "ﻥﻮﮔﺎﻧﻮﮔ ﯼﺎﻫﺪﯿﻗ ﺎﯾ ﺎﻫ‌ﺵﻭﺭ ﺎﺑ ﺮﮕﯾﺩ ﯽﺌﯿﺷ ﯽﺑﺎﯾﺩﺭ ﻪﺑ ءﯽﺷ ﻦﺘﺷﺍﺩﺍﻭ"


msgid "Track to Constraint"
msgstr "ﻪﺑ ﯽﺑﺎﯾﺩﺭ ﺪﯿﻗ"


msgid "Lock Track Constraint"
msgstr "ﻩﺪﺷ‌ﻞﻔﻗ ﯽﺑﺎﯾﺩﺭ ﺪﯿﻗ"


msgctxt "Operator"
msgid "Transfer Mode"
msgstr "ﺖﻟﺎﺣ ﻝﺎﻘﺘﻧﺍ"


msgid "Switches the active object and assigns the same mode to a new one under the mouse cursor, leaving the active mode in the current one"
msgstr "ﺪﻧﺎﻣ‌ﯽﻣ ﯽﻗﺎﺑ ﯽﻠﺒﻗ ءﯽﺷ ﯼﻭﺭ ﯽﻠﻌﻓ ﺖﻟﺎﺣ ﻪﮐ‌ﯽﻟﺎﺣﺭﺩ ،ﺱﻭﺎﻣ ﺮﮕﻧﺎﺸﻧ ﺮﯾﺯ ﻩﺯﺎﺗ ءﯽﺷ ﻪﺑ ﺖﻟﺎﺣ ﻥﺎﻤﻫ ﯼﺭﺍﺬﮔﺍﻭ ﻭ ﻝﺎﻌﻓ ءﯽﺷ ﺮﯿﯿﻐﺗ"


msgid "Flash On Transfer"
msgstr "ﻝﺎﻘﺘﻧﺍ ﻡﺎﮕﻨﻫ ﻥﺩﺯ‌ﮏﻤﺸﭼ"


msgid "Flash the target object when transferring the mode"
msgstr "ﺖﻟﺎﺣ ﻝﺎﻘﺘﻧﺍ ﻡﺎﮕﻨﻫ ﺪﺼﻘﻣ ءﯽﺷ ﻥﺩﺯ‌ﮏﻤﺸﭼ"


msgctxt "Operator"
msgid "Apply Object Transform"
msgstr "ءﯽﺷ ﻞﯾﺪﺒﺗ ﻝﺎﻤﻋﺍ"


msgid "Apply the object's transformation to its data"
msgstr "ﻥﺁ ﯼﺎﻫ‌ﻩﺩﺍﺩ ﯼﻭﺭ ءﯽﺷ ﻞﯾﺪﺒﺗ ﻝﺎﻤﻋﺍ"


msgid "Corrective Flip Normals"
msgstr "ﺎﻫ‌ﻝﺎﻣﺮﻧ ﯽﺣﻼ﻿ﺻﺍ ﻥﺩﺮﮐ‌ﻪﻧﻭﺭﺍﻭ"


msgid "Invert normals for negative scaled objects."
msgstr ".ﯽﻔﻨﻣ ﺱﺎﯿﻘﻣ ﺎﺑ ﯽﯾﺎﯿﺷﺍ ﯼﺍﺮﺑ ﺎﻫ‌ﻝﺎﻣﺮﻧ ﻥﺩﺮﮐ‌ﻪﻧﻭﺭﺍﻭ"


msgid "Isolate Multi User Data"
msgstr "ﻩﺮﺑﺭﺎﮐﺪﻨﭼ ﯼﺎﻫ‌ﻩﺩﺍﺩ ﻥﺩﺮﮐﺍﺪﺟ"


msgid "Create new object-data users if needed"
msgstr "ﻦﮐ ﺩﺎﺠﯾﺍ ءﯽﺷ ﯼﺎﻫ‌ﻩﺩﺍﺩ ﯼﺍﺮﺑ ﻩﺯﺎﺗ ﻥﺍﺮﺑﺭﺎﮐ ،ﺯﺎﯿﻧ ﺕﺭﻮﺻ ﺭﺩ"


msgid "Apply Properties"
msgstr "ﺎﻫ‌ﯽﮔﮋﯾﻭ ﻝﺎﻤﻋﺍ"


msgid "Modify properties such as curve vertex radius, font size and bone envelope"
msgstr "ﻥﺍﻮﺨﺘﺳﺍ ﺶﺷﻮﭘ ﻭ ﻢﻠﻗ ﻩٔﺯﺍﺪﻧﺍ ،ﯽﻨﺤﻨﻣ ﺱﺃﺭ ﻉﺎﻌﺷ ﺪﻨﻧﺎﻣ ﯽﯾﺎﻫ‌ﯽﮔﮋﯾﻭ ﺮﯿﯿﻐﺗ"


msgctxt "Operator"
msgid "Look at Surface"
msgstr "ﺢﻄﺳ ﻪﺑ ﻥﺩﺮﮐ‌ﻩﺎﮕﻧ"


msgid "Interactively point cameras and lights to the surface under the pointer (Ctrl to translate)"
msgstr "(ﺪﯾﺭﺍﺩ ﻪﮕﻧ ﺍﺭ Ctrl ﯽﯾﺎﺟ‌ﻪﺑﺎﺟ ﯼﺍﺮﺑ) ﺮﮕﻧﺎﺸﻧ ﺮﯾﺯ ﺢﻄﺳ ﻪﺑ ﺎﻫﺭﻮﻧ ﻭ ﺎﻫ‌ﻦﯿﺑﺭﻭﺩ ﯽﻠﻣﺎﻌﺗ ﺖﯾﺍﺪﻫ"


msgctxt "Operator"
msgid "Place Object Under Mouse"
msgstr "ﺱﻭﺎﻣ ﺮﮕﻧﺎﺸﻧ ﺮﯾﺯ ءﯽﺷ ﻥﺩﺍﺩ ﺭﺍﺮﻗ"


msgid "Snap selected item(s) to the mouse location"
msgstr "ﺱﻭﺎﻣ ﺮﮕﻧﺎﺸﻧ ﻥﺎﮑﻣ ﻪﺑ ﻩﺪﺷ‌ﺏﺎﺨﺘﻧﺍ ﺩﺭﺍﻮﻣ ﻥﺩﺮﮐ‌ﺖﻔﭼ"


msgid "Object name to place (uses the active object when this and 'session_uid' are unset)"
msgstr "(ﺩﻮﺷ‌ﯽﻣ ﻩﺩﺎﻔﺘﺳﺍ ﻝﺎﻌﻓ ءﯽﺷ ﺯﺍ ،ﺪﻨﺷﺎﺑ ﻩﺪﺸﻧ ﻢﯿﻈﻨﺗ 'session_uid' ﻭ ﺭﺍﺪﻘﻣ ﻦﯾﺍ ﺮﮔﺍ) ﺩﺮﯿﮔ ﺭﺍﺮﻗ ﺪﯾﺎﺑ ﻪﮐ ﯽﺌﯿﺷ ﻡﺎﻧ"


msgid "Session UUID"
msgstr "ﺖﺴﺸﻧ ﯼﺎﺘﮑﯾ ﻪٔﺳﺎﻨﺷ"


msgid "Session UUID of the object to place (uses the active object when this and 'name' are unset)"
msgstr "(ﺩﻮﺷ‌ﯽﻣ ﻩﺩﺎﻔﺘﺳﺍ ﻝﺎﻌﻓ ءﯽﺷ ﺯﺍ ،ﺪﻨﺷﺎﺑ ﻩﺪﺸﻧ ﻢﯿﻈﻨﺗ 'name' ﻭ ﺭﺍﺪﻘﻣ ﻦﯾﺍ ﺮﮔﺍ) ﺩﺮﯿﮔ ﺭﺍﺮﻗ ﺪﯾﺎﺑ ﻪﮐ ﯽﺌﯿﺷ ﺖِﺴﺸﻧ ﯼﺎﺘﮑﯾ ﻪٔﺳﺎﻨﺷ"


msgid "Which transforms to transfer"
msgstr "ﺪﻧﻮﺷ ﻞﻘﺘﻨﻣ ﺪﯾﺎﺑ ﻪﮐ ﯽﯾﺎﻫ‌ﻞﯾﺪﺒﺗ"


msgid "All Transforms"
msgstr "ﺎﻫ‌ﻞﯾﺪﺒﺗ ﻪٔﻤﻫ"


msgid "Transfer location, rotation, and scale transforms"
msgstr "ﺱﺎﯿﻘﻣ ﻭ ﺶﺧﺮﭼ ،ﻥﺎﮑﻣ ﯼﺎﻫ‌ﻞﯾﺪﺒﺗ ﻝﺎﻘﺘﻧﺍ"


msgid "Transfer location transforms only"
msgstr "ﻥﺎﮑﻣ ﻞﯾﺪﺒﺗ ﻝﺎﻘﺘﻧﺍ ﻂﻘﻓ"


msgid "Transfer rotation transforms only"
msgstr "ﺶﺧﺮﭼ ﻞﯾﺪﺒﺗ ﻝﺎﻘﺘﻧﺍ ﻂﻘﻓ"


msgid "Transfer scale transforms only"
msgstr "ﺱﺎﯿﻘﻣ ﻞﯾﺪﺒﺗ ﻝﺎﻘﺘﻧﺍ ﻂﻘﻓ"


msgid "Reset Values"
msgstr "ﺮﯾﺩﺎﻘﻣ ﯽﻧﺎﺸﻧﺯﺎﺑ"


msgid "Clear transform values after transferring to deltas"
msgstr "ﺎﻫﺎﺘﻟﺩ ﻪﺑ ﻝﺎﻘﺘﻧﺍ ﺯﺍ ﺲﭘ ﻞﯾﺪﺒﺗ ﺮﯾﺩﺎﻘﻣ ﻥﺩﺮﮐ‌ﮎﺎﭘ"


msgctxt "Operator"
msgid "Update from Objects"
msgstr "ﺎﯿﺷﺍ ﺯﺍ ﯽﻧﺎﺳﺭﺯﻭﺭ‌ﻪﺑ"


msgid "Update existing shape keys with the vertex positions of selected objects with matching names"
msgstr "ﺪﻧﺭﺍﺩ ﻖﺒﻄﻨﻣ ﻡﺎﻧ ﻪﮐ ﯼﺍ‌ﻩﺪﺷ‌ﺏﺎﺨﺘﻧﺍ ﯼﺎﯿﺷﺍ ﯼﺎﻫ‌ﺱﺃﺭ ﺖﯿﻌﻗﻮﻣ ﺎﺑ ﺩﻮﺟﻮﻣ ﻞﮑﺷ ﯼﺎﻫﺪﯿﻠﮐ ﯽﻧﺎﺳﺭﺯﻭﺭ‌ﻪﺑ"


msgctxt "Operator"
msgid "Add Vertex Group"
msgstr "ﺱﺃﺭ ﻩﻭﺮﮔ ﻥﺩﻭﺰﻓﺍ"


msgid "Add a new vertex group to the active object"
msgstr "ﻝﺎﻌﻓ ءﯽﺷ ﻪﺑ ﺪﯾﺪﺟ ﺱﺃﺭ ﻩﻭﺮﮔ ﻥﺩﻭﺰﻓﺍ"


msgctxt "Operator"
msgid "Assign to Vertex Group"
msgstr "ﺱﺃﺭ ﻩﻭﺮﮔ ﻪﺑ ﺹﺎﺼﺘﺧﺍ"


msgid "Assign the selected vertices to the active vertex group"
msgstr "ﻝﺎﻌﻓ ﺱﺃﺭ ﻩﻭﺮﮔ ﻪﺑ ﻩﺪﺷ‌ﺏﺎﺨﺘﻧﺍ ﯼﺎﻫ‌ﺱﺃﺭ ﺹﺎﺼﺘﺧﺍ"


msgctxt "Operator"
msgid "Assign to New Group"
msgstr "ﺪﯾﺪﺟ ﻩﻭﺮﮔ ﻪﺑ ﺹﺎﺼﺘﺧﺍ"


msgid "Assign the selected vertices to a new vertex group"
msgstr "ﺪﯾﺪﺟ ﺱﺃﺭ ﻩﻭﺮﮔ ﻪﺑ ﻩﺪﺷ‌ﺏﺎﺨﺘﻧﺍ ﯼﺎﻫ‌ﺱﺃﺭ ﺹﺎﺼﺘﺧﺍ"


msgctxt "Operator"
msgid "Clean Vertex Group Weights"
msgstr "ﺱﺃﺭ ﻩﻭﺮﮔ ﯼﺎﻫ‌ﻥﺯﻭ ﯼﺯﺎﺳ‌ﮎﺎﭘ"


msgid "Remove vertex group assignments which are not required"
msgstr "ﺱﺃﺭ ﻩﻭﺮﮔ ﯼﺭﻭﺮﺿﺮﯿﻏ ﯼﺎﻫ‌ﺺﯿﺼﺨﺗ ﻑﺬﺣ"


msgid "Define which subset of groups shall be used"
msgstr "ﺪﻧﻮﺷ‌ﯽﻣ ﻩﺩﺎﻔﺘﺳﺍ ﻪﮐ ﯽﯾﺎﻫ‌ﻩﻭﺮﮔ ﻪٔﻋﻮﻤﺠﻣﺮﯾﺯ ﻦﯿﯿﻌﺗ"


msgid "Keep Single"
msgstr "ﯽﻫﻭﺮﮔ‌ﮏﺗ ﻦﺘﺷﺍﺩ‌ﻪﮕﻧ"


msgid "Keep verts assigned to at least one group when cleaning"
msgstr "ﺪﻧﺭﺍﺩ ﺺﯿﺼﺨﺗ ﻩﻭﺮﮔ ﮏﯾ ﻪﺑ ﻢﮐ‌ﺖﺳﺩ ﻪﮐ ﺭﺍﺩ‌ﻪﮕﻧ ﺍﺭ ﯽﯾﺎﻫ‌ﺱﺃﺭ ،ﯼﺯﺎﺳ‌ﮎﺎﭘ ﻡﺎﮕﻨﻫ"


msgid "Remove vertices which weight is below or equal to this limit"
msgstr "ﺖﺳﺍ ﻥﺁ ﺎﺑ ﺮﺑﺍﺮﺑ ﺎﯾ ﺪﺣ ﻦﯾﺍ ﺯﺍ ﺮﺘﻤﮐ ﻥﺎﺸﻧﺯﻭ ﻪﮐ ﯽﯾﺎﻫ‌ﺱﺃﺭ ﻑﺬﺣ"


msgctxt "Operator"
msgid "Duplicate Vertex Group"
msgstr "ﺱﺃﺭ ﻩﻭﺮﮔ ﺮﯿﺜﮑﺗ"


msgid "Make a copy of the active vertex group"
msgstr "ﻝﺎﻌﻓ ﺱﺃﺭ ﻩﻭﺮﮔ ﺯﺍ ﻪﺨﺴﻧ ﮏﯾ ﺩﺎﺠﯾﺍ"


msgctxt "Operator"
msgid "Copy Vertex Group to Selected"
msgstr "ﻩﺪﺷ‌ﺏﺎﺨﺘﻧﺍ ﺩﺭﺍﻮﻣ ﯼﻭﺭ ﺱﺃﺭ ﻩﻭﺮﮔ ﯽﭙﮐ"


msgid "Replace vertex groups of selected objects by vertex groups of active object"
msgstr "ﻝﺎﻌﻓ ءﯽﺷ ﺱﺃﺭ ﯼﺎﻫ‌ﻩﻭﺮﮔ ﺎﺑ ﻩﺪﺷ‌ﺏﺎﺨﺘﻧﺍ ﯼﺎﯿﺷﺍ ﺱﺃﺭ ﯼﺎﻫ‌ﻩﻭﺮﮔ ﯽﻨﯾﺰﮕﯾﺎﺟ"


msgctxt "Operator"
msgid "Deselect Vertex Group"
msgstr "ﺱﺃﺭ ﻩﻭﺮﮔ ﺏﺎﺨﺘﻧﺍ ﻮﻐﻟ"


msgid "Deselect all selected vertices assigned to the active vertex group"
msgstr "ﺪﻧﺭﺍﺩ ﺺﯿﺼﺨﺗ ﻝﺎﻌﻓ ﺱﺃﺭ ﻩﻭﺮﮔ ﻪﺑ ﻪﮐ ﯼﺍ‌ﻩﺪﺷ‌ﺏﺎﺨﺘﻧﺍ ﯼﺎﻫ‌ﺱﺃﺭ ﻪٔﻤﻫ ﺏﺎﺨﺘﻧﺍ ﻮﻐﻟ"


msgctxt "Operator"
msgid "Invert Vertex Group"
msgstr "ﺱﺃﺭ ﻩﻭﺮﮔ ﻥﺩﺮﮐ‌ﺱﻮﮑﻌﻣ"


msgid "Invert active vertex group's weights"
msgstr "ﻝﺎﻌﻓ ﺱﺃﺭ ﻩﻭﺮﮔ ﯼﺎﻫ‌ﻥﺯﻭ ﻥﺩﺮﮐ‌ﺱﻮﮑﻌﻣ"


msgid "Add Weights"
msgstr "ﺎﻫ‌ﻥﺯﻭ ﻥﺩﻭﺰﻓﺍ"


msgid "Add vertices from groups that have zero weight before inverting"
msgstr "ﺪﻧﺭﺍﺩ ﺮﻔﺻ ﻥﺯﻭ ﯼﺯﺎﺳ‌ﺱﻮﮑﻌﻣ ﺯﺍ ﺶﯿﭘ ﻪﮐ ﯽﯾﺎﻫ‌ﻩﻭﺮﮔ ﯼﺎﻫ‌ﺱﺃﺭ ﻥﺩﻭﺰﻓﺍ"


msgid "Remove Weights"
msgstr "ﺎﻫ‌ﻥﺯﻭ ﻑﺬﺣ"


msgid "Remove vertices from groups that have zero weight after inverting"
msgstr "ﺪﻧﺭﺍﺩ ﺮﻔﺻ ﻥﺯﻭ ﯼﺯﺎﺳ‌ﺱﻮﮑﻌﻣ ﺯﺍ ﺲﭘ ﻪﮐ ﯽﯾﺎﻫ‌ﻩﻭﺮﮔ ﺯﺍ ﺎﻫ‌ﺱﺃﺭ ﻑﺬﺣ"


msgctxt "Operator"
msgid "Vertex Group Levels"
msgstr "ﺱﺃﺭ ﻩﻭﺮﮔ ﺡﻮﻄﺳ"


msgid "Add some offset and multiply with some gain the weights of the active vertex group"
msgstr "ﻩﺮﻬﺑ ﺐﯾﺮﺿ ﺭﺩ ﻝﺎﻌﻓ ﺱﺃﺭ ﻩﻭﺮﮔ ﯼﺎﻫ‌ﻥﺯﻭ ﺏﺮﺿ ﻭ ﯽﯾﺎﺟ‌ﻪﺑﺎﺟ ﺭﺍﺪﻘﻣ ﻥﺩﻭﺰﻓﺍ"


msgid "Value to multiply weights by"
msgstr "ﺪﻧﻮﺷ‌ﯽﻣ ﺏﺮﺿ ﻥﺁ ﺭﺩ ﺎﻫ‌ﻥﺯﻭ ﻪﮐ ﯼﺭﺍﺪﻘﻣ"


msgid "Value to add to weights"
msgstr "ﺩﻮﺷ‌ﯽﻣ ﻩﺩﻭﺰﻓﺍ ﺎﻫ‌ﻥﺯﻭ ﻪﺑ ﻪﮐ ﯼﺭﺍﺪﻘﻣ"


msgctxt "Operator"
msgid "Limit Number of Weights per Vertex"
