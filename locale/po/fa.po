msgstr "F ﺵﻮﭘ ﻩٔﺪﻨﻨﮐ‌ﺡﻼ﻿ﺻﺍ"


msgid "Scale the values of the modified F-Curve"
msgstr "ﻩﺪﺷ‌ﺡﻼ﻿ﺻﺍ F ﯽﻨﺤﻨﻣ ﺮﯾﺩﺎﻘﻣ ﻥﺩﺮﮐ‌ﺱﺎﯿﻘﻣ"


msgid "Control Points"
msgstr "ﻝﺮﺘﻨﮐ ﻁﺎﻘﻧ"


msgid "Control points defining the shape of the envelope"
msgstr "ﺪﻨﻨﮐ‌ﯽﻣ ﻒﯾﺮﻌﺗ ﺍﺭ ﺵﻮﭘ ﻞﮑﺷ ﻪﮐ ﯽﻟﺮﺘﻨﮐ ﻁﺎﻘﻧ"


msgid "Default Maximum"
msgstr "ﺽﺮﻓ‌ﺶﯿﭘ ﺮﺜﮐﺍﺪﺣ"


msgid "Upper distance from Reference Value for 1:1 default influence"
msgstr "۱:۱ ﺽﺮﻓ‌ﺶﯿﭘ ﺮﯿﺛﺄﺗ ﯼﺍﺮﺑ ﻊﺟﺮﻣ ﺭﺍﺪﻘﻣ ﺯﺍ ﯽﯾﻻ﻿ﺎﺑ ﻪٔﻠﺻﺎﻓ"


msgid "Default Minimum"
msgstr "ﺽﺮﻓ‌ﺶﯿﭘ ﻞﻗﺍﺪﺣ"


msgid "Lower distance from Reference Value for 1:1 default influence"
msgstr "۱:۱ ﺽﺮﻓ‌ﺶﯿﭘ ﺮﯿﺛﺄﺗ ﯼﺍﺮﺑ ﻊﺟﺮﻣ ﺭﺍﺪﻘﻣ ﺯﺍ ﯽﻨﯿﯾﺎﭘ ﻪٔﻠﺻﺎﻓ"


msgid "Reference Value"
msgstr "ﻊﺟﺮﻣ ﺭﺍﺪﻘﻣ"


msgid "Value that envelope's influence is centered around / based on"
msgstr "ﺖﺳﺍ ﻥﺁ ﻪٔﯾﺎﭘ ﺮﺑ ﺎﯾ ﺰﮐﺮﻤﺘﻣ ﻥﺁ ﻥﻮﻣﺍﺮﯿﭘ ﺵﻮﭘ ﺮﯿﺛﺄﺗ ﻪﮐ ﯼﺭﺍﺪﻘﻣ"


msgid "Built-In Function F-Modifier"
msgstr "F ﯽﻠﺧﺍﺩ ﻊﺑﺎﺗ ﻩٔﺪﻨﻨﮐ‌ﺡﻼ﻿ﺻﺍ"


msgid "Generate values using a built-in function"
msgstr "ﯽﻠﺧﺍﺩ ﻊﺑﺎﺗ ﺯﺍ ﻩﺩﺎﻔﺘﺳﺍ ﺎﺑ ﺮﯾﺩﺎﻘﻣ ﺪﯿﻟﻮﺗ"


msgid "Amplitude"
msgstr "ﻪﻨﻣﺍﺩ"


msgid "Scale factor determining the maximum/minimum values"
msgstr "ﻪﻨﯿﻤﮐ/ﻪﻨﯿﺸﯿﺑ ﺮﯾﺩﺎﻘﻣ ﻩٔﺪﻨﻨﮐ‌ﻦﯿﯿﻌﺗ ﺱﺎﯿﻘﻣ ﺐﯾﺮﺿ"


msgid "Type of built-in function to use"
msgstr "ﻩﺩﺎﻔﺘﺳﺍ ﺩﺭﻮﻣ ﯽﻠﺧﺍﺩ ﻊﺑﺎﺗ ﻉﻮﻧ"


msgid "Sine"
msgstr "ﺱﻮﻨﯿﺳ"


msgid "Cosine"
msgstr "ﺱﻮﻨﯿﺴﮐ"


msgid "Square Root"
msgstr "ﻡﻭﺩ ﻪٔﺸﯾﺭ"


msgid "Natural Logarithm"
msgstr "ﯽﻌﯿﺒﻃ ﻢﺘﯾﺭﺎﮕﻟ"


msgid "Normalized Sine"
msgstr "ﻩﺪﺷ‌ﻝﺎﻣﺮﻧ ﺱﻮﻨﯿﺳ"


msgid "sin(x) / x"
msgstr "sin(x) ‬/‬ x"


msgid "Phase Multiplier"
msgstr "ﺯﺎﻓ ﺐﯾﺮﺿ"


msgid "Scale factor determining the 'speed' of the function"
msgstr "ﻊﺑﺎﺗ «ﺖﻋﺮﺳ» ﻩٔﺪﻨﻨﮐ‌ﻦﯿﯿﻌﺗ ﺱﺎﯿﻘﻣ ﺐﯾﺮﺿ"


msgid "Phase Offset"
msgstr "ﺯﺎﻓ ﯽﯾﺎﺟ‌ﻪﺑﺎﺟ"


msgid "Constant factor to offset time by for function"
msgstr "ﻊﺑﺎﺗ ﻥﺎﻣﺯ ﯽﯾﺎﺟ‌ﻪﺑﺎﺟ ﯼﺍﺮﺑ ﯽﺘﺑﺎﺛ ﺐﯾﺮﺿ"


msgid "Additive"
msgstr "ﯽﻌﻤﺟ"


msgid "Values generated by this modifier are applied on top of the existing values instead of overwriting them"
msgstr "ﺪﻧﻮﺷ ﺎﻫ‌ﻥﺁ ﻦﯾﺰﮕﯾﺎﺟ ﻪﮑﻨﯾﺍ ﻪﻧ ،ﺪﻧﻮﺷ‌ﯽﻣ ﻩﺩﻭﺰﻓﺍ ﺩﻮﺟﻮﻣ ﺮﯾﺩﺎﻘﻣ ﻪﺑ ﻩﺪﻨﻨﮐ‌ﺡﻼ﻿ﺻﺍ ﻦﯾﺍ ﺎﺑ ﻩﺪﺷﺪﯿﻟﻮﺗ ﺮﯾﺩﺎﻘﻣ"


msgid "Value Offset"
msgstr "ﺭﺍﺪﻘﻣ ﯽﯾﺎﺟ‌ﻪﺑﺎﺟ"


msgid "Constant factor to offset values by"
msgstr "ﺮﯾﺩﺎﻘﻣ ﯽﯾﺎﺟ‌ﻪﺑﺎﺟ ﯼﺍﺮﺑ ﺖﺑﺎﺛ ﺐﯾﺮﺿ"


msgid "Generator F-Modifier"
msgstr "F ﺪﻟﻮﻣ ﻩٔﺪﻨﻨﮐ‌ﺡﻼ﻿ﺻﺍ"


msgid "Deterministically generate values for the modified F-Curve"
msgstr "ﻩﺪﺷ‌ﺡﻼ﻿ﺻﺍ F ﯽﻨﺤﻨﻣ ﯼﺍﺮﺑ ﺮﯾﺩﺎﻘﻣ ﯽﻌﻄﻗ ﺪﯿﻟﻮﺗ"


msgid "Coefficients"
msgstr "ﺐﯾﺍﺮﺿ"


msgid "Coefficients for 'x' (starting from lowest power of x^0)"
msgstr "(ﺩﻮﺷ‌ﯽﻣ ﺯﺎﻏﺁ x^0 ﻥﺍﻮﺗ ﻦﯾﺮﺗ‌ﻦﯿﯾﺎﭘ ﺯﺍ) «x» ﺐﯾﺍﺮﺿ"


msgid "Type of generator to use"
msgstr "ﺩﻭﺭ ﺭﺎﮐ ﻪﺑ ﻪﮐ ﯼﺪﻟّﻮﻣ ﻉﻮﻧ"


msgid "Expanded Polynomial"
msgstr "ﻪﺘﻓﺎﯾ‌ﻂﺴﺑ ﯼﺍ‌ﻪﻠﻤﺟﺪﻨﭼ"


msgid "Factorized Polynomial"
msgstr "ﻪﺘﻓﺮﮔﺭﻮﺘﮐﺎﻓ ﯼﺍ‌ﻪﻠﻤﺟﺪﻨﭼ"


msgid "Polynomial Order"
msgstr "ﯼﺍ‌ﻪﻠﻤﺟﺪﻨﭼ ﻪٔﺟﺭﺩ"


msgid "The highest power of 'x' for this polynomial (number of coefficients - 1)"
msgstr "(ﮏﯾ ﯼﺎﻬﻨﻣ ﺎﻫ‌ﺐﯾﺮﺿ ﺩﺍﺪﻌﺗ) ﯼﺍ‌ﻪﻠﻤﺟﺪﻨﭼ ﺭﺩ x ﻥِﺍﻮﺗ ﻦﯾﺮﺗﻻ﻿ﺎﺑ"


msgid "Limit F-Modifier"
msgstr "F ﻩٔﺪﻨﻨﮐﺩﻭﺪﺤﻣ ﻩٔﺪﻨﻨﮐ‌ﺡﻼ﻿ﺻﺍ"


msgid "Limit the time/value ranges of the modified F-Curve"
