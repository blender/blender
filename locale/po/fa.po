msgstr "ﺪﻨﮐ‌ﯽﻣ ﻥﺎﻬﻨﭘ ﺍﺭ ﯼﺪﻨﺑ‌ﺏﺎﻗ ﻝﺎﺣ ﺭﺩ ﯼﺎﻫ‌ﯽﻨﺤﻨﻣ ﺰﺟ‌ﻪﺑ F ﯼﺎﻫ‌ﯽﻨﺤﻨﻣ ﻪٔﻤﻫ"


msgctxt "Operator"
msgid "Copy World Space Range"
msgstr "ﻥﺎﻬﺟ ﯼﺎﻀﻓ ﻩٔﺯﺎﺑ ﯽﭙﮐ"


msgid "Copy animation from selected elements to the clipboard"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﯽﭙﮐ ﺩﺭﻮﺑ‌ﭗﯿﻠﮐ ﺭﺩ ﺍﺭ ﻩﺪﺷ‌ﺏﺎﺨﺘﻧﺍ ﺮﺻﺎﻨﻋ ﯽﯾﺎﻤﻧﺎﯾﻮﭘ"


msgid "End frame to copy from"
