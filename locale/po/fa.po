msgid "Combine grids in a subtractive way"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﺐﯿﮐﺮﺗ ﯽﻘﯾﺮﻔﺗ ﺕﺭﻮﺻ‌ﻪﺑ ﺍﺭ ﺎﻫ‌ﻪﮑﺒﺷ"


msgid "SDF Grid Fillet"
msgstr "SDF ﻪٔﮑﺒﺷ ﻪٔﺷﻮﮔ ﻥﺩﺮﮐﺩﺮﮔ"


msgid "Round off concave internal corners in a signed distance field. Only affects areas with negative principal curvature, creating smoother transitions between surfaces"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﺮﺗ‌ﻡﺮﻧ ﺍﺭ ﺎﻫ‌ﺢﻄﺳ ﻥﺎﯿﻣ ﺭﺍﺬﮔ ﻭ ﺩﺭﺍﺬﮔ‌ﯽﻣ ﺮﺛﺍ ﯽﻔﻨﻣ ﯽﻠﺻﺍ ﯼﺎﻨﺤﻧﺍ ﺎﺑ ﯽﺣﺍﻮﻧ ﺮﺑ ﻂﻘﻓ .ﺪﻨﮐ‌ﯽﻣ ﺩﺮﮔ ﺭﺍﺩ‌ﺖﻣﻼ﻿ﻋ ﻪٔﻠﺻﺎﻓ ﻥﺍﺪﯿﻣ ﺭﺩ ﺍﺭ ﺮﻌﻘﻣ ﯽﻠﺧﺍﺩ ﯼﺎﻫ‌ﻪﺷﻮﮔ"


msgid "SDF Grid Laplacian"
msgstr "SDF ﻪٔﮑﺒﺷ ﻦﯿﺳﻼ﻿ﭘﻻ﻿"


msgid "Apply Laplacian flow smoothing to a signed distance field. Computationally efficient alternative to mean curvature flow, ideal when combined with SDF normalization"
msgstr "ﺖﺳﺍ ﺐﺳﺎﻨﻣ SDF ﯼﺯﺎﺳ‌ﻝﺎﻣﺮﻧ ﺎﺑ ﻥﺁ ﺐﯿﮐﺮﺗ ﻭ ﺖﺳﺍ ﻦﯿﮕﻧﺎﯿﻣ ﯼﺎﻨﺤﻧﺍ ﻥﺎﯾﺮﺟ ﯼﺍﺮﺑ ﯽﺗﺎﺒﺳﺎﺤﻣ ﺮﻈﻧ ﺯﺍ ﻪﻨﯾﺰﻫ‌ﻢﮐ ﯽﻨﯾﺰﮕﯾﺎﺟ .ﺪﻨﮐ‌ﯽﻣ ﻝﺎﻤﻋﺍ ﺭﺍﺩ‌ﺖﻣﻼ﻿ﻋ ﻪٔﻠﺻﺎﻓ ﻥﺍﺪﯿﻣ ﯼﻭﺭ ﺍﺭ ﯽﺳﻼ﻿ﭘﻻ﻿ ﻥﺎﯾﺮﺟ ﯼﺯﺎﺳﺭﺍﻮﻤﻫ"


msgid "SDF Grid Mean"
msgstr "SDF ﻪٔﮑﺒﺷ ﯼﺮﯿﮔ‌ﻦﯿﮕﻧﺎﯿﻣ"


msgid "Apply mean (box) filter smoothing to a signed distance field. Fast separable averaging filter for general smoothing of the distance field"
msgstr "ﺖﺳﺍ ﻪﻠﺻﺎﻓ ﻥﺍﺪﯿﻣ ﯽﻣﻮﻤﻋ ﯼﺯﺎﺳﺭﺍﻮﻤﻫ ﯼﺍﺮﺑ ﺮﯾﺬﭘ‌ﯽﯾﺍﺪﺟ ﻭ ﻊﯾﺮﺳ ﯼﺮﯿﮔ‌ﻦﯿﮕﻧﺎﯿﻣ ﺮﺘﻠﯿﻓ .ﺪﻨﮐ‌ﯽﻣ ﻝﺎﻤﻋﺍ ﺭﺍﺩ‌ﺖﻣﻼ﻿ﻋ ﻪٔﻠﺻﺎﻓ ﻥﺍﺪﯿﻣ ﯼﻭﺭ ﺍﺭ (ﯼﺍ‌ﻪﺒﻌﺟ) ﻦﯿﮕﻧﺎﯿﻣ ﺮﺘﻠﯿﻓ ﯼﺯﺎﺳﺭﺍﻮﻤﻫ"


msgid "SDF Grid Mean Curvature"
msgstr "SDF ﻪٔﮑﺒﺷ ﻦﯿﮕﻧﺎﯿﻣ ﯼﺎﻨﺤﻧﺍ"


msgid "Apply mean curvature flow smoothing to a signed distance field. Evolves the surface based on its mean curvature, naturally smoothing high-curvature regions more than flat areas"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﺭﺍﻮﻤﻫ ﺖﺨﺗ ﯼﺎﻫ‌ﺶﺨﺑ ﺯﺍ ﺮﺘﺸﯿﺑ ﯽﻌﯿﺒﻃ ﺭﻮﻃ‌ﻪﺑ ﺍﺭ ﺎﻨﺤﻧﺍﺮﭘُ ﯽﺣﺍﻮﻧ ﻭ ﺪﻫﺩ‌ﯽﻣ ﻞﻣﺎﮑﺗ ﻥﺁ ﻦﯿﮕﻧﺎﯿﻣ ﯼﺎﻨﺤﻧﺍ ﺱﺎﺳﺍ ﺮﺑ ﺍﺭ ﺢﻄﺳ .ﺪﻨﮐ‌ﯽﻣ ﻝﺎﻤﻋﺍ ﺭﺍﺩ‌ﺖﻣﻼ﻿ﻋ ﻪٔﻠﺻﺎﻓ ﻥﺍﺪﯿﻣ ﯼﻭﺭ ﺍﺭ ﻦﯿﮕﻧﺎﯿﻣ ﯼﺎﻨﺤﻧﺍ ﻥﺎﯾﺮﺟ ﯼﺯﺎﺳﺭﺍﻮﻤﻫ"


msgid "SDF Grid Median"
msgstr "SDF ﻪٔﮑﺒﺷ ﯼﺮﯿﮔ‌ﻪﻧﺎﯿﻣ"


msgid "Apply median filter to a signed distance field. Reduces noise while preserving sharp features and edges in the distance field"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﻆﻔﺣ ﺍﺭ ﻪﻠﺻﺎﻓ ﻥﺍﺪﯿﻣ ﺰﯿﺗ ﯼﺎﻫ‌ﻝﺎﯾ ﻭ ﺕﺎﯿﺋﺰﺟ ﻝﺎﺣ ﻦﯿﻋ ﺭﺩ ﻭ ﺪﻫﺩ‌ﯽﻣ ﺶﻫﺎﮐ ﺍﺭ ﺰﯾﻮﻧ .ﺪﻨﮐ‌ﯽﻣ ﻝﺎﻤﻋﺍ ﺭﺍﺩ‌ﺖﻣﻼ﻿ﻋ ﻪٔﻠﺻﺎﻓ ﻥﺍﺪﯿﻣ ﯼﻭﺭ ﺍﺭ ﻪﻧﺎﯿﻣ ﺮﺘﻠﯿﻓ"


msgid "SDF Grid Offset"
msgstr "SDF ﻪٔﮑﺒﺷ ﯽﯾﺎﺟ‌ﻪﺑﺎﺟ"


msgid "Offset a signed distance field surface by a world-space distance. Dilates (positive) or erodes (negative) while maintaining the signed distance property"
msgstr "(ﯽﻔﻨﻣ ﺭﺍﺪﻘﻣ) ﺪﻫﺩ‌ﯽﻣ ﺶﯾﺎﺳﺮﻓ ﺎﯾ (ﺖﺒﺜﻣ ﺭﺍﺪﻘﻣ) ﺪﻫﺩ‌ﯽﻣ ﺵﺮﺘﺴﮔ ﺍﺭ ﻥﺁ ،ﺭﺍﺩ‌ﺖﻣﻼ﻿ﻋ ﻪٔﻠﺻﺎﻓ ﯽﮔﮋﯾﻭ ﻆﻔﺣ ﺎﺑ .ﺪﻨﮐ‌ﯽﻣ ﺎﺟ‌ﻪﺑﺎﺟ ﻥﺎﻬﺟ ﯼﺎﻀﻓ ﺭﺩ ﯼﺍ‌ﻩﺯﺍﺪﻧﺍ‌ﻪﺑ ﺍﺭ ﺭﺍﺩ‌ﺖﻣﻼ﻿ﻋ ﻪٔﻠﺻﺎﻓ ﻥﺍﺪﯿﻣ ﺢﻄﺳ"


msgid "Sample Curve"
msgstr "ﯽﻨﺤﻨﻣ ﺯﺍ ﯼﺮﯿﮔ‌ﻪﻧﻮﻤﻧ"


msgid "Retrieve data from a point on a curve at a certain distance from its start"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﯽﺑﺎﯾﺯﺎﺑ ﻥﺁ ﺯﺎﻏﺁ ﺯﺍ ﺺﺨﺸﻣ ﯼﺍ‌ﻪﻠﺻﺎﻓ ﺭﺩ ﺍﺭ ﯽﻨﺤﻨﻣ ﯼﻭﺭ ﯼﺍ‌ﻪﻄﻘﻧ ﯼﺎﻫ‌ﻩﺩﺍﺩ"


msgid "Method for sampling input"
msgstr "ﯼﺩﻭﺭﻭ ﺯﺍ ﯼﺮﯿﮔ‌ﻪﻧﻮﻤﻧ ﺵﻭﺭ"


msgid "Find sample positions on the curve using a factor of its total length"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﺍﺪﯿﭘ ﯽﻨﺤﻨﻣ ﻞﮐ ﻝﻮﻃ ﺯﺍ ﯽﺒﯾﺮﺿ ﺯﺍ ﻩﺩﺎﻔﺘﺳﺍ ﺎﺑ ﺍﺭ ﻪﻧﻮﻤﻧ ﯼﺎﻫ‌ﻥﺎﮑﻣ"


msgid "Find sample positions on the curve using a distance from its beginning"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﺍﺪﯿﭘ ﯽﻨﺤﻨﻣ ﯼﺍﺪﺘﺑﺍ ﺯﺍ ﻪﻠﺻﺎﻓ ﺱﺎﺳﺍ ﺮﺑ ﺍﺭ ﻪﻧﻮﻤﻧ ﯼﺎﻫ‌ﻥﺎﮑﻣ"


msgid "All Curves"
msgstr "ﺎﻫ‌ﯽﻨﺤﻨﻣ ﻪٔﻤﻫ"


msgid "Sample lengths based on the total length of all curves, rather than using a length inside each selected curve"
msgstr "ﻩﺪﺷ‌ﺏﺎﺨﺘﻧﺍ ﯽﻨﺤﻨﻣ ﺮﻫ ﻥﻭﺭﺩ ﻝﻮﻃ ﻪﻧ ،ﺪﻨﮐ‌ﯽﻣ ﻪﺒﺳﺎﺤﻣ ﺎﻫ‌ﯽﻨﺤﻨﻣ ﻪٔﻤﻫ ﻞﮐ ﻝﻮﻃ ﺱﺎﺳﺍ ﺮﺑ ﺍﺭ ﻪﻧﻮﻤﻧ ﻝﻮﻃ"


msgid "Sample Grid"
msgstr "ﻪﮑﺒﺷ ﺯﺍ ﯼﺮﯿﮔ‌ﻪﻧﻮﻤﻧ"


msgid "Retrieve values from the specified volume grid"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﯽﺑﺎﯾﺯﺎﺑ ﻩﺪﺷ‌ﺺﺨﺸﻣ ﯽﻤﺠﺣ ﻪٔﮑﺒﺷ ﺯﺍ ﺍﺭ ﺎﻫﺭﺍﺪﻘﻣ"


msgid "Sample Grid Index"
msgstr "ﻪﮑﺒﺷ ﺲﯾﺪﻧﺍ ﺯﺍ ﯼﺮﯿﮔ‌ﻪﻧﻮﻤﻧ"


msgid "Retrieve volume grid values at specific voxels"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﯽﺑﺎﯾﺯﺎﺑ ﺺﺨﺸﻣ ﯼﺎﻫ‌ﻞﺴﮐﻭ ﺭﺩ ﺍﺭ ﯽﻤﺠﺣ ﻪٔﮑﺒﺷ ﯼﺎﻫﺭﺍﺪﻘﻣ"


msgid "Retrieve values from specific geometry elements"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﯽﺑﺎﯾﺯﺎﺑ ﺺﺨﺸﻣ ﯽﺳﺪﻨﻫ ﺮﺻﺎﻨﻋ ﺯﺍ ﺍﺭ ﺎﻫﺭﺍﺪﻘﻣ"


msgid "Clamp the indices to the size of the attribute domain instead of outputting a default value for invalid indices"
msgstr "ﺪﻫﺩ ﯽﺟﻭﺮﺧ ﺽﺮﻓ‌ﺶﯿﭘ ﺭﺍﺪﻘﻣ ﺮﺒﺘﻌﻣﺎﻧ ﯼﺎﻫ‌ﺲﯾﺪﻧﺍ ﯼﺍﺮﺑ ﻪﮑﻧﺁ ﯼﺎﺟ‌ﻪﺑ ،ﺪﻨﮐ‌ﯽﻣ ﺩﻭﺪﺤﻣ ﯽﮔﮋﯾﻭ ﻪٔﻨﻣﺍﺩ ﻩٔﺯﺍﺪﻧﺍ ﻪﺑ ﺍﺭ ﺎﻫ‌ﺲﯾﺪﻧﺍ"


msgid "Sample Nearest"
msgstr "ﺮﺼﻨﻋ ﻦﯾﺮﺗ‌ﮏﯾﺩﺰﻧ ﺯﺍ ﯼﺮﯿﮔ‌ﻪﻧﻮﻤﻧ"


msgid "Find the element of a geometry closest to a position. Similar to the \"Index of Nearest\" node"
msgstr "«ﻦﯾﺮﺗ‌ﮏﯾﺩﺰﻧ ﺲﯾﺪﻧﺍ» ﻩٔﺮﮔ ﻪﺑﺎﺸﻣ .ﺪﻨﮐ‌ﯽﻣ ﺍﺪﯿﭘ ﺍﺭ ﻥﺎﮑﻣ ﮏﯾ ﻪﺑ ﺮﺗ‌ﮏﯾﺩﺰﻧ ﻪٔﺳﺪﻨﻫ ﺮﺼﻨﻋ"


msgid "Sample Nearest Surface"
msgstr "ﺢﻄﺳ ﻦﯾﺮﺗ‌ﮏﯾﺩﺰﻧ ﺯﺍ ﯼﺮﯿﮔ‌ﻪﻧﻮﻤﻧ"


msgid "Calculate the interpolated value of a mesh attribute on the closest point of its surface"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﻪﺒﺳﺎﺤﻣ ﻥﺁ ﺢﻄﺳ ﻪٔﻄﻘﻧ ﻦﯾﺮﺗ‌ﮏﯾﺩﺰﻧ ﺭﺩ ﺍﺭ ﺶﻣ ﯽﮔﮋﯾﻭ ﮏﯾ ﻩٔﺪﺷ‌ﯽﺑﺎﯾ‌ﻥﻭﺭﺩ ﺭﺍﺪﻘﻣ"


msgid "Sample Sound Frequencies"
msgstr "ﺍﺪﺻ ﯼﺎﻫﺪﻣﺎﺴﺑ ﺯﺍ ﯼﺮﯿﮔ‌ﻪﻧﻮﻤﻧ"


msgid "Retrieve the amplitude from a sound data-block of a frequency range at a given time"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﯽﺑﺎﯾﺯﺎﺑ ﺺﺨﺸﻣ ﻥﺎﻣﺯ ﺭﺩ ﺍﺪﺻ ﻩٔﺩﺍﺩ‌ﮎﻮﻠﺑ ﺯﺍ ﺍﺭ ﯼﺪﻣﺎﺴﺑ ﻩٔﺯﺎﺑ ﮏﯾ ﻪٔﻨﻣﺍﺩ"


msgid "Sample UV Surface"
msgstr "UV ﺢﻄﺳ ﺯﺍ ﯼﺮﯿﮔ‌ﻪﻧﻮﻤﻧ"


msgid "Calculate the interpolated values of a mesh attribute at a UV coordinate"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﻪﺒﺳﺎﺤﻣ UV ﺕﺎﺼﺘﺨﻣ ﺭﺩ ﺍﺭ ﺶﻣ ﯽﮔﮋﯾﻭ ﮏﯾ ﻩٔﺪﺷ‌ﯽﺑﺎﯾ‌ﻥﻭﺭﺩ ﯼﺎﻫﺭﺍﺪﻘﻣ"


msgid "Scale Elements"
msgstr "ﺮﺻﺎﻨﻋ ﻥﺩﺍﺩ‌ﺱﺎﯿﻘﻣ"


msgid "Scale groups of connected edges and faces"
msgstr "ﺪﻫﺩ‌ﯽﻣ ﺱﺎﯿﻘﻣ ﺍﺭ ﻞﺼﺘﻣ ﯼﺎﻫ‌ﻪﺟﻭ ﻭ ﺎﻫ‌ﻝﺎﯾ ﺯﺍ ﯽﯾﺎﻫ‌ﻩﻭﺮﮔ"


msgid "Element type to transform"
msgstr "ﺩﻮﺷ ﻩﺩﺍﺩ ﻞﮑﺷﺮﯿﯿﻐﺗ ﺪﯾﺎﺑ ﻪﮐ ﯼﺮﺼﻨﻋ ﻉﻮﻧ"


msgid "Scale individual faces or neighboring face islands"
msgstr "ﺪﻫﺩ‌ﯽﻣ ﺱﺎﯿﻘﻣ ﺍﺭ ﺭﻭﺎﺠﻣ ﻪﺟﻭ ﯼﺎﻫ‌ﻩﺮﯾﺰﺟ ﺎﯾ ﻪﻧﺎﮔﺍﺪﺟ ﯼﺎﻫ‌ﻪﺟﻭ"


msgid "Scale individual edges or neighboring edge islands"
msgstr "ﺪﻫﺩ‌ﯽﻣ ﺱﺎﯿﻘﻣ ﺍﺭ ﺭﻭﺎﺠﻣ ﻝﺎﯾ ﯼﺎﻫ‌ﻩﺮﯾﺰﺟ ﺎﯾ ﻪﻧﺎﮔﺍﺪﺟ ﯼﺎﻫ‌ﻝﺎﯾ"


msgid "Scale Instances"
msgstr "ﺎﻫ‌ﻪﻧﻮﻤﻧ ﻥﺩﺍﺩ‌ﺱﺎﯿﻘﻣ"


msgid "Scale geometry instances in local or global space"
msgstr "ﺪﻫﺩ‌ﯽﻣ ﺱﺎﯿﻘﻣ ﯽﻧﺎﻬﺟ ﺎﯾ ﯽﻠﺤﻣ ﯼﺎﻀﻓ ﺭﺩ ﺍﺭ ﯽﺳﺪﻨﻫ ﯼﺎﻫ‌ﻪﻧﻮﻤﻧ"


msgid "Self Object"
msgstr "ﺩﻮﺧ ءﯽﺷ"


msgid "Retrieve the object that contains the geometry nodes modifier currently being executed"
msgstr "ﺩﺭﺍﺩ ﺮﺑ ﺭﺩ ﺍﺭ ﺍﺮﺟﺍ ﻝﺎﺣ ﺭﺩ ﯽِﺳﺪﻨﻫ ﯼﺎﻫ‌ﻩﺮﮔ ﺮﮔ‌ﺡﻼ﻿ﺻﺍ ﻪﮐ ﺪﻨﮐ‌ﯽﻣ ﯽﺑﺎﯾﺯﺎﺑ ﺍﺭ ﯽﺌﯿﺷ"


msgid "Separate Components"
msgstr "ﺎﻫ‌ﻪﻔﻟﺆﻣ ﯼﺯﺎﺳﺍﺪﺟ"


msgid "Split a geometry into a separate output for each type of data in the geometry"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﻢﯿﺴﻘﺗ ﻪﻧﺎﮔﺍﺪﺟ ﯽﺟﻭﺮﺧ ﻪﺑ ﻥﺁ ﺭﺩ ﺩﻮﺟﻮﻣ ﻩٔﺩﺍﺩ ﻉﻮﻧ ﺮﻫ ﯼﺍﺮﺑ ﺍﺭ ﻪﺳﺪﻨﻫ"


msgid "Separate Geometry"
msgstr "ﻪﺳﺪﻨﻫ ﯼﺯﺎﺳﺍﺪﺟ"


msgid "Split a geometry into two geometry outputs based on a selection"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﻢﯿﺴﻘﺗ ﯽﺳﺪﻨﻫ ﯽﺟﻭﺮﺧ ﻭﺩ ﻪﺑ ﺏﺎﺨﺘﻧﺍ ﺱﺎﺳﺍ ﺮﺑ ﺍﺭ ﻪﺳﺪﻨﻫ"


msgid "Which domain to separate on"
msgstr "ﺩﻮﺷ‌ﯽﻣ ﻡﺎﺠﻧﺍ ﻥﺁ ﺱﺎﺳﺍ ﺮﺑ ﯼﺯﺎﺳﺍﺪﺟ ﻪﮐ ﯼﺍ‌ﻪﻨﻣﺍﺩ"


msgid "Set Handle Positions"
msgstr "ﺎﻫ‌ﻪﺘﺳﺩ ﺖﯿﻌﻗﻮﻣ ﻢﯿﻈﻨﺗ"


msgid "Set the positions for the handles of Bézier curves"
msgstr "ﺪﻨﮐ‌ﯽﻣ ﻢﯿﻈﻨﺗ ﺍﺭ ﻪﯾﺰﺑ ﯼﺎﻫ‌ﯽﻨﺤﻨﻣ ﯼﺎﻫ‌ﻪﺘﺳﺩ ﺖﯿﻌﻗﻮﻣ"


